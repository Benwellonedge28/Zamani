# ── Zamani Build System / Package Manager (zamani-pkg) ───────────────────────
# Status: WORKING. Builds with `--features buildsystem`. Real Zamani.toml
# TOML parsing + dependency-graph resolution. Registry fetch/publish and
# multi-target codegen invocation are still simulated (logged as such) since
# there's no real package registry or full multi-target backend yet.
FROM rust:slim-bookworm AS builder
ARG BUILD_DATE
ARG GIT_COMMIT
ARG VERSION=dev
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends pkg-config libssl-dev && apt-get clean

COPY Cargo.toml Cargo.lock ./
COPY benches ./benches
COPY src ./src
RUN cargo build --release --features buildsystem --bin zamani-pkg

FROM debian:bookworm-slim AS runtime
LABEL org.opencontainers.image.title="Zamani Build System (zamani-pkg)"
LABEL org.opencontainers.image.description="Zamani.toml manifest parsing, dependency resolution, build orchestration"
LABEL org.opencontainers.image.source="https://github.com/Benwellonedge28/Zamani"
LABEL org.opencontainers.image.version="${VERSION}"
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && apt-get clean
WORKDIR /project
COPY --from=builder /app/target/release/zamani-pkg /usr/local/bin/zamani-pkg
ENTRYPOINT ["/usr/local/bin/zamani-pkg"]
CMD ["build"]
