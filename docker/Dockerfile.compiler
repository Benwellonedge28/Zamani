# ── Zenith Compiler (ZUTC) ───────────────────────────────────────────────────
# Status: WORKING. Builds with default cargo features (lexer, parser,
# semantic, ir_gen, optimizer, backend + CLI). 196 tests pass.
FROM rust:slim-bookworm AS builder
ARG BUILD_DATE
ARG GIT_COMMIT
ARG VERSION=dev
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends pkg-config libssl-dev && apt-get clean

COPY Cargo.toml Cargo.lock ./
COPY benches ./benches
RUN mkdir -p src && printf 'fn main() {}\n' > src/main.rs && printf 'pub fn _p(){}\n' > src/lib.rs \
    && cargo build --release --bin zenith 2>&1; rm src/main.rs src/lib.rs

COPY src ./src
COPY tests ./tests
RUN touch src/main.rs src/lib.rs && cargo build --release --bin zenith

FROM debian:bookworm-slim AS runtime
LABEL org.opencontainers.image.title="Zenith Compiler"
LABEL org.opencontainers.image.description="Zenith Universal Meta-Compiler (ZUTC) CLI"
LABEL org.opencontainers.image.source="https://github.com/Benwellonedge28/Zenith"
LABEL org.opencontainers.image.version="${VERSION}"
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && apt-get clean
WORKDIR /zenith
COPY --from=builder /app/target/release/zenith /usr/local/bin/zenith
HEALTHCHECK --interval=30s --timeout=10s --retries=3 CMD ["/usr/local/bin/zenith", "--help"]
CMD ["/usr/local/bin/zenith", "--help"]
