/// Typed finite scalar values must preserve exact finite inputs.
#[test]
fn finite_scalar_types_are_lossless() {
    let values = [
        -1234.5_f64,
        -1.0_f64,
        -0.0_f64,
        0.0_f64,
        0.5_f64,
        1234.5_f64,
    ];

    for value in values {
        let expectation =
            ExpectationValue::new(value)
                .expect("finite value must be accepted");

        let objective =
            super::super::types::ObjectiveValue::new(value)
                .expect("finite value must be accepted");

        let energy =
            Energy::new(value)
                .expect("finite value must be accepted");

        assert_eq!(expectation.get(), value);
        assert_eq!(objective.get(), value);
        assert_eq!(energy.get(), value);
    }
}

/// Equal typed values must compare equal.
#[test]
fn typed_values_preserve_equality() {
    let probability_a =
        Probability::new(0.5)
            .expect("valid probability");

    let probability_b =
        Probability::new(0.5)
            .expect("valid probability");

    assert_eq!(probability_a, probability_b);

    let energy_a =
        Energy::new(-1.25)
            .expect("valid energy");

    let energy_b =
        Energy::new(-1.25)
            .expect("valid energy");

    assert_eq!(energy_a, energy_b);
}

/// Probability ordering must follow the underlying mathematical ordering.
#[test]
fn probability_ordering_is_mathematical() {
    let low =
        Probability::new(0.25)
            .expect("valid probability");

    let middle =
        Probability::new(0.5)
            .expect("valid probability");

    let high =
        Probability::new(0.75)
            .expect("valid probability");

    assert!(low < middle);
    assert!(middle < high);
    assert!(low < high);
}

/// Energy ordering must follow the underlying mathematical ordering.
#[test]
fn energy_ordering_is_mathematical() {
    let low =
        Energy::new(-2.0)
            .expect("valid energy");

    let middle =
        Energy::new(0.0)
            .expect("valid energy");

    let high =
        Energy::new(2.0)
            .expect("valid energy");

    assert!(low < middle);
    assert!(middle < high);
    assert!(low < high);
}

/// The typed scalar constructors must not silently normalize or clamp values.
///
/// In particular, invalid probabilities must fail rather than being converted
/// into 0 or 1.
#[test]
fn validation_does_not_silently_clamp_invalid_values() {
    assert!(Probability::new(-0.1).is_err());
    assert!(Probability::new(1.1).is_err());

    assert_eq!(
        Probability::new(0.0)
            .expect("0.0 is valid")
            .get(),
        0.0
    );

    assert_eq!(
        Probability::new(1.0)
            .expect("1.0 is valid")
            .get(),
        1.0
    );
}

/// Repeated construction of the same deterministic values must always produce
/// equal typed contracts.
#[test]
fn repeated_construction_is_deterministic() {
    for value in [1_u64, 2, 17, 1024, DEFAULT_MAX_QUBITS] {
        let first =
            QubitCount::new(value)
                .expect("valid qubit count");

        let second =
            QubitCount::new(value)
                .expect("valid qubit count");

        assert_eq!(first, second);
    }

    for value in [1_u64, 2, 100, DEFAULT_MAX_SHOTS] {
        let first =
            ShotCount::new(value)
                .expect("valid shot count");

        let second =
            ShotCount::new(value)
                .expect("valid shot count");

        assert_eq!(first, second);
    }
}

/// Display output for strongly typed scalar counts must be stable and must
/// contain only the numeric value.
#[test]
fn scalar_count_display_is_stable() {
    let qubits =
        QubitCount::new(7)
            .expect("valid qubit count");

    let shots =
        ShotCount::new(1024)
            .expect("valid shot count");

    assert_eq!(qubits.to_string(), "7");
    assert_eq!(shots.to_string(), "1024");
}

/// The complete currently supported algorithm set must have valid metadata
/// construction.
#[test]
fn every_algorithm_has_constructible_metadata() {
    let algorithms = [
        AlgorithmId::Variational,
        AlgorithmId::Vqe,
        AlgorithmId::Qaoa,
        AlgorithmId::Grover,
        AlgorithmId::AmplitudeAmplification,
        AlgorithmId::AmplitudeEstimation,
        AlgorithmId::PhaseEstimation,
    ];

    for algorithm in algorithms {
        let metadata =
            AlgorithmMetadata::new(
                algorithm,
                AlgorithmVersion::initial(),
            );

        assert_eq!(metadata.algorithm_id(), algorithm);
        assert_eq!(
            metadata.version(),
            AlgorithmVersion::initial()
        );
    }
}

/// The public contracts must remain independent of global mutable state.
///
/// This test intentionally constructs all foundational values repeatedly.
/// If their validity depends on initialization order or hidden global state,
/// this test will expose it.
#[test]
fn foundational_contracts_are_free_of_initialization_order_dependencies() {
    for _ in 0..16 {
        assert!(QubitCount::new(1).is_ok());
        assert!(ShotCount::new(1).is_ok());
        assert!(Probability::new(0.5).is_ok());
        assert!(ExpectationValue::new(0.0).is_ok());
        assert!(
            super::super::types::ObjectiveValue::new(0.0).is_ok()
        );
        assert!(Energy::new(0.0).is_ok());

        let metadata =
            AlgorithmMetadata::new(
                AlgorithmId::Vqe,
                AlgorithmVersion::initial(),
            );

        assert_eq!(
            metadata.algorithm_id(),
            AlgorithmId::Vqe
        );
    }
}