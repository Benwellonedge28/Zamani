/// Probability accepts both mathematical boundaries.
#[test]
fn probability_accepts_closed_interval_boundaries() {
    let zero =
        Probability::new(0.0)
            .expect("zero is a valid probability");

    let one =
        Probability::new(1.0)
            .expect("one is a valid probability");

    assert_eq!(zero.get(), 0.0);
    assert_eq!(one.get(), 1.0);
}

/// Probability accepts representative interior values.
#[test]
fn probability_accepts_interior_values() {
    let values = [
        0.000_001_f64,
        0.1_f64,
        0.25_f64,
        0.5_f64,
        0.75_f64,
        0.999_999_f64,
    ];

    for value in values {
        let probability =
            Probability::new(value)
                .expect("interior probability must be accepted");

        assert_eq!(probability.get(), value);
    }
}

/// Values outside [0, 1] must never be accepted as probabilities.
#[test]
fn probability_rejects_values_outside_closed_interval() {
    let values = [
        -f64::EPSILON,
        -1.0,
        1.0 + f64::EPSILON,
        2.0,
    ];

    for value in values {
        assert!(
            Probability::new(value).is_err(),
            "invalid probability was accepted: {value}"
        );
    }
}

/// NaN and infinities must never be accepted as probabilities.
