/// All currently supported algorithm identifiers must have stable,
/// non-empty machine-readable names.
#[test]
fn algorithm_ids_are_stable_and_non_empty() {
    let algorithms = [
        AlgorithmId::Variational,
        AlgorithmId::Vqe,
        AlgorithmId::Qaoa,
        AlgorithmId::Grover,
        AlgorithmId::AmplitudeAmplification,
        AlgorithmId::AmplitudeEstimation,
        AlgorithmId::PhaseEstimation,
    ];

    for algorithm in algorithms {
        let name = algorithm.as_str();

        assert!(
            !name.is_empty(),
            "algorithm identifier must not be empty"
        );

        assert!(
            name.is_ascii(),
            "machine-readable algorithm identifiers must be ASCII: {name}"
        );

        assert!(
            !name.chars().any(char::is_whitespace),
            "algorithm identifiers must not contain whitespace: {name}"
        );
    }
}

/// Algorithm identifiers must be unique.
#[test]
fn algorithm_ids_are_unique() {
    let algorithms = [
        AlgorithmId::Variational,
        AlgorithmId::Vqe,
        AlgorithmId::Qaoa,
        AlgorithmId::Grover,
        AlgorithmId::AmplitudeAmplification,
        AlgorithmId::AmplitudeEstimation,
        AlgorithmId::PhaseEstimation,
    ];

    for left_index in 0..algorithms.len() {
        for right_index in (left_index + 1)..algorithms.len() {
            assert_ne!(
                algorithms[left_index].as_str(),
                algorithms[right_index].as_str(),
                "algorithm identifiers must be unique"
            );
        }
    }
}

