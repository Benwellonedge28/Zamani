/// The initial algorithm version must be exactly 1.0.0.
#[test]
fn initial_algorithm_version_is_stable() {
    let version = AlgorithmVersion::initial();

    assert_eq!(version.major, 1);
    assert_eq!(version.minor, 0);
    assert_eq!(version.patch, 0);

    assert_eq!(version.to_string(), "1.0.0");
}

/// Version ordering must obey semantic-version component ordering.
#[test]
fn algorithm_version_ordering_is_component_wise() {
    let base = AlgorithmVersion::new(1, 0, 0);
    let minor = AlgorithmVersion::new(1, 1, 0);
    let patch = AlgorithmVersion::new(1, 1, 1);
    let major = AlgorithmVersion::new(2, 0, 0);

    assert!(base < minor);
    assert!(minor < patch);
    assert!(patch < major);

    assert_eq!(base, AlgorithmVersion::new(1, 0, 0));
}

/// Algorithm metadata must preserve algorithm identity and version.
#[test]
fn algorithm_metadata_preserves_identity() {
    let metadata =
        AlgorithmMetadata::new(AlgorithmId::Vqe, AlgorithmVersion::initial());

    assert_eq!(metadata.algorithm_id(), AlgorithmId::Vqe);
    assert_eq!(metadata.version(), AlgorithmVersion::initial());
    assert!(metadata.implementation.is_none());
}

/// Valid implementation identifiers must be retained.
#[test]
fn algorithm_metadata_accepts_valid_implementation_identifier() {
    let metadata =
        AlgorithmMetadata::new(AlgorithmId::Vqe, AlgorithmVersion::initial())
            .with_implementation("zamani-vqe")
            .expect("valid implementation identifier must be accepted");

    assert_eq!(
        metadata.implementation.as_deref(),
        Some("zamani-vqe")
    );
}

/// Oversized implementation identifiers must be rejected at the public
/// validation boundary.
#[test]
fn algorithm_metadata_rejects_oversized_implementation_identifier() {
    let oversized = "x".repeat(1025);

    let result =
        AlgorithmMetadata::new(
            AlgorithmId::Vqe,
            AlgorithmVersion::initial(),
        )
        .with_implementation(oversized);

    assert!(
        result.is_err(),
        "implementation identifiers exceeding the contract limit must be rejected"
    );
}

/// Seed construction must be lossless.
#[test]
fn seeds_are_lossless() {
    let values = [
        0_u64,
        1_u64,
        42_u64,
        u64::MAX,
    ];

    for value in values {
        let seed = Seed::new(value);

        assert_eq!(
            seed.get(),
            value,
            "Seed must preserve its input exactly"
        );

        assert_eq!(
            Seed::from(value),
            seed,
            "From<u64> and Seed::new must have identical semantics"
        );
    }
}

/// Parameter indices must preserve their exact index.
#[test]
fn parameter_indices_are_lossless() {
    let values = [
        0_usize,
        1_usize,
        7_usize,
        1024_usize,
        usize::MAX,
    ];

    for value in values {
        let index = ParameterIndex::new(value);

        assert_eq!(
