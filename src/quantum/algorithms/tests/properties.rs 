}

/// Zero qubits are invalid because an algorithm-visible quantum register must
/// contain at least one qubit.
#[test]
fn zero_qubits_are_rejected() {
    assert!(
        QubitCount::new(0).is_err(),
        "zero qubits must be rejected"
    );
}

/// Valid qubit-count boundaries must be accepted.
#[test]
fn valid_qubit_count_boundaries_are_accepted() {
    let values = [
        1_u64,
        2_u64,
        3_u64,
        DEFAULT_MAX_QUBITS,
    ];

    for value in values {
        let count =
            QubitCount::new(value)
                .expect("valid qubit count must be accepted");

        assert_eq!(count.get(), value);
        assert_eq!(count.to_string(), value.to_string());
    }
}

