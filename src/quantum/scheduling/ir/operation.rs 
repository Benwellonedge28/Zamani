// ============================================================================
// Operation class
// ============================================================================

/// Broad scheduling classification of an executable operation.
///
/// This classification is intentionally scheduler-oriented rather than a
/// replacement for the canonical Quantum IR instruction taxonomy.
///
/// A canonical IR adapter decides which scheduling class applies.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, PartialOrd, Ord)]
pub enum OperationClass {
    /// Ordinary quantum unitary operation.
    Quantum,

    /// Measurement or acquisition operation.
    Measurement,

    /// Quantum-state reset/reinitialization.
    Reset,

    /// Classical computation required by a dynamic circuit.
    Classical,

    /// Operation whose execution depends on a classical predicate.
    Conditional,

    /// Quantum/classical feedback operation.
    Feedback,

    /// Communication between quantum resources or modules.
    Communication,

    /// Synchronization/barrier-like operation.
    Synchronization,

    /// Pulse/frame/control semantic operation.
    Pulse,

    /// Analog/Hamiltonian/evolution operation.
    Analog,

    /// Fault-tolerance/QEC operation.
    ErrorCorrection,

    /// User-defined or future operation class.
    Custom,
}

impl OperationClass {
    /// Returns whether this operation may produce classical information.
    #[must_use]
    pub const fn produces_classical_data(self) -> bool {
        matches!(
            self,
            Self::Measurement | Self::Classical | Self::Feedback
        )
    }

    /// Returns whether this operation represents quantum execution.
    #[must_use]
    pub const fn is_quantum(self) -> bool {
        matches!(
            self,
            Self::Quantum
                | Self::Measurement
                | Self::Reset
                | Self::Conditional
                | Self::Feedback
                | Self::ErrorCorrection
                | Self::Pulse
                | Self::Analog
        )
    }

    /// Returns whether this operation can introduce a runtime dependency.
    #[must_use]
    pub const fn is_dynamic(self) -> bool {
        matches!(
            self,
            Self::Classical
                | Self::Conditional
                | Self::Feedback
                | Self::Communication
        )
    }

    /// Returns whether the operation is a synchronization point.
    #[must_use]
    pub const fn is_synchronization(self) -> bool {
        matches!(self, Self::Synchronization)
    }
}

impl fmt::Display for OperationClass {
    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
        let name = match self {
            Self::Quantum => "quantum",
            Self::Measurement => "measurement",
            Self::Reset => "reset",
            Self::Classical => "classical",
            Self::Conditional => "conditional",
            Self::Feedback => "feedback",
            Self::Communication => "communication",
            Self::Synchronization => "synchronization",
            Self::Pulse => "pulse",
            Self::Analog => "analog",
            Self::ErrorCorrection => "error_correction",
            Self::Custom => "custom",
        };

        formatter.write_str(name)
    }
}

// ============================================================================
// Operand role
// ============================================================================

/// Semantic role of a logical qubit operand from the scheduler's perspective.
///
/// This does not replace QEC or hardware resource classification. It merely
/// records information useful to scheduling.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, PartialOrd, Ord)]
pub enum OperandRole {
    /// Ordinary computational/data operand.
    Data,

    /// Ancilla operand.
    Ancilla,

    /// Syndrome-extraction operand.
    Syndrome,

    /// Control operand.
    Control,

    /// Target operand.
    Target,

    /// Measurement operand.
    Measurement,

    /// Reset operand.
    Reset,

    /// Generic/future role.
    Other,
}

impl Default for OperandRole {
    fn default() -> Self {
        Self::Data
    }
}

// ============================================================================
// Qubit operand
// ============================================================================

/// A logical qubit operand used by the scheduling representation.
///
/// The actual qubit identity is the canonical Zamani IR `QubitId`.
///
/// This type exists only to attach scheduler-local metadata to that canonical
/// identity.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, PartialOrd, Ord)]
pub struct QubitOperand {
    /// Canonical logical qubit identity.
    qubit: QubitId,

    /// Scheduler-level semantic role.
    role: OperandRole,
}

impl QubitOperand {
    /// Creates a data-qubit operand.
    #[must_use]
    pub const fn new(qubit: QubitId) -> Self {
        Self {
            qubit,
            role: OperandRole::Data,
        }
    }

    /// Creates an operand with an explicit scheduler role.
    #[must_use]
    pub const fn with_role(qubit: QubitId, role: OperandRole) -> Self {
        Self { qubit, role }
    }

    /// Returns the canonical logical qubit identity.
    #[must_use]
    pub const fn qubit(self) -> QubitId {
        self.qubit
    }

    /// Returns the scheduling-level operand role.
    #[must_use]
    pub const fn role(self) -> OperandRole {
        self.role
    }
}

// ============================================================================
// Classical dependency identity
// ============================================================================

/// Stable identifier for a classical dependency consumed or produced by an
/// operation.
///
/// The scheduler does not interpret classical values. It only tracks
/// readiness/dependency relationships.
///
/// The string is intentionally opaque to the scheduler.
#[derive(Debug, Clone, PartialEq, Eq, Hash, PartialOrd, Ord)]
pub struct ClassicalDependencyId(Arc<str>);

impl ClassicalDependencyId {
    /// Creates a classical dependency identifier.
    ///
    /// Empty identifiers are rejected by [`try_new`].
    #[must_use]
    pub fn new(value: impl Into<Arc<str>>) -> Self {
        Self(value.into())
    }

    /// Creates a classical dependency identifier with validation.
    ///
    /// Returns `None` for an empty identifier.
    #[must_use]
    pub fn try_new(value: impl Into<Arc<str>>) -> Option<Self> {
        let value = value.into();

        if value.is_empty() {
            None
        } else {
            Some(Self(value))
        }
    }

    /// Returns the opaque identifier.
    #[must_use]
    pub fn as_str(&self) -> &str {
        &self.0
    }
}

impl fmt::Display for ClassicalDependencyId {
    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
        formatter.write_str(&self.0)
    }
}

// ============================================================================
// Operation provenance
// ============================================================================

/// Identifies where a scheduling operation originated.
///
/// Scheduling must preserve provenance so that a final schedule can be
/// explained and verified against the canonical semantic program.
#[derive(Debug, Clone, PartialEq, Eq, Hash)]
pub enum OperationProvenance {
    /// Operation originates directly from the canonical IR.
    CanonicalIr {
        /// Canonical scheduler-visible operation identity.
        operation_id: OperationId,
    },

    /// Operation was introduced by a compiler transformation.
    ///
    /// `origin` points to the operation that caused the transformation.
    Derived {
        /// Original operation.
        origin: OperationId,

        /// Human-readable transformation identifier.
        transformation: Arc<str>,
    },

    /// Operation was introduced by routing.
    Routed {
        /// Original logical operation.
        origin: OperationId,

        /// Stable routing transformation identifier.
        routing_id: Arc<str>,
    },

    /// Operation was introduced by QEC lowering.
    ErrorCorrection {
        /// Operation that caused the generated QEC work.
        origin: Option<OperationId>,

        /// Stable QEC transformation identifier.
        protocol: Arc<str>,
    },

    /// Operation was introduced by a target-specific scheduling transformation.
    SchedulingTransformation {
        /// Source operation, when one exists.
        origin: Option<OperationId>,

        /// Stable transformation identifier.
        transformation: Arc<str>,
    },

    /// External/future producer.
    External {
        /// Stable external source identifier.
        source: Arc<str>,
    },
}

impl OperationProvenance {
    /// Returns the primary source operation, if one is known.
    #[must_use]
    pub fn origin(&self) -> Option<OperationId> {
        match self {
            Self::CanonicalIr { operation_id } => Some(*operation_id),

            Self::Derived { origin, .. }
            | Self::Routed { origin, .. } => Some(*origin),

            Self::ErrorCorrection { origin, .. }
            | Self::SchedulingTransformation { origin, .. } => *origin,

            Self::External { .. } => None,
        }
    }

    /// Returns a stable human-readable provenance category.
    #[must_use]
    pub const fn kind(&self) -> &'static str {
        match self {
            Self::CanonicalIr { .. } => "canonical_ir",
            Self::Derived { .. } => "derived",
            Self::Routed { .. } => "routed",
            Self::ErrorCorrection { .. } => "error_correction",
            Self::SchedulingTransformation { .. } => "scheduling_transformation",
            Self::External { .. } => "external",
        }
    }
}

