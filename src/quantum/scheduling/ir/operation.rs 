#[cfg(test)]
mod tests {
    use super::*;

    fn operation_id() -> OperationId {
        // The canonical OperationId is owned by the canonical IR identity
        // subsystem. This test deliberately uses the constructor only if it is
        // available through the stable type contract.
        OperationId::new(0)
    }

    fn qubit(index: usize) -> QubitId {
        QubitId::new(index)
    }

    #[test]
    fn canonical_operation_uses_canonical_qubit_identity() {
        let operation = SchedulingOperation::from_canonical_ir(
            operation_id(),
            OperationClass::Quantum,
            vec![
                QubitOperand::new(qubit(0)),
                QubitOperand::new(qubit(1)),
            ]
            .into(),
        );

        assert_eq!(operation.arity(), 2);
        assert!(operation.is_two_qubit());
        assert_eq!(
            operation.qubits().collect::<Vec<_>>(),
            vec![qubit(0), qubit(1)]
        );
    }

    #[test]
    fn operation_is_immutable_after_build() {
        let operation = SchedulingOperation::from_canonical_ir(
            operation_id(),
            OperationClass::Measurement,
            vec![QubitOperand::with_role(
                qubit(0),
                OperandRole::Measurement,
            )]
            .into(),
        )
        .builder()
        .opcode("measure")
        .priority(10)
        .parallelizable(false)
        .dynamic(true)
        .build();

        assert_eq!(operation.opcode(), Some("measure"));
        assert_eq!(operation.priority(), 10);
        assert!(!operation.is_parallelizable());
        assert!(operation.is_dynamic());
    }

    #[test]
    fn provenance_origin_is_preserved() {
        let id = operation_id();

        let operation = SchedulingOperation::from_canonical_ir(
            id,
            OperationClass::Quantum,
            vec![QubitOperand::new(qubit(0))].into(),
        );

        assert_eq!(operation.source_id(), Some(id));
        assert_eq!(operation.provenance().origin(), Some(id));
        assert_eq!(operation.provenance().kind(), "canonical_ir");
    }

    #[test]
    fn duplicate_qubits_are_detectable_without_forcing_semantic_policy() {
        let operation = SchedulingOperation::from_canonical_ir(
            operation_id(),
            OperationClass::Custom,
            vec![
                QubitOperand::new(qubit(0)),
                QubitOperand::new(qubit(0)),
            ]
            .into(),
        );

        assert!(!operation.has_unique_qubits());
        assert_eq!(
            operation.validate_unique_qubits(),
            Err(OperationValidationError::DuplicateQubitOperand)
        );
    }

    #[test]
    fn classical_dependencies_are_opaque() {
        let dependency =
            ClassicalDependencyId::try_new("measurement_0").expect("valid dependency");

        let operation = SchedulingOperation::from_canonical_ir(
            operation_id(),
            OperationClass::Conditional,
            vec![QubitOperand::new(qubit(0))].into(),
        )
        .builder()
        .classical_inputs(vec![dependency.clone()])
        .dynamic(true)
        .build();

        assert_eq!(operation.classical_inputs(), &[dependency]);
        assert!(operation.is_dynamic());
    }

    #[test]
    fn operation_collection_is_shareable_and_unbounded_by_design() {
        let first = SchedulingOperation::from_canonical_ir(
            operation_id(),
            OperationClass::Quantum,
            vec![QubitOperand::new(qubit(0))].into(),
        );

        let collection = SchedulingOperations::from_iter([first]);

        assert_eq!(collection.len(), 1);
        assert!(!collection.is_empty());
        assert_eq!(collection.as_slice().len(), 1);
    }
}