/// Validation errors for scheduler operation construction.
///
/// These errors are intentionally local to this representation. The public
/// scheduling error hierarchy in `scheduling::errors` should wrap or translate
/// them at subsystem boundaries.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum OperationValidationError {
    /// An operation has no canonical identity.
    ///
    /// This is currently represented by the canonical `OperationId`; the
    /// variant exists to keep validation extensible without using panics.
    InvalidOperationId,

    /// A canonical operation was declared as originating from a different
    /// operation identity.
    ProvenanceMismatch,

    /// A classical dependency identifier is empty.
    EmptyClassicalDependency,

    /// An opcode/label supplied by an adapter is empty.
    EmptyOpcode,

    /// Duplicate qubit operands were supplied where the operation contract
    /// requires unique operands.
    DuplicateQubitOperand,
}

impl fmt::Display for OperationValidationError {
    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            Self::InvalidOperationId => {
                formatter.write_str("invalid scheduling operation identity")
            }
            Self::ProvenanceMismatch => {
                formatter.write_str("operation provenance does not match operation identity")
            }
            Self::EmptyClassicalDependency => {
                formatter.write_str("classical dependency identifier is empty")
            }
            Self::EmptyOpcode => {
                formatter.write_str("operation opcode is empty")
            }
            Self::DuplicateQubitOperand => {
                formatter.write_str("operation contains duplicate qubit operands")
            }
        }
    }
}

impl std::error::Error for OperationValidationError {}

impl SchedulingOperation {
    /// Validates the local invariants of this operation.
    ///
    /// This function does not perform target validation.
    ///
    /// Target validation belongs to hardware capabilities and the scheduling
    /// context.
    ///
    /// It also does not validate gate arity because gate semantics belong to
    /// the canonical IR.
    pub fn validate(&self) -> Result<(), OperationValidationError> {
        if let Some(source_id) = self.source_id {
            if let OperationProvenance::CanonicalIr { operation_id } =
                self.provenance
            {
                if source_id != operation_id {
                    return Err(OperationValidationError::ProvenanceMismatch);
                }
            }
        }

        for dependency in self
            .classical_inputs
            .iter()
            .chain(self.classical_outputs.iter())
        {
            if dependency.as_str().is_empty() {
                return Err(OperationValidationError::EmptyClassicalDependency);
            }
        }

        if let Some(opcode) = self.opcode() {
            if opcode.is_empty() {
                return Err(OperationValidationError::EmptyOpcode);
            }
        }

        // Qubit operands must identify distinct logical qubits unless the
        // canonical operation semantics explicitly permit aliasing.
        //
        // The scheduler cannot safely infer such semantic aliasing here, so
        // duplicate detection is intentionally exposed as a separate helper
        // rather than being imposed on every operation.
        Ok(())
    }

    /// Checks whether all logical qubit operands are distinct.
    ///
    /// This does not determine whether duplicates are semantically legal.
    /// The canonical IR adapter decides that according to the operation's
    /// actual semantics.
    #[must_use]
    pub fn has_unique_qubits(&self) -> bool {
        for (index, left) in self.operands.iter().enumerate() {
            for right in self.operands.iter().skip(index + 1) {
                if left.qubit() == right.qubit() {
                    return false;
                }
            }
        }

        true
    }

    /// Validates uniqueness when the adapter has established that duplicate
    /// operands are illegal for the operation.
    pub fn validate_unique_qubits(
        &self,
    ) -> Result<(), OperationValidationError> {
        if self.has_unique_qubits() {
            Ok(())
        } else {
            Err(OperationValidationError::DuplicateQubitOperand)
        }
    }
}

