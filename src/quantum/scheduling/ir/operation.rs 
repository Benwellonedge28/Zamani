/// Lightweight scheduler metadata.
///
/// Metadata is intentionally opaque and does not contain semantic gate data.
#[derive(Debug, Clone, PartialEq, Eq, Default)]
pub struct OperationMetadata {
    /// Optional stable operation name.
    name: Option<Arc<str>>,

    /// Optional source/provenance label.
    label: Option<Arc<str>>,

    /// Optional user-defined scheduling class.
    scheduling_class: Option<Arc<str>>,
}

impl OperationMetadata {
    /// Creates empty metadata.
    #[must_use]
    pub const fn new() -> Self {
        Self {
            name: None,
            label: None,
            scheduling_class: None,
        }
    }

    /// Sets a stable operation name.
    #[must_use]
    pub fn with_name(mut self, name: impl Into<Arc<str>>) -> Self {
        self.name = Some(name.into());
        self
    }

    /// Sets a source/debug label.
    #[must_use]
    pub fn with_label(mut self, label: impl Into<Arc<str>>) -> Self {
        self.label = Some(label.into());
        self
    }

    /// Sets a user-defined scheduling class.
    #[must_use]
    pub fn with_scheduling_class(
        mut self,
        scheduling_class: impl Into<Arc<str>>,
    ) -> Self {
        self.scheduling_class = Some(scheduling_class.into());
        self
    }

    /// Returns the operation name.
    #[must_use]
    pub fn name(&self) -> Option<&str> {
        self.name.as_deref()
    }

    /// Returns the source/debug label.
    #[must_use]
    pub fn label(&self) -> Option<&str> {
        self.label.as_deref()
    }

    /// Returns the scheduling class.
    #[must_use]
    pub fn scheduling_class(&self) -> Option<&str> {
        self.scheduling_class.as_deref()
    }
}

// ============================================================================
// Scheduling operation
// ============================================================================

/// Immutable scheduling representation of one executable operation.
///
/// # Important
///
/// This is NOT another quantum semantic operation type.
///
/// The canonical operation remains in `quantum::ir`. This structure is the
/// scheduler's normalized execution view.
///
/// # Why this abstraction exists
///
/// A scheduler needs information that the semantic IR intentionally does not
/// own, including:
///
/// - scheduling identity;
/// - resource requirements;
/// - temporal requirements;
/// - dependency references;
/// - provenance;
/// - scheduler priority;
/// - operation classification.
///
/// Keeping these concerns here prevents the canonical IR from becoming
/// hardware- or scheduler-specific.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct SchedulingOperation {
    /// Stable scheduling identity.
    id: OperationId,

    /// Optional canonical source identity.
///
/// For direct canonical operations this normally equals `id`.
/// Derived scheduling operations may have a different scheduling identity.
    source_id: Option<OperationId>,

    /// Broad scheduler classification.
    class: OperationClass,

    /// Logical operands.
    ///
    /// These use canonical `quantum::ir::qubit::QubitId`.
    operands: Arc<[QubitOperand]>,

    /// Classical dependencies that must be available before execution.
    classical_inputs: Arc<[ClassicalDependencyId]>,

    /// Classical dependencies produced by this operation.
    classical_outputs: Arc<[ClassicalDependencyId]>,

    /// Optional human-readable semantic opcode/name.
    ///
    /// This is a label only. It is not the source of quantum semantics.
    opcode: Option<Arc<str>>,

    /// Operation provenance.
    provenance: OperationProvenance,

    /// Scheduler priority.
    ///
    /// Larger values represent higher priority.
    priority: i64,

    /// Whether the operation is eligible for parallel execution with another
    /// operation when no explicit/resource dependency prevents it.
    parallelizable: bool,

    /// Whether the operation is safe to move across otherwise independent
    /// operations.
    ///
    /// This is a scheduling property supplied by the IR adapter, not inferred
    /// from the opcode string.
    reorderable: bool,

    /// Whether the operation requires runtime/dynamic readiness.
    dynamic: bool,

    /// Optional metadata.
    metadata: OperationMetadata,
}

impl SchedulingOperation {
    /// Creates a new scheduling operation.
    ///
    /// The constructor intentionally does not infer quantum semantics.
    /// Callers must provide the normalized information explicitly.
    ///
    /// Resource and timing requirements are intentionally handled by their
    /// dedicated scheduling modules rather than duplicated here.
    #[must_use]
    pub fn new(
        id: OperationId,
        class: OperationClass,
        operands: Arc<[QubitOperand]>,
        provenance: OperationProvenance,
    ) -> Self {
        let source_id = provenance.origin();

        Self {
            id,
            source_id,
            class,
            operands,
            classical_inputs: Arc::from([]),
            classical_outputs: Arc::from([]),
            opcode: None,
            provenance,
            priority: 0,
            parallelizable: true,
            reorderable: false,
            dynamic: class.is_dynamic(),
            metadata: OperationMetadata::new(),
        }
    }

    /// Creates a canonical-IR scheduling operation.
    ///
    /// This is the preferred constructor for operations directly originating
    /// from the canonical IR adapter.
    #[must_use]
    pub fn from_canonical_ir(
        id: OperationId,
        class: OperationClass,
        operands: Arc<[QubitOperand]>,
    ) -> Self {
        Self::new(
            id,
            class,
            operands,
            OperationProvenance::CanonicalIr {
                operation_id: id,
            },
        )
    }

    /// Returns the scheduler operation identity.
    #[must_use]
    pub const fn id(&self) -> OperationId {
        self.id
    }

    /// Returns the canonical source operation identity, if available.
    #[must_use]
    pub const fn source_id(&self) -> Option<OperationId> {
        self.source_id
    }

    /// Returns the scheduling classification.
    #[must_use]
    pub const fn class(&self) -> OperationClass {
        self.class
    }

    /// Returns all logical operands in semantic operand order.
    #[must_use]
    pub fn operands(&self) -> &[QubitOperand] {
        &self.operands
    }

    /// Returns the canonical logical qubit identities.
    ///
    /// This method intentionally exposes the canonical `QubitId` values rather
    /// than introducing a scheduling-specific qubit type.
    #[must_use]
    pub fn qubits(&self) -> impl Iterator<Item = QubitId> + '_ {
        self.operands.iter().map(|operand| operand.qubit())
    }

    /// Returns the number of operands.
    #[must_use]
    pub fn arity(&self) -> usize {
        self.operands.len()
    }

    /// Returns whether this operation has no qubit operands.
    #[must_use]
    pub fn is_qubit_free(&self) -> bool {
        self.operands.is_empty()
    }

    /// Returns whether this is a single-qubit operation.
    #[must_use]
    pub fn is_single_qubit(&self) -> bool {
        self.operands.len() == 1
    }

    /// Returns whether this is a two-qubit operation.
    #[must_use]
    pub fn is_two_qubit(&self) -> bool {
        self.operands.len() == 2
    }

    /// Returns whether this is a multi-qubit operation.
    #[must_use]
    pub fn is_multi_qubit(&self) -> bool {
        self.operands.len() > 2
    }

    /// Returns classical input dependencies.
    #[must_use]
    pub fn classical_inputs(&self) -> &[ClassicalDependencyId] {
        &self.classical_inputs
    }

    /// Returns classical output dependencies.
    #[must_use]
    pub fn classical_outputs(&self) -> &[ClassicalDependencyId] {
        &self.classical_outputs
    }

    /// Returns the optional scheduler label/opcode.
    ///
    /// The value is informational only and MUST NOT be used as a replacement
    /// for canonical IR semantics.
    #[must_use]
    pub fn opcode(&self) -> Option<&str> {
        self.opcode.as_deref()
    }

    /// Returns provenance information.
    #[must_use]
    pub fn provenance(&self) -> &OperationProvenance {
        &self.provenance
    }

    /// Returns the scheduler priority.
    #[must_use]
    pub const fn priority(&self) -> i64 {
        self.priority
    }

    /// Returns whether the operation is parallelizable.
    #[must_use]
    pub const fn is_parallelizable(&self) -> bool {
        self.parallelizable
    }

    /// Returns whether the operation may be reordered.
    #[must_use]
    pub const fn is_reorderable(&self) -> bool {
        self.reorderable
    }

    /// Returns whether runtime readiness is required.
    #[must_use]
    pub const fn is_dynamic(&self) -> bool {
        self.dynamic
    }

    /// Returns metadata.
    #[must_use]
    pub const fn metadata(&self) -> &OperationMetadata {
        &self.metadata
    }

    /// Returns a builder initialized with this operation.
    ///
    /// The builder is useful for constructing derived immutable operations
    /// without making `SchedulingOperation` itself mutable.
    #[must_use]
    pub fn builder(self) -> SchedulingOperationBuilder {
        SchedulingOperationBuilder { operation: self }
    }
}

// ============================================================================
// Scheduling operation builder
// ============================================================================

/// Builder for [`SchedulingOperation`].
///
/// The builder exists only at construction time. Once `build()` is called, the
/// resulting operation is immutable.
#[derive(Debug, Clone)]
pub struct SchedulingOperationBuilder {
    operation: SchedulingOperation,
}

impl SchedulingOperationBuilder {
    /// Replaces classical input dependencies.
    #[must_use]
    pub fn classical_inputs<I>(
        mut self,
        dependencies: I,
    ) -> Self
    where
        I: IntoIterator<Item = ClassicalDependencyId>,
    {
        self.operation.classical_inputs =
            dependencies.into_iter().collect::<Vec<_>>().into();

        self
    }

    /// Replaces classical output dependencies.
    #[must_use]
    pub fn classical_outputs<I>(
        mut self,
        dependencies: I,
    ) -> Self
    where
        I: IntoIterator<Item = ClassicalDependencyId>,
    {
        self.operation.classical_outputs =
            dependencies.into_iter().collect::<Vec<_>>().into();

        self
    }

    /// Sets an informational opcode/name.
    ///
    /// This MUST NOT be interpreted as the semantic definition of the
    /// operation.
    #[must_use]
    pub fn opcode(mut self, opcode: impl Into<Arc<str>>) -> Self {
        self.operation.opcode = Some(opcode.into());
        self
    }

    /// Sets scheduler priority.
    #[must_use]
    pub const fn priority(mut self, priority: i64) -> Self {
        self.operation.priority = priority;
        self
    }

    /// Sets whether the operation may execute concurrently with independent
    /// operations.
    #[must_use]
    pub const fn parallelizable(mut self, parallelizable: bool) -> Self {
        self.operation.parallelizable = parallelizable;
        self
    }

    /// Sets whether the operation may be reordered across independent work.
    #[must_use]
    pub const fn reorderable(mut self, reorderable: bool) -> Self {
        self.operation.reorderable = reorderable;
        self
    }

    /// Explicitly sets dynamic behavior.
    #[must_use]
    pub const fn dynamic(mut self, dynamic: bool) -> Self {
        self.operation.dynamic = dynamic;
        self
    }

    /// Sets scheduler metadata.
    #[must_use]
    pub fn metadata(mut self, metadata: OperationMetadata) -> Self {
        self.operation.metadata = metadata;
        self
    }

    /// Finalizes the immutable operation.
    #[must_use]
    pub fn build(self) -> SchedulingOperation {
        self.operation
    }
}

// ============================================================================
// Operation collection
// ============================================================================

/// Immutable collection of scheduling operations.
///
/// This wrapper exists to provide a stable abstraction for future graph/storage
/// optimizations without changing the public representation of individual
/// operations.
///
/// The collection is intentionally backed by `Arc<[T]>` rather than a fixed
/// machine-size array.
#[derive(Debug, Clone, PartialEq, Eq, Default)]
pub struct SchedulingOperations {
    operations: Arc<[SchedulingOperation]>,
}

impl SchedulingOperations {
    /// Creates an empty operation collection.
    #[must_use]
    pub fn new() -> Self {
        Self {
            operations: Arc::from([]),
        }
    }

    /// Creates an operation collection from an iterator.
    #[must_use]
    pub fn from_iter<I>(operations: I) -> Self
    where
        I: IntoIterator<Item = SchedulingOperation>,
    {
        Self {
            operations: operations.into_iter().collect::<Vec<_>>().into(),
        }
    }

    /// Returns the number of operations.
    #[must_use]
    pub fn len(&self) -> usize {
        self.operations.len()
    }

    /// Returns whether the collection is empty.
    #[must_use]
    pub fn is_empty(&self) -> bool {
        self.operations.is_empty()
    }

    /// Returns an operation by stable collection index.
    ///
    /// Collection indices are storage positions, not semantic operation IDs.
    #[must_use]
    pub fn get(&self, index: usize) -> Option<&SchedulingOperation> {
        self.operations.get(index)
    }

    /// Returns the operations as a slice.
    #[must_use]
    pub fn as_slice(&self) -> &[SchedulingOperation] {
        &self.operations
    }

    /// Returns an iterator over operations.
    pub fn iter(&self) -> impl Iterator<Item = &SchedulingOperation> {
        self.operations.iter()
    }
}

impl From<Vec<SchedulingOperation>> for SchedulingOperations {
    fn from(operations: Vec<SchedulingOperation>) -> Self {
        Self {
            operations: operations.into(),
        }
    }
}

impl<'a> IntoIterator for &'a SchedulingOperations {
    type Item = &'a SchedulingOperation;
    type IntoIter = std::slice::Iter<'a, SchedulingOperation>;

    fn into_iter(self) -> Self::IntoIter {
        self.operations.iter()
    }
}

