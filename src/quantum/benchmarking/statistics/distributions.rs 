//! Zamani Quantum Benchmarking — Statistical Distributions
//!
//! Production statistical distribution primitives used by the quantum
//! benchmarking subsystem.
//!
//! # Purpose
//!
//! This module provides backend-independent probability distributions and
//! empirical-distribution utilities required by:
//!
//! - Quantum Volume;
//! - randomized benchmarking;
//! - interleaved randomized benchmarking;
//! - simultaneous randomized benchmarking;
//! - purity/leakage benchmarking;
//! - cycle benchmarking;
//! - XEB;
//! - random-circuit sampling;
//! - readout/SPAM characterization;
//! - coherence measurements;
//! - drift analysis;
//! - application benchmarks;
//! - QEC physical/logical error analysis;
//! - bootstrap and confidence-interval implementations;
//! - future Bayesian and likelihood-based benchmark protocols.
//!
//! The module deliberately contains **distribution mathematics only**.
//!
//! It does NOT:
//!
//! - execute circuits;
//! - generate quantum circuits;
//! - communicate with hardware;
//! - access Quantum IR;
//! - perform benchmark protocol orchestration;
//! - choose a confidence level;
//! - silently remove outliers;
//! - generate random samples;
//! - print diagnostics;
//! - log;
//! - mutate global state.
//!
//! Those responsibilities belong to sibling benchmarking modules.
//!
//! # Architectural position
//!
//! ```text
//! raw observations
//!       │
//!       ▼
//! statistics::distributions
//!       │
//!       ├── statistics::confidence
//!       ├── statistics::bootstrap
//!       ├── statistics::regression
//!       └── statistics::aggregation
//!               │
//!               ▼
//!          metrics / protocols
//! ```
//!
//! This module therefore remains independent of quantum backends and
//! benchmark protocols.
//!
//! # Supported distributions
//!
//! The production API currently provides:
//!
//! - Bernoulli;
//! - Binomial;
//! - Normal/Gaussian;
//! - Beta;
//! - Multinomial;
//! - empirical distributions.
//!
//! These are deliberately represented as validated immutable value types.
//!
//! # Numerical policy
//!
//! Quantum benchmarking frequently operates in extreme regimes:
//!
//! - very small error rates;
//! - probabilities close to zero or one;
//! - large shot counts;
//! - long RB sequence lengths;
//! - very small confidence tails;
//! - large multinomial categories.
//!
//! Consequently this module:
//!
//! - validates all public parameters;
//! - rejects NaN and infinity;
//! - rejects invalid probabilities;
//! - uses logarithmic forms where appropriate;
//! - avoids factorials where logarithmic factorials are safer;
//! - clamps only values that are the result of floating-point roundoff;
//! - never silently converts invalid scientific input into a valid value.
//!
//! # Randomness
//!
//! This module intentionally does not expose sampling methods.
//!
//! Reproducible random generation belongs to:
//!
//! `quantum::benchmarking::generators::random`
//!
//! Keeping RNG ownership outside this module prevents hidden global RNG state
//! from compromising benchmark reproducibility.
//!
//! # Rust compatibility
//!
//! Target:
//!
//! - Rust 1.97;
//! - Rust 1.97.1;
//! - Rust 2021;
//! - stable Rust only.
//!
//! No nightly features are required.
//!
//! # Error boundary
//!
//! All fallible operations use the canonical benchmarking error type:
//!
//! `crate::quantum::benchmarking::core::errors::BenchmarkError`
//!
//! The module does not introduce a competing statistical error hierarchy.
//!
//! # Integration contract
//!
//! Future statistical modules should consume this file rather than
//! reimplementing:
//!
//! - log-factorials;
//! - log-gamma;
//! - probability validation;
//! - normal CDF;
//! - normal inverse CDF;
//! - beta moments;
//! - binomial likelihoods;
//! - empirical moments.
//!
//! Protocols must retain the raw observations separately from values derived
//! from these distributions.
//!
//! For example:
//!
//! ```text
//! heavy-output counts
//!       │
//!       ▼
//! Binomial
//!       │
//!       ▼
//! probability / likelihood
//!       │
//!       ▼
//! confidence.rs
//!       │
//!       ▼
//! Quantum Volume result
//! ```
//!
//! The distribution layer must never claim that a statistical model is true
//! merely because it can mathematically evaluate it. The protocol layer is
//! responsible for declaring its modelling assumptions.

use std::fmt;

use crate::quantum::benchmarking::core::errors::{BenchmarkError, BenchmarkResult};

// =============================================================================
// Numerical constants
// =============================================================================

/// Machine-level tolerance used only for classification of values that should
/// mathematically lie inside [0, 1] but can be displaced by floating-point
/// roundoff.
const PROBABILITY_ROUNDOFF_EPSILON: f64 = 1.0e-12;

/// Minimum positive probability accepted by logarithmic probability helpers.
const MIN_POSITIVE_PROBABILITY: f64 = f64::MIN_POSITIVE;

/// Lanczos approximation parameter for log-gamma.
///
/// The implementation below is suitable for positive arguments and is used
/// only for statistical normalization. It avoids adding a heavyweight
/// numerical dependency merely for this foundational module.
const LANCZOS_G: f64 = 7.0;

/// Lanczos coefficients for log-gamma.
const LANCZOS_COEFFICIENTS: [f64; 9] = [
    0.999_999_999_999_809_9,
    676.520_368_121_885_1,
    -1_259.139_216_722_402_8,
    771.323_428_777_653_1,
    -176.615_029_162_140_6,
    12.507_343_278_686_905,
    -0.138_571_095_265_720_12,
    9.984_369_578_019_571e-6,
    1.505_632_735_149_311_6e-7,
];

/// Natural logarithm of sqrt(2π).
const LOG_SQRT_2_PI: f64 = 0.918_938_533_204_672_8;

/// Upper safe integer for exact factorial-style integer products in f64.
///
/// We do not multiply factorials directly, but this is retained as a semantic
/// guard when a caller asks for an exact discrete combinatorial value.
const MAX_EXACT_F64_INTEGER: u64 = 9_007_199_254_740_992;

// =============================================================================
// Common validation helpers
// =============================================================================

/// Validate that a scalar is finite.
#[inline]
fn validate_finite(field: &str, value: f64) -> BenchmarkResult<()> {
    if !value.is_finite() {
        return Err(BenchmarkError::NonFiniteValue {
            field: field.to_owned(),
            value: value.to_string(),
        });
    }

    Ok(())
}

/// Validate a strictly positive finite scalar.
#[inline]
fn validate_positive(field: &str, value: f64) -> BenchmarkResult<()> {
    validate_finite(field, value)?;

    if value <= 0.0 {
        return Err(BenchmarkError::InvalidRange {
            field: field.to_owned(),
            value: value.to_string(),
            minimum: Some("greater than 0".to_owned()),
            maximum: None,
        });
    }

    Ok(())
}

/// Validate a non-negative finite scalar.
#[inline]
fn validate_non_negative(field: &str, value: f64) -> BenchmarkResult<()> {
    validate_finite(field, value)?;

    if value < 0.0 {
        return Err(BenchmarkError::InvalidRange {
            field: field.to_owned(),
            value: value.to_string(),
            minimum: Some("0".to_owned()),
            maximum: None,
        });
    }

    Ok(())
}

/// Validate a probability in the closed interval [0, 1].
#[inline]
fn validate_probability(field: &str, value: f64) -> BenchmarkResult<()> {
    validate_finite(field, value)?;

    if !(0.0..=1.0).contains(&value) {
        return Err(BenchmarkError::InvalidProbability {
            field: field.to_owned(),
            value: value.to_string(),
        });
    }

    Ok(())
}

/// Validate a probability and return a value clamped only when the deviation
/// is demonstrably attributable to floating-point roundoff.
#[inline]
fn normalize_probability(field: &str, value: f64) -> BenchmarkResult<f64> {
    validate_finite(field, value)?;

    if (0.0..=1.0).contains(&value) {
        return Ok(value);
    }

    if value < 0.0 && value >= -PROBABILITY_ROUNDOFF_EPSILON {
        return Ok(0.0);
    }

    if value > 1.0 && value <= 1.0 + PROBABILITY_ROUNDOFF_EPSILON {
        return Ok(1.0);
    }

    Err(BenchmarkError::InvalidProbability {
        field: field.to_owned(),
        value: value.to_string(),
    })
}

/// Ensure an integer count is within a total count.
#[inline]
fn validate_count(field: &str, count: u64, total: Option<u64>) -> BenchmarkResult<()> {
    if let Some(total) = total {
        if count > total {
            return Err(BenchmarkError::InvalidCount {
                field: field.to_owned(),
                value: count,
                maximum: Some(total),
            });
        }
    }

    Ok(())
}

/// Convert a u64 to f64 while preserving the fact that benchmark counts are
/// non-negative.
#[inline]
fn count_to_f64(field: &str, value: u64) -> BenchmarkResult<f64> {
    let result = value as f64;

    if !result.is_finite() {
        return Err(BenchmarkError::NumericalOverflow {
            operation: format!("convert {} count to f64", field),
            value: Some(value.to_string()),
        });
    }

    Ok(result)
}

/// Numerically stable log(1 - p).
#[inline]
pub fn ln_one_minus_probability(p: f64) -> BenchmarkResult<f64> {
    let p = normalize_probability("p", p)?;

    if p == 1.0 {
        return Ok(f64::NEG_INFINITY);
    }

    Ok((-p).ln_1p())
}

/// Numerically stable log(p).
#[inline]
pub fn ln_probability(p: f64) -> BenchmarkResult<f64> {
    let p = normalize_probability("p", p)?;

    if p == 0.0 {
        return Ok(f64::NEG_INFINITY);
    }

    Ok(p.ln())
}

// =============================================================================
// Log-gamma / combinatorial primitives
// =============================================================================

/// Natural logarithm of Γ(z) for positive finite z.
///
/// Uses the Lanczos approximation with the reflection formula for
/// 0 < z < 0.5.
///
/// This is intentionally private at the raw mathematical level; the public
/// `log_gamma` wrapper performs production validation.
fn log_gamma_unchecked(z: f64) -> f64 {
    if z < 0.5 {
        // Reflection formula:
        //
        // Γ(z) Γ(1-z) = π / sin(πz)
        //
        // The caller guarantees z > 0.
        return std::f64::consts::PI.ln()
            - (std::f64::consts::PI * z).sin().ln()
            - log_gamma_unchecked(1.0 - z);
    }

    let z_minus_one = z - 1.0;

    let mut x = LANCZOS_COEFFICIENTS[0];

    for (i, coefficient) in LANCZOS_COEFFICIENTS.iter().enumerate().skip(1) {
        x += coefficient / (z_minus_one + i as f64);
    }

    let t = z_minus_one + LANCZOS_G + 0.5;

    LOG_SQRT_2_PI + (z_minus_one + 0.5) * t.ln() - t + x.ln()
}

/// Natural logarithm of the gamma function.
///
/// # Errors
///
/// Returns a benchmarking numerical/range error for non-finite or
/// non-positive input.
pub fn log_gamma(z: f64) -> BenchmarkResult<f64> {
    validate_positive("z", z)?;

    let result = log_gamma_unchecked(z);

    if !result.is_finite() {
        return Err(BenchmarkError::NumericalOverflow {
            operation: "log_gamma".to_owned(),
            value: Some(z.to_string()),
        });
    }

    Ok(result)
}

/// Natural logarithm of n!.
///
/// This uses log-gamma rather than explicitly constructing n!, preventing
/// overflow for realistic quantum benchmarking shot counts.
pub fn log_factorial(n: u64) -> BenchmarkResult<f64> {
    log_gamma((n as f64) + 1.0)
}

/// Natural logarithm of the binomial coefficient C(n, k).
pub fn log_binomial_coefficient(n: u64, k: u64) -> BenchmarkResult<f64> {
    if k > n {
        return Err(BenchmarkError::InvalidRange {
            field: "k".to_owned(),
            value: k.to_string(),
            minimum: Some("0".to_owned()),
            maximum: Some(n.to_string()),
        });
    }

    let k = k.min(n - k);

    if k == 0 || k == n {
        return Ok(0.0);
    }

    let result = log_factorial(n)?
        - log_factorial(k)?
        - log_factorial(n - k)?;

    if !result.is_finite() {
        return Err(BenchmarkError::NumericalOverflow {
            operation: "log_binomial_coefficient".to_owned(),
            value: Some(format!("n={}, k={}", n, k)),
        });
    }

    Ok(result)
}

/// Binomial coefficient represented as f64.
///
/// For extremely large coefficients, returning infinity is not scientifically
/// useful, so the function returns a numerical-overflow error instead.
pub fn binomial_coefficient(n: u64, k: u64) -> BenchmarkResult<f64> {
    let log_value = log_binomial_coefficient(n, k)?;

    let value = log_value.exp();

    if !value.is_finite() {
        return Err(BenchmarkError::NumericalOverflow {
            operation: "binomial_coefficient".to_owned(),
            value: Some(format!("n={}, k={}", n, k)),
        });
    }

    Ok(value)
}

// =============================================================================
// Bernoulli distribution
// =============================================================================

/// Bernoulli distribution.
///
/// Represents a single binary trial with success probability `p`.
///
/// This is the foundational distribution for:
///
/// - shot success/failure;
/// - heavy-output events;
/// - binary application success;
/// - leakage/no-leakage events;
/// - threshold tests.
#[derive(Debug, Clone, Copy, PartialEq)]
pub struct Bernoulli {
    probability: f64,
}

impl Bernoulli {
    /// Construct a Bernoulli distribution with success probability `p`.
    pub fn new(p: f64) -> BenchmarkResult<Self> {
        validate_probability("probability", p)?;

        Ok(Self { probability: p })
    }

    /// Success probability.
    #[inline]
    pub const fn probability(self) -> f64 {
        self.probability
    }

    /// Failure probability.
    #[inline]
    pub fn failure_probability(self) -> f64 {
        1.0 - self.probability
    }

    /// Probability mass at x ∈ {0, 1}.
    pub fn pmf(self, x: bool) -> f64 {
        if x {
            self.probability
        } else {
            self.failure_probability()
        }
    }

    /// Natural logarithm of the probability mass.
    pub fn log_pmf(self, x: bool) -> f64 {
        if x {
            if self.probability == 0.0 {
                f64::NEG_INFINITY
            } else {
                self.probability.ln()
            }
        } else if self.probability == 1.0 {
            f64::NEG_INFINITY
        } else {
            (-self.probability).ln_1p()
        }
    }

    /// Mean.
    #[inline]
    pub const fn mean(self) -> f64 {
        self.probability
    }

    /// Variance.
    #[inline]
    pub fn variance(self) -> f64 {
        self.probability * self.failure_probability()
    }

    /// Standard deviation.
    #[inline]
    pub fn standard_deviation(self) -> f64 {
        self.variance().sqrt()
    }

    /// Entropy in nats.
    pub fn entropy(self) -> f64 {
        let p = self.probability;
        let q = self.failure_probability();

        let p_term = if p == 0.0 { 0.0 } else { -p * p.ln() };
        let q_term = if q == 0.0 { 0.0 } else { -q * q.ln() };

        p_term + q_term
    }
}

// =============================================================================
// Binomial distribution
// =============================================================================

/// Binomial distribution.
///
/// Models the number of successes in `n` independent Bernoulli trials.
///
/// This is the primary discrete model for shot-based binary benchmark
/// quantities such as heavy-output probability and success probability.
#[derive(Debug, Clone, Copy, PartialEq)]
pub struct Binomial {
    trials: u64,
    probability: f64,
}

impl Binomial {
    /// Construct a binomial distribution.
    ///
    /// `trials` is the number of independent Bernoulli trials.
    pub fn new(trials: u64, probability: f64) -> BenchmarkResult<Self> {
        validate_probability("probability", probability)?;

        if trials == 0 {
            return Err(BenchmarkError::InvalidRange {
                field: "trials".to_owned(),
                value: trials.to_string(),
                minimum: Some("1".to_owned()),
                maximum: None,
            });
        }

        Ok(Self {
            trials,
            probability,
        })
    }

    /// Number of trials.
    #[inline]
    pub const fn trials(self) -> u64 {
        self.trials
    }

    /// Success probability.
    #[inline]
    pub const fn probability(self) -> f64 {
        self.probability
    }

    /// Failure probability.
    #[inline]
    pub fn failure_probability(self) -> f64 {
        1.0 - self.probability
    }

    /// Probability mass P(X = k).
    ///
    /// Uses logarithmic combinatorics to avoid direct factorial overflow.
    pub fn pmf(&self, k: u64) -> BenchmarkResult<f64> {
        validate_count("k", k, Some(self.trials))?;

        if self.probability == 0.0 {
            return Ok(if k == 0 { 1.0 } else { 0.0 });
        }

        if self.probability == 1.0 {
            return Ok(if k == self.trials { 1.0 } else { 0.0 });
        }

        let log_probability = self.log_pmf(k)?;

        let value = log_probability.exp();

        if !value.is_finite() {
            return Err(BenchmarkError::NumericalOverflow {
                operation: "binomial pmf".to_owned(),
                value: Some(format!("n={}, k={}", self.trials, k)),
            });
        }

        Ok(value)
    }

    /// Natural logarithm of P(X = k).
    pub fn log_pmf(&self, k: u64) -> BenchmarkResult<f64> {
        validate_count("k", k, Some(self.trials))?;

        if self.probability == 0.0 {
            return Ok(if k == 0 { 0.0 } else { f64::NEG_INFINITY });
        }

        if self.probability == 1.0 {
            return Ok(if k == self.trials {
                0.0
            } else {
                f64::NEG_INFINITY
            });
        }

        let k_f = count_to_f64("k", k)?;
        let n_f = count_to_f64("trials", self.trials)?;
        let failures = n_f - k_f;

        let result = log_binomial_coefficient(self.trials, k)?
            + k_f * self.probability.ln()
            + failures * (-self.probability).ln_1p();

        if result.is_nan() {
            return Err(BenchmarkError::NumericalOverflow {
                operation: "binomial log pmf".to_owned(),
                value: Some(format!("n={}, k={}", self.trials, k)),
            });
        }

        Ok(result)
    }

    /// Mean number of successes.
    pub fn mean(&self) -> BenchmarkResult<f64> {
        let n = count_to_f64("trials", self.trials)?;
        Ok(n * self.probability)
    }

    /// Variance.
    pub fn variance(&self) -> BenchmarkResult<f64> {
        let n = count_to_f64("trials", self.trials)?;
        Ok(n * self.probability * self.failure_probability())
    }

    /// Standard deviation.
    pub fn standard_deviation(&self) -> BenchmarkResult<f64> {
        Ok(self.variance()?.sqrt())
    }

    /// Probability of at least one success.
    pub fn probability_at_least_one_success(&self) -> f64 {
        if self.probability == 0.0 {
            0.0
        } else if self.probability == 1.0 {
            1.0
        } else {
            -((self.trials as f64) * (-self.probability).ln_1p()).exp_m1()
        }
    }

    /// Probability of zero successes.
    pub fn probability_zero_successes(&self) -> f64 {
        if self.probability == 1.0 {
            0.0
        } else {
            ((self.trials as f64) * (-self.probability).ln_1p()).exp()
        }
    }
}

// =============================================================================
// Normal distribution
// =============================================================================

/// Normal/Gaussian distribution.
#[derive(Debug, Clone, Copy, PartialEq)]
pub struct Normal {
    mean: f64,
    standard_deviation: f64,
}

impl Normal {
    /// Construct a normal distribution.
    pub fn new(mean: f64, standard_deviation: f64) -> BenchmarkResult<Self> {
        validate_finite("mean", mean)?;
        validate_positive("standard_deviation", standard_deviation)?;

        Ok(Self {
            mean,
            standard_deviation,
        })
    }

    /// Mean.
    #[inline]
    pub const fn mean(self) -> f64 {
        self.mean
    }

    /// Standard deviation.
    #[inline]
    pub const fn standard_deviation(self) -> f64 {
        self.standard_deviation
    }

    /// Variance.
    #[inline]
    pub fn variance(self) -> f64 {
        self.standard_deviation * self.standard_deviation
    }

    /// Probability density function.
    pub fn pdf(self, x: f64) -> BenchmarkResult<f64> {
        validate_finite("x", x)?;

        let z = (x - self.mean) / self.standard_deviation;
        let exponent = -0.5 * z * z;

        let normalization =
            self.standard_deviation * (2.0 * std::f64::consts::PI).sqrt();

        let result = exponent.exp() / normalization;

        if !result.is_finite() {
            return Err(BenchmarkError::NumericalOverflow {
                operation: "normal pdf".to_owned(),
                value: Some(x.to_string()),
            });
        }

        Ok(result)
    }

    /// Natural logarithm of the probability density.
    pub fn log_pdf(self, x: f64) -> BenchmarkResult<f64> {
        validate_finite("x", x)?;

        let z = (x - self.mean) / self.standard_deviation;

        Ok(-0.5 * z * z
            - self.standard_deviation.ln()
            - LOG_SQRT_2_PI)
    }

    /// Cumulative distribution function.
    ///
    /// Uses a high-quality error-function approximation without introducing
    /// an external numerical dependency.
    pub fn cdf(self, x: f64) -> BenchmarkResult<f64> {
        validate_finite("x", x)?;

        let z = (x - self.mean) / (self.standard_deviation * 2.0_f64.sqrt());

        let erf = erf(z);

        normalize_probability("normal cdf", 0.5 * (1.0 + erf))
    }

    /// Survival function, P(X > x).
    pub fn survival_function(self, x: f64) -> BenchmarkResult<f64> {
        let cdf = self.cdf(x)?;
        normalize_probability("normal survival function", 1.0 - cdf)
    }

    /// Quantile/inverse CDF.
    ///
    /// Uses the Acklam rational approximation, followed by a Newton refinement
    /// step. This is useful for confidence intervals and normal approximations.
    pub fn inverse_cdf(self, probability: f64) -> BenchmarkResult<f64> {
        validate_probability("probability", probability)?;

        if probability == 0.0 {
            return Ok(f64::NEG_INFINITY);
        }

        if probability == 1.0 {
            return Ok(f64::INFINITY);
        }

        let z = inverse_standard_normal(probability)?;

        Ok(self.mean + self.standard_deviation * z)
    }
}

// =============================================================================
// Beta distribution
// =============================================================================

/// Beta distribution.
///
/// The beta distribution is particularly useful for representing uncertainty
/// over probabilities such as:
///
/// - success probability;
/// - heavy-output probability;
/// - readout fidelity;
/// - error probability;
/// - leakage probability.
///
/// It is also the conjugate prior/posterior family for Bernoulli/binomial
/// observations.
#[derive(Debug, Clone, Copy, PartialEq)]
pub struct Beta {
    alpha: f64,
    beta: f64,
}

impl Beta {
    /// Construct a beta distribution.
    pub fn new(alpha: f64, beta: f64) -> BenchmarkResult<Self> {
        validate_positive("alpha", alpha)?;
        validate_positive("beta", beta)?;

        Ok(Self { alpha, beta })
    }

    /// First shape parameter.
    #[inline]
    pub const fn alpha(self) -> f64 {
        self.alpha
    }

    /// Second shape parameter.
    #[inline]
    pub const fn beta(self) -> f64 {
        self.beta
    }

    /// Mean.
    #[inline]
    pub fn mean(self) -> f64 {
        self.alpha / (self.alpha + self.beta)
    }

    /// Variance.
    #[inline]
    pub fn variance(self) -> f64 {
        let sum = self.alpha + self.beta;

        self.alpha * self.beta / (sum * sum * (sum + 1.0))
    }

    /// Mode, when it exists in the interior.
    ///
    /// Returns `None` for distributions where the conventional interior mode
    /// does not exist, including alpha <= 1 or beta <= 1.
    pub fn mode(self) -> Option<f64> {
        if self.alpha > 1.0 && self.beta > 1.0 {
            Some(
                (self.alpha - 1.0)
                    / (self.alpha + self.beta - 2.0),
            )
        } else {
            None
        }
    }

    /// Beta-function logarithm:
    ///
    /// ln B(a,b) = ln Γ(a) + ln Γ(b) - ln Γ(a+b)
    pub fn log_normalization(self) -> BenchmarkResult<f64> {
        let result = log_gamma(self.alpha)?
            + log_gamma(self.beta)?
            - log_gamma(self.alpha + self.beta)?;

        if !result.is_finite() {
            return Err(BenchmarkError::NumericalOverflow {
                operation: "beta log normalization".to_owned(),
                value: Some(format!("a={}, b={}", self.alpha, self.beta)),
            });
        }

        Ok(result)
    }

    /// Probability density function.
    pub fn pdf(&self, x: f64) -> BenchmarkResult<f64> {
        validate_probability("x", x)?;

        if x == 0.0 {
            if self.alpha < 1.0 {
                return Ok(f64::INFINITY);
            }

            if self.alpha == 1.0 {
                return Ok((-(self.log_normalization()?)).exp());
            }

            return Ok(0.0);
        }

        if x == 1.0 {
            if self.beta < 1.0 {
                return Ok(f64::INFINITY);
            }

            if self.beta == 1.0 {
                return Ok((-(self.log_normalization()?)).exp());
            }

            return Ok(0.0);
        }

        let log_density = (self.alpha - 1.0) * x.ln()
            + (self.beta - 1.0) * (1.0 - x).ln()
            - self.log_normalization()?;

        let result = log_density.exp();

        if !result.is_finite() {
            return Err(BenchmarkError::NumericalOverflow {
                operation: "beta pdf".to_owned(),
                value: Some(x.to_string()),
            });
        }

        Ok(result)
    }

    /// Natural logarithm of the density.
    pub fn log_pdf(&self, x: f64) -> BenchmarkResult<f64> {
        validate_probability("x", x)?;

        if x == 0.0 {
            return if self.alpha < 1.0 {
                Ok(f64::INFINITY)
            } else if self.alpha == 1.0 {
                Ok(-self.log_normalization()?)
            } else {
                Ok(f64::NEG_INFINITY)
            };
        }

        if x == 1.0 {
            return if self.beta < 1.0 {
                Ok(f64::INFINITY)
            } else if self.beta == 1.0 {
                Ok(-self.log_normalization()?)
            } else {
                Ok(f64::NEG_INFINITY)
            };
        }

        Ok((self.alpha - 1.0) * x.ln()
            + (self.beta - 1.0) * (1.0 - x).ln()
            - self.log_normalization()?)
    }

    /// Cumulative distribution function.
    ///
    /// Uses the regularized incomplete beta function evaluated with a
    /// continued fraction. This implementation is deterministic and does not
    /// require an external special-functions crate.
    pub fn cdf(&self, x: f64) -> BenchmarkResult<f64> {
        validate_probability("x", x)?;

        if x == 0.0 {
            return Ok(0.0);
        }

        if x == 1.0 {
            return Ok(1.0);
        }

        let result = regularized_incomplete_beta(x, self.alpha, self.beta)?;

        normalize_probability("beta cdf", result)
    }

    /// Survival function.
    pub fn survival_function(&self, x: f64) -> BenchmarkResult<f64> {
        let cdf = self.cdf(x)?;
        normalize_probability("beta survival function", 1.0 - cdf)
    }
}

