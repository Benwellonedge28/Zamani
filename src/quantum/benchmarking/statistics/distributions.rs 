                .expect("diagonal covariance");

        let off_diagonal =
            distribution.covariance(100, 0, 1)
                .expect("off diagonal covariance");

        assert!((diagonal - 18.75).abs() < 1e-12);
        assert!((off_diagonal + 18.75).abs() < 1e-12);
    }

