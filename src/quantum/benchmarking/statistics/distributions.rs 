    #[test]
    fn beta_cdf_is_monotonic_for_representative_points() {
        let beta =
            Beta::new(2.5, 4.0).expect("valid beta");

        let mut previous = 0.0;

        for i in 0..=100 {
            let x = i as f64 / 100.0;
            let current = beta.cdf(x).expect("cdf");

            assert!(current + 1e-12 >= previous);
            previous = current;
        }

        assert!((previous - 1.0).abs() < 1e-12);
    }

