/// Construct a binomial distribution directly from observed successes and
/// total trials.
///
/// This is particularly useful for benchmark observations where the raw
/// measurement is:
///
/// `successes / shots`.
pub fn binomial_from_counts(
    successes: u64,
    trials: u64,
) -> BenchmarkResult<Binomial> {
    if trials == 0 {
        return Err(BenchmarkError::InvalidRange {
            field: "trials".to_owned(),
            value: trials.to_string(),
            minimum: Some("1".to_owned()),
            maximum: None,
        });
    }

    validate_count("successes", successes, Some(trials))?;

    let successes_f = count_to_f64("successes", successes)?;
    let trials_f = count_to_f64("trials", trials)?;

    Binomial::new(trials, successes_f / trials_f)
}

/// Empirical success probability from counts.
pub fn empirical_probability(
    successes: u64,
    trials: u64,
) -> BenchmarkResult<f64> {
    let distribution = binomial_from_counts(successes, trials)?;
    Ok(distribution.probability())
}

