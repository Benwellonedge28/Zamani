/// Approximation of erf(x).
///
/// Abramowitz & Stegun-style rational approximation with sufficient accuracy
/// for confidence calculations and normal CDF work in this module.
///
/// The implementation is deterministic and contains no external dependency.
fn erf(x: f64) -> f64 {
    // Numerical Recipes / Abramowitz-Stegun style approximation.
    //
    // Maximum absolute error is approximately 1e-7 for this compact form,
    // which is more than adequate for a low-level approximation helper but
    // downstream scientific claims must retain their explicit statistical
    // method and uncertainty.
    let sign = if x < 0.0 { -1.0 } else { 1.0 };
    let ax = x.abs();

    let p = 0.327_591_1;
    let a1 = 0.254_829_592;
    let a2 = -0.284_496_736;
    let a3 = 1.421_413_741;
    let a4 = -1.453_152_027;
    let a5 = 1.061_405_429;

    let t = 1.0 / (1.0 + p * ax);

    let polynomial =
        (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t;

    let value = 1.0 - polynomial * (-ax * ax).exp();

    sign * value
}

// =============================================================================
// Inverse standard normal
// =============================================================================

/// Inverse CDF of the standard normal distribution.
///
/// Uses Peter J. Acklam's rational approximation.
fn inverse_standard_normal(p: f64) -> BenchmarkResult<f64> {
    validate_probability("probability", p)?;

    if p == 0.0 {
        return Ok(f64::NEG_INFINITY);
    }

    if p == 1.0 {
        return Ok(f64::INFINITY);
    }

    // Coefficients for the central region.
    const A: [f64; 6] = [
        -3.969_683_028_665_376e1,
        2.209_460_984_245_205e2,
        -2.759_285_104_469_687e2,
        1.383_577_518_672_69e2,
        -3.066_479_806_614_716e1,
        2.506_628_277_459_239,
    ];

    const B: [f64; 5] = [
        -5.447_609_879_822_406e1,
        1.615_858_368_580_409e2,
        -1.556_989_798_598_866e2,
        6.680_131_188_771_972e1,
        -1.328_068_155_288_572e1,
    ];

    // Coefficients for the tails.
    const C: [f64; 6] = [
        -7.784_894_002_430_293e-3,
        -3.223_964_580_411_365e-1,
        -2.400_758_277_161_838,
        -2.549_732_539_343_734,
        4.374_664_141_464_968,
        2.938_163_982_698_783,
    ];

    const D: [f64; 4] = [
        7.784_695_709_041_462e-3,
        3.224_671_290_700_398e-1,
        2.445_134_137_142_996,
        3.754_408_661_907_416,
    ];

    const LOW: f64 = 0.024_25;
    const HIGH: f64 = 1.0 - LOW;

    if p < LOW {
        let q = (-2.0 * p.ln()).sqrt();

        let numerator =
            ((((C[0] * q + C[1]) * q + C[2]) * q + C[3]) * q + C[4])
                * q
                + C[5];

        let denominator =
            (((D[0] * q + D[1]) * q + D[2]) * q + D[3]) * q
                + 1.0;

        return Ok(numerator / denominator);
    }

    if p > HIGH {
        let q = (-2.0 * (1.0 - p).ln()).sqrt();

        let numerator =
            ((((C[0] * q + C[1]) * q + C[2]) * q + C[3]) * q + C[4])
                * q
                + C[5];

        let denominator =
            (((D[0] * q + D[1]) * q + D[2]) * q + D[3]) * q
                + 1.0;

        return Ok(-numerator / denominator);
    }

    let q = p - 0.5;
    let r = q * q;

    let numerator =
        (((((A[0] * r + A[1]) * r + A[2]) * r + A[3]) * r + A[4])
            * r
            + A[5])
            * q);

    let denominator =
        ((((B[0] * r + B[1]) * r + B[2]) * r + B[3]) * r + B[4]) * r
            + 1.0;

    Ok(numerator / denominator)
}

// =============================================================================
// Regularized incomplete beta
// =============================================================================

/// Continued-fraction evaluation for the incomplete beta function.
///
/// Adapted from the standard Numerical Recipes continued-fraction form.
fn beta_continued_fraction(
    a: f64,
    b: f64,
    x: f64,
) -> BenchmarkResult<f64> {
    const MAX_ITERATIONS: usize = 20_000;
    const EPSILON: f64 = 3.0e-14;
    const FPMIN: f64 = 1.0e-300;

    let qab = a + b;
    let qap = a + 1.0;
    let qam = a - 1.0;

    let mut c = 1.0;
    let mut d = 1.0 - qab * x / qap;

    if d.abs() < FPMIN {
        d = FPMIN;
    }

    d = 1.0 / d;

    let mut h = d;

    for m in 1..=MAX_ITERATIONS {
        let m_f = m as f64;
        let m2 = 2.0 * m_f;

        let numerator =
            m_f * (b - m_f) * x / ((qam + m2) * (a + m2));

        d = 1.0 + numerator * d;

        if d.abs() < FPMIN {
            d = FPMIN;
        }

        c = 1.0 + numerator / c;

        if c.abs() < FPMIN {
            c = FPMIN;
        }

        d = 1.0 / d;

        h *= d * c;

        let numerator = -(a + m_f) * (qab + m_f) * x
            / ((a + m2) * (qap + m2));

        d = 1.0 + numerator * d;

        if d.abs() < FPMIN {
            d = FPMIN;
        }

        c = 1.0 + numerator / c;

        if c.abs() < FPMIN {
            c = FPMIN;
        }

        d = 1.0 / d;

        let delta = d * c;

        h *= delta;

        if (delta - 1.0).abs() < EPSILON {
            return Ok(h);
        }
    }

    Err(BenchmarkError::StatisticalFitFailed {
        model: "regularized incomplete beta continued fraction".to_owned(),
        reason: format!(
            "failed to converge after {} iterations",
            MAX_ITERATIONS
        ),
    })
}

/// Regularized incomplete beta I_x(a,b).
fn regularized_incomplete_beta(
    x: f64,
    a: f64,
    b: f64,
) -> BenchmarkResult<f64> {
    validate_probability("x", x)?;
    validate_positive("a", a)?;
    validate_positive("b", b)?;

    if x == 0.0 {
        return Ok(0.0);
    }

    if x == 1.0 {
        return Ok(1.0);
    }

    let log_beta =
        log_gamma(a)? + log_gamma(b)? - log_gamma(a + b)?;

    let log_prefactor =
        a * x.ln() + b * (1.0 - x).ln() - log_beta;

    let prefactor = log_prefactor.exp();

    if !prefactor.is_finite() {
        return Err(BenchmarkError::NumericalOverflow {
            operation: "incomplete beta prefactor".to_owned(),
            value: Some(format!("x={}, a={}, b={}", x, a, b)),
        });
    }

    let result = if x < (a + 1.0) / (a + b + 2.0) {
        prefactor * beta_continued_fraction(a, b, x)? / a
    } else {
        1.0
            - prefactor
                * beta_continued_fraction(b, a, 1.0 - x)?
                / b
    };

    normalize_probability("regularized incomplete beta", result)
}

