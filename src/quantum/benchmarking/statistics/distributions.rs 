/// Summary of an empirical sample.
///
/// This type intentionally retains the original observations rather than
/// replacing them with only moments. That allows later benchmarking layers to
/// perform distribution-free analysis.
#[derive(Debug, Clone, PartialEq)]
pub struct EmpiricalDistribution {
    observations: Vec<f64>,
}

impl EmpiricalDistribution {
    /// Construct an empirical distribution.
    ///
    /// All observations must be finite.
    pub fn new(observations: Vec<f64>) -> BenchmarkResult<Self> {
        if observations.is_empty() {
            return Err(BenchmarkError::InsufficientSamples {
                required: 1,
                actual: 0,
                context: "empirical distribution".to_owned(),
            });
        }

        for (index, observation) in observations.iter().copied().enumerate() {
            validate_finite(
                &format!("observations[{}]", index),
                observation,
            )?;
        }

        Ok(Self { observations })
    }

    /// Number of observations.
    #[inline]
    pub fn len(&self) -> usize {
        self.observations.len()
    }

    /// Whether the empirical distribution contains no observations.
    ///
    /// This is always false for a successfully constructed instance, but is
    /// provided for collection-like API consistency.
    #[inline]
    pub fn is_empty(&self) -> bool {
        self.observations.is_empty()
    }

    /// Borrow the original observations.
    #[inline]
    pub fn observations(&self) -> &[f64] {
        &self.observations
    }

    /// Arithmetic mean.
    pub fn mean(&self) -> BenchmarkResult<f64> {
        let mut mean = 0.0;
        let mut count = 0.0;

        // Incremental mean avoids a large intermediate sum where possible.
        for observation in &self.observations {
            count += 1.0;
            mean += (*observation - mean) / count;
        }

        if !mean.is_finite() {
            return Err(BenchmarkError::NumericalOverflow {
                operation: "empirical mean".to_owned(),
                value: None,
            });
        }

        Ok(mean)
    }

    /// Population variance.
    pub fn population_variance(&self) -> BenchmarkResult<f64> {
        if self.observations.is_empty() {
            return Err(BenchmarkError::InsufficientSamples {
                required: 1,
                actual: 0,
                context: "population variance".to_owned(),
            });
        }

        let mean = self.mean()?;
        let mut sum = 0.0;

        for observation in &self.observations {
            let delta = *observation - mean;
            sum += delta * delta;
        }

        let variance = sum / self.observations.len() as f64;

        if !variance.is_finite() {
            return Err(BenchmarkError::NumericalOverflow {
                operation: "empirical population variance".to_owned(),
                value: None,
            });
        }

        Ok(variance)
    }

    /// Unbiased sample variance.
    ///
    /// Requires at least two observations.
    pub fn sample_variance(&self) -> BenchmarkResult<f64> {
        if self.observations.len() < 2 {
            return Err(BenchmarkError::InsufficientSamples {
                required: 2,
                actual: self.observations.len(),
                context: "sample variance".to_owned(),
            });
        }

        let mean = self.mean()?;
        let mut sum = 0.0;

        for observation in &self.observations {
            let delta = *observation - mean;
            sum += delta * delta;
        }

        let variance = sum / (self.observations.len() - 1) as f64;

        if !variance.is_finite() {
            return Err(BenchmarkError::NumericalOverflow {
                operation: "empirical sample variance".to_owned(),
                value: None,
            });
        }

        Ok(variance)
    }

    /// Population standard deviation.
    pub fn population_standard_deviation(&self) -> BenchmarkResult<f64> {
        Ok(self.population_variance()?.sqrt())
    }

    /// Unbiased sample standard deviation.
    pub fn sample_standard_deviation(&self) -> BenchmarkResult<f64> {
        Ok(self.sample_variance()?.sqrt())
    }

    /// Minimum observation.
    pub fn min(&self) -> BenchmarkResult<f64> {
        self.observations
            .iter()
            .copied()
            .reduce(f64::min)
            .ok_or_else(|| BenchmarkError::InsufficientSamples {
                required: 1,
                actual: 0,
                context: "empirical minimum".to_owned(),
            })
    }

    /// Maximum observation.
    pub fn max(&self) -> BenchmarkResult<f64> {
        self.observations
            .iter()
            .copied()
            .reduce(f64::max)
            .ok_or_else(|| BenchmarkError::InsufficientSamples {
                required: 1,
                actual: 0,
                context: "empirical maximum".to_owned(),
            })
    }

    /// Median.
    ///
    /// This method clones and sorts the data so the original observation order
    /// remains unchanged.
    pub fn median(&self) -> BenchmarkResult<f64> {
        let mut values = self.observations.clone();
        values.sort_by(f64::total_cmp);

        let middle = values.len() / 2;

        if values.len() % 2 == 0 {
            let left = values[middle - 1];
            let right = values[middle];
            Ok(left + (right - left) * 0.5)
        } else {
            Ok(values[middle])
        }
    }

    /// Quantile using linear interpolation between ordered observations.
    ///
    /// `q = 0` returns the minimum and `q = 1` returns the maximum.
    pub fn quantile(&self, q: f64) -> BenchmarkResult<f64> {
        validate_probability("q", q)?;

        let mut values = self.observations.clone();
        values.sort_by(f64::total_cmp);

        if values.len() == 1 {
            return Ok(values[0]);
        }

        let position = q * (values.len() - 1) as f64;
        let lower = position.floor() as usize;
        let upper = position.ceil() as usize;

        if lower == upper {
            return Ok(values[lower]);
        }

        let fraction = position - lower as f64;

        Ok(values[lower]
            + (values[upper] - values[lower]) * fraction)
    }

    /// Empirical cumulative distribution function:
    ///
    /// P(X <= x).
    pub fn cdf(&self, x: f64) -> BenchmarkResult<f64> {
        validate_finite("x", x)?;

        let count = self
            .observations
            .iter()
            .filter(|observation| **observation <= x)
            .count();

        Ok(count as f64 / self.observations.len() as f64)
    }

    /// Empirical survival function:
    ///
    /// P(X > x).
    pub fn survival_function(&self, x: f64) -> BenchmarkResult<f64> {
        validate_finite("x", x)?;

        let count = self
            .observations
            .iter()
            .filter(|observation| **observation > x)
            .count();

        Ok(count as f64 / self.observations.len() as f64)
    }
}

