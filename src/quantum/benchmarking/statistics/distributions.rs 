            f,
            "Binomial(n={}, p={:.17})",
            self.trials,
            self.probability
        )
    }
}

impl fmt::Display for Normal {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(
            f,
            "Normal(mean={:.17}, sd={:.17})",
            self.mean,
            self.standard_deviation
        )
    }
}

impl fmt::Display for Beta {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(
            f,
            "Beta(alpha={:.17}, beta={:.17})",
            self.alpha,
            self.beta
        )
    }
}

impl fmt::Display for Multinomial {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.write_str("Multinomial(")?;

        for (index, probability) in self.probabilities.iter().enumerate() {
            if index != 0 {
                f.write_str(", ")?;
            }

            write!(f, "{:.17}", probability)?;
        }

        f.write_str(")")
    }
}

impl fmt::Display for EmpiricalDistribution {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(
            f,
            "EmpiricalDistribution(n={})",
            self.observations.len()
        )
    }
}

