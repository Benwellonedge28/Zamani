/// A validated multinomial probability vector.
///
/// The probabilities must be non-negative, finite, and sum to one within the
/// explicitly permitted floating-point tolerance.
#[derive(Debug, Clone, PartialEq)]
pub struct Multinomial {
    probabilities: Vec<f64>,
}

impl Multinomial {
    /// Construct a multinomial distribution from category probabilities.
    ///
    /// The vector must:
    ///
    /// - contain at least one category;
    /// - contain only finite values;
    /// - contain no negative values;
    /// - sum to one within floating-point tolerance.
    pub fn new(probabilities: Vec<f64>) -> BenchmarkResult<Self> {
        if probabilities.is_empty() {
            return Err(BenchmarkError::InvalidConfiguration {
                field: "probabilities".to_owned(),
                reason: "at least one category is required".to_owned(),
            });
        }

        let mut sum = 0.0;

        for (index, probability) in probabilities.iter().copied().enumerate() {
            validate_probability(
                &format!("probabilities[{}]", index),
                probability,
            )?;

            sum += probability;
        }

        if !sum.is_finite() {
            return Err(BenchmarkError::NumericalOverflow {
                operation: "multinomial probability sum".to_owned(),
                value: None,
            });
        }

        if (sum - 1.0).abs() > PROBABILITY_ROUNDOFF_EPSILON {
            return Err(BenchmarkError::ValidationFailed {
                invariant: "multinomial probabilities sum to one".to_owned(),
                reason: format!("sum was {:.17}", sum),
            });
        }

        Ok(Self { probabilities })
    }

    /// Construct from non-negative weights by normalizing them.
    ///
    /// This method is intentionally explicit because normalization is a
    /// semantic operation and must not happen implicitly in `new`.
    pub fn from_weights(weights: Vec<f64>) -> BenchmarkResult<Self> {
        if weights.is_empty() {
            return Err(BenchmarkError::InvalidConfiguration {
                field: "weights".to_owned(),
                reason: "at least one category is required".to_owned(),
            });
        }

        let mut total = 0.0;

        for (index, weight) in weights.iter().copied().enumerate() {
            validate_non_negative(
                &format!("weights[{}]", index),
                weight,
            )?;

            total += weight;
        }

        validate_positive("weight sum", total)?;

        let probabilities = weights
            .into_iter()
            .map(|weight| weight / total)
            .collect::<Vec<_>>();

        Self::new(probabilities)
    }

    /// Number of categories.
    #[inline]
    pub fn categories(&self) -> usize {
        self.probabilities.len()
    }

    /// Borrow the category probabilities.
    #[inline]
    pub fn probabilities(&self) -> &[f64] {
        &self.probabilities
    }

    /// Probability of a particular category.
    pub fn probability(&self, index: usize) -> BenchmarkResult<f64> {
        self.probabilities
            .get(index)
            .copied()
            .ok_or_else(|| BenchmarkError::InvalidRange {
                field: "category index".to_owned(),
                value: index.to_string(),
                minimum: Some("0".to_owned()),
                maximum: Some(
                    self.probabilities
                        .len()
                        .saturating_sub(1)
                        .to_string(),
                ),
            })
    }

    /// Log probability of an ordered category-count vector.
    ///
    /// The count vector must have exactly the same number of entries as the
    /// distribution and must sum to `trials`.
    pub fn log_pmf(
        &self,
        counts: &[u64],
        trials: u64,
    ) -> BenchmarkResult<f64> {
        if counts.len() != self.probabilities.len() {
            return Err(BenchmarkError::InconsistentConfiguration {
                first: "counts".to_owned(),
                second: "probabilities".to_owned(),
                reason: format!(
                    "counts has {} categories but probabilities has {}",
                    counts.len(),
                    self.probabilities.len()
                ),
            });
        }

        let mut total_count = 0u64;

        for count in counts {
            total_count = total_count.checked_add(*count).ok_or_else(|| {
                BenchmarkError::NumericalOverflow {
                    operation: "multinomial count sum".to_owned(),
                    value: None,
                }
            })?;
        }

        if total_count != trials {
            return Err(BenchmarkError::InconsistentConfiguration {
                first: "counts".to_owned(),
                second: "trials".to_owned(),
                reason: format!(
                    "counts sum to {}, but trials is {}",
                    total_count, trials
                ),
            });
        }

        let mut result = log_factorial(trials)?;

        for (count, probability) in counts
            .iter()
            .copied()
            .zip(self.probabilities.iter().copied())
        {
            result -= log_factorial(count)?;

            if count == 0 {
                continue;
            }

            if probability == 0.0 {
                return Ok(f64::NEG_INFINITY);
            }

            let count_f = count_to_f64("multinomial count", count)?;
            result += count_f * probability.ln();
        }

        if result.is_nan() {
            return Err(BenchmarkError::NumericalOverflow {
                operation: "multinomial log pmf".to_owned(),
                value: Some(format!("trials={}", trials)),
            });
        }

        Ok(result)
    }

    /// Probability of a category-count vector.
    pub fn pmf(
        &self,
        counts: &[u64],
        trials: u64,
    ) -> BenchmarkResult<f64> {
        let log_probability = self.log_pmf(counts, trials)?;

        if log_probability == f64::NEG_INFINITY {
            return Ok(0.0);
        }

        let probability = log_probability.exp();

        if !probability.is_finite() {
            return Err(BenchmarkError::NumericalOverflow {
                operation: "multinomial pmf".to_owned(),
                value: Some(format!("trials={}", trials)),
            });
        }

        normalize_probability("multinomial pmf", probability)
    }

    /// Expected count for each category.
    pub fn expected_counts(
        &self,
        trials: u64,
    ) -> BenchmarkResult<Vec<f64>> {
        let trials = count_to_f64("trials", trials)?;

        Ok(self
            .probabilities
            .iter()
            .map(|probability| trials * *probability)
            .collect())
    }

    /// Covariance between two category counts.
    pub fn covariance(
        &self,
        trials: u64,
        i: usize,
        j: usize,
    ) -> BenchmarkResult<f64> {
        let pi = self.probability(i)?;
        let pj = self.probability(j)?;
        let n = count_to_f64("trials", trials)?;

        if i == j {
            Ok(n * pi * (1.0 - pi))
        } else {
            Ok(-n * pi * pj)
        }
    }
}

