/// Severity of a report finding.
#[derive(
    Debug,
    Clone,
    Copy,
    PartialEq,
    Eq,
    PartialOrd,
    Ord,
    Hash,
    Serialize,
    Deserialize,
)]
#[serde(rename_all = "snake_case")]
pub enum ReportSeverity {
    /// Informational observation.
    Info,

    /// Something noteworthy that does not invalidate the report.
    Warning,

    /// A serious issue affecting interpretation.
    Error,
}

impl ReportSeverity {
    /// Returns the stable machine-readable representation.
    pub const fn as_str(self) -> &'static str {
        match self {
            Self::Info => "info",
            Self::Warning => "warning",
            Self::Error => "error",
        }
    }
}

