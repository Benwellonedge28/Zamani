/// Builder for customized benchmark reports.
///
/// The builder is deliberately thin. The canonical report remains the
/// authoritative model.
#[derive(Debug)]
pub struct BenchmarkReportBuilder {
    report: BenchmarkReport,
}

impl BenchmarkReportBuilder {
    /// Sets the title.
    pub fn title(
        mut self,
        title: impl Into<String>,
    ) -> Result<Self, ReportError> {
        self.report.set_title(title)?;
        Ok(self)
    }

    /// Sets the description.
    pub fn description(
        mut self,
        description: impl Into<String>,
    ) -> Result<Self, ReportError> {
        self.report.set_description(description)?;
        Ok(self)
    }

    /// Adds metadata.
    pub fn metadata(
        mut self,
        key: impl Into<String>,
        value: Value,
    ) -> Result<Self, ReportError> {
        self.report.insert_metadata(key, value)?;
        Ok(self)
    }

    /// Adds a section.
    pub fn section(
        mut self,
        section: ReportSection,
    ) -> Result<Self, ReportError> {
        self.report.add_section(section)?;
        Ok(self)
    }

    /// Adds a finding.
    pub fn finding(
        mut self,
        finding: ReportFinding,
    ) -> Result<Self, ReportError> {
        self.report.add_finding(finding)?;
        Ok(self)
    }

    /// Adds a warning.
    pub fn warning(
        mut self,
        warning: impl Into<String>,
    ) -> Result<Self, ReportError> {
        self.report.add_warning(warning)?;
        Ok(self)
    }

    /// Adds an error.
    pub fn error(
        mut self,
        error: impl Into<String>,
    ) -> Result<Self, ReportError> {
        self.report.add_error(error)?;
        Ok(self)
    }

    /// Finishes and validates the report.
    pub fn build(self) -> Result<BenchmarkReport, ReportError> {
        self.report.validate()?;
        Ok(self.report)
    }
}

