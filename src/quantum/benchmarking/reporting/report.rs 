fn validate_non_empty_bounded(
    field: &'static str,
    value: &str,
    maximum: usize,
) -> Result<(), ReportError> {
    if value.trim().is_empty() {
        return Err(ReportError::EmptyField { field });
    }

    if value.len() > maximum {
        return Err(ReportError::LengthExceeded {
            field,
            maximum,
            actual: value.len(),
        });
    }

    Ok(())
}

fn validate_identifier(
    field: &'static str,
    value: &str,
    maximum: usize,
) -> Result<(), ReportError> {
    validate_non_empty_bounded(field, value, maximum)?;

    if value.chars().any(|character| {
        character.is_control()
    }) {
        return Err(ReportError::InvalidIdentifier {
            field,
            reason: "control characters are not allowed",
        });
    }

    Ok(())
}

fn validate_json_value_size(
    field: &'static str,
    value: &Value,
    maximum: usize,
) -> Result<(), ReportError> {
    let serialized = serde_json::to_vec(value).map_err(|error| {
        ReportError::ResultSerialization {
            message: error.to_string(),
        }
    })?;

    if serialized.len() > maximum {
        return Err(ReportError::JsonValueTooLarge {
            field,
            maximum,
        });
    }

    Ok(())
}

fn validate_rendered_size(
    output: &str,
) -> Result<(), ReportError> {
    if output.len() > MAX_RENDERED_REPORT_SIZE {
        return Err(ReportError::RenderedReportTooLarge {
            maximum: MAX_RENDERED_REPORT_SIZE,
            actual: output.len(),
        });
    }

    Ok(())
}

fn required_string(
    object: &Map<String, Value>,
    names: &[&str],
    field: &'static str,
) -> Result<String, ReportError> {
    for name in names {
        if let Some(value) = object.get(*name) {
            if let Some(value) = value.as_str() {
                if !value.trim().is_empty() {
                    return Ok(value.to_owned());
                }
            }
        }
    }

    Err(ReportError::EmptyField { field })
}

fn extract_nested_string(
    object: &Map<String, Value>,
    paths: &[&[&str]],
    field: &'static str,
) -> Result<String, ReportError> {
    for path in paths {
        if let Some(value) = lookup_path(object, path) {
            if let Some(value) = value.as_str() {
                if !value.trim().is_empty() {
                    return Ok(value.to_owned());
                }
            }
        }
    }

    Err(ReportError::EmptyField { field })
}

fn lookup_path<'a>(
    object: &'a Map<String, Value>,
    path: &[&str],
) -> Option<&'a Value> {
    if path.is_empty() {
        return None;
    }

    let mut current = object.get(path[0])?;

    for component in &path[1..] {
        current = current.as_object()?.get(*component)?;
    }

    Some(current)
}

fn build_default_title(
    benchmark_id: &str,
    benchmark_version: &str,
) -> String {
    format!(
        "Zamani Quantum Benchmark — {} v{}",
        benchmark_id,
        benchmark_version
    )
}

fn copy_if_present(
    source: &Map<String, Value>,
    section: &mut ReportSection,
    keys: &[&str],
) -> Result<(), ReportError> {
    for key in keys {
        if let Some(value) = source.get(*key) {
            section.insert((*key).to_owned(), value.clone())?;
        }
    }

    Ok(())
}

fn render_json_value(
    value: &Value,
) -> Result<String, ReportError> {
    let output =
        serde_json::to_string(value).map_err(|error| {
            ReportError::ResultSerialization {
                message: error.to_string(),
            }
        })?;

    validate_rendered_size(&output)?;
    Ok(output)
}

fn compact_json_value(value: &Value) -> String {
    serde_json::to_string(value)
        .unwrap_or_else(|_| "<invalid-json>".to_owned())
}

fn write_report_header(
    output: &mut String,
    report: &BenchmarkReport,
) -> Result<(), ReportError> {
    writeln!(
        output,
        "{}",
        report.title
    )
    .expect("writing to String cannot fail");

    writeln!(
        output,
        "{}",
        "=".repeat(report.title.chars().count())
    )
    .expect("writing to String cannot fail");

    writeln!(
        output,
        "Benchmark: {}",
        report.benchmark_id
    )
    .expect("writing to String cannot fail");

    writeln!(
        output,
        "Benchmark version: {}",
        report.benchmark_version
    )
    .expect("writing to String cannot fail");

    writeln!(
        output,
        "Result ID: {}",
        report.result_id
    )
    .expect("writing to String cannot fail");

    writeln!(
        output,
        "Report schema: {} v{}",
        report.schema_id,
        report.schema_version
    )
    .expect("writing to String cannot fail");

    if let Some(description) = &report.description {
        writeln!(output, "\n{}", description)
            .expect("writing to String cannot fail");
    }

    Ok(())
}

fn write_section_text(
    output: &mut String,
    section: &ReportSection,
) -> Result<(), ReportError> {
    writeln!(
        output,
        "\n{}",
        section.title
    )
    .expect("writing to String cannot fail");

    writeln!(
        output,
        "{}",
        "-".repeat(section.title.chars().count())
    )
    .expect("writing to String cannot fail");

    if let Some(body) = &section.body {
        writeln!(output, "{}", body)
            .expect("writing to String cannot fail");
    }

    for (key, value) in &section.data {
        writeln!(
            output,
            "{}: {}",
            key,
            compact_json_value(value)
        )
        .expect("writing to String cannot fail");
    }

    Ok(())
}

fn write_findings_text(
    output: &mut String,
    findings: &[ReportFinding],
) -> Result<(), ReportError> {
    if findings.is_empty() {
        return Ok(());
    }

    output.push_str("\nFindings\n--------\n");

    for finding in findings {
        writeln!(
            output,
            "[{}] {}: {}",
            finding.severity.as_str(),
            finding.code,
            finding.message
        )
        .expect("writing to String cannot fail");
    }

    Ok(())
}

fn write_messages_text(
    output: &mut String,
    heading: &str,
    messages: &[String],
) -> Result<(), ReportError> {
    if messages.is_empty() {
        return Ok(());
    }

    writeln!(output, "\n{}\n{}", heading, "-".repeat(heading.len()))
        .expect("writing to String cannot fail");

    for message in messages {
        writeln!(output, "- {}", message)
            .expect("writing to String cannot fail");
    }

    Ok(())
}

fn markdown_escape(value: &str) -> String {
    value
        .replace('\\', "\\\\")
        .replace('|', "\\|")
        .replace('`', "\\`")
        .replace('\r', "")
        .replace('\n', " ")
}

