// =============================================================================
// Report finding
// =============================================================================

/// A structured report finding.
///
/// Findings are presentation/interpretation metadata. They do not replace
/// authoritative benchmark errors or metrics.
#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
pub struct ReportFinding {
    /// Finding severity.
    pub severity: ReportSeverity,

    /// Stable machine-readable finding code.
    pub code: String,

    /// Human-readable finding message.
    pub message: String,

    /// Optional section to which the finding belongs.
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub section_id: Option<String>,
}

impl ReportFinding {
    /// Creates a validated finding.
    pub fn new(
        severity: ReportSeverity,
        code: impl Into<String>,
        message: impl Into<String>,
    ) -> Result<Self, ReportError> {
        let finding = Self {
            severity,
            code: code.into(),
            message: message.into(),
            section_id: None,
        };

        finding.validate()?;
        Ok(finding)
    }

    /// Associates the finding with a report section.
    pub fn with_section(
        mut self,
        section_id: impl Into<String>,
    ) -> Result<Self, ReportError> {
        let section_id = section_id.into();

        validate_identifier(
            "finding.section_id",
            &section_id,
            MAX_SECTION_ID_LENGTH,
        )?;

        self.section_id = Some(section_id);
        self.validate()?;

        Ok(self)
    }

    /// Validates the finding.
    pub fn validate(&self) -> Result<(), ReportError> {
        validate_identifier(
            "finding.code",
            &self.code,
            MAX_FINDING_CODE_LENGTH,
        )?;

        validate_non_empty_bounded(
            "finding.message",
            &self.message,
            MAX_FINDING_MESSAGE_LENGTH,
        )?;

        if let Some(section_id) = &self.section_id {
            validate_identifier(
                "finding.section_id",
                section_id,
                MAX_SECTION_ID_LENGTH,
            )?;
        }

        Ok(())
    }
}

// =============================================================================
// Report section
// =============================================================================

/// A deterministic report section.
///
/// Sections intentionally contain a textual body plus optional structured
/// data. This lets future table/JSON/Markdown renderers reuse the same report
/// without forcing protocol-specific presentation logic into this file.
#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
pub struct ReportSection {
    /// Stable section identifier.
    pub id: String,

    /// Human-readable section title.
    pub title: String,

    /// Optional textual body.
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub body: Option<String>,

    /// Structured section data.
    ///
    /// `BTreeMap` is used deliberately so serialization remains deterministic.
    #[serde(default, skip_serializing_if = "BTreeMap::is_empty")]
    pub data: BTreeMap<String, Value>,
}

impl ReportSection {
    /// Creates an empty validated section.
    pub fn new(
        id: impl Into<String>,
        title: impl Into<String>,
    ) -> Result<Self, ReportError> {
        let section = Self {
            id: id.into(),
            title: title.into(),
            body: None,
            data: BTreeMap::new(),
        };

        section.validate()?;
        Ok(section)
    }

    /// Adds a textual body.
    pub fn with_body(
        mut self,
        body: impl Into<String>,
    ) -> Result<Self, ReportError> {
        let body = body.into();

        if body.len() > MAX_SECTION_BODY_LENGTH {
            return Err(ReportError::LengthExceeded {
                field: "section.body",
                maximum: MAX_SECTION_BODY_LENGTH,
                actual: body.len(),
            });
        }

        self.body = Some(body);
        self.validate()?;
        Ok(self)
    }

    /// Inserts one structured data field.
    pub fn insert(
        &mut self,
        key: impl Into<String>,
        value: Value,
    ) -> Result<(), ReportError> {
        let key = key.into();

        validate_identifier(
            "section.data.key",
            &key,
            MAX_REPORT_METADATA_KEY_LENGTH,
        )?;

        if self.data.len() >= MAX_REPORT_METADATA_FIELDS
            && !self.data.contains_key(&key)
        {
            return Err(ReportError::CollectionLimitExceeded {
                field: "section.data",
                maximum: MAX_REPORT_METADATA_FIELDS,
            });
        }

        validate_json_value_size(
            "section.data.value",
            &value,
            MAX_REPORT_METADATA_VALUE_LENGTH,
        )?;

        self.data.insert(key, value);
        Ok(())
    }

    /// Validates the section.
    pub fn validate(&self) -> Result<(), ReportError> {
        validate_identifier(
            "section.id",
            &self.id,
            MAX_SECTION_ID_LENGTH,
        )?;

        validate_non_empty_bounded(
            "section.title",
            &self.title,
            MAX_SECTION_TITLE_LENGTH,
        )?;

        if let Some(body) = &self.body {
            if body.len() > MAX_SECTION_BODY_LENGTH {
                return Err(ReportError::LengthExceeded {
                    field: "section.body",
                    maximum: MAX_SECTION_BODY_LENGTH,
                    actual: body.len(),
                });
            }
        }

        if self.data.len() > MAX_REPORT_METADATA_FIELDS {
            return Err(ReportError::CollectionLimitExceeded {
                field: "section.data",
                maximum: MAX_REPORT_METADATA_FIELDS,
            });
        }

        for (key, value) in &self.data {
            validate_identifier(
                "section.data.key",
                key,
                MAX_REPORT_METADATA_KEY_LENGTH,
            )?;

            validate_json_value_size(
                "section.data.value",
                value,
                MAX_REPORT_METADATA_VALUE_LENGTH,
            )?;
        }

        Ok(())
    }
}

// =============================================================================
// Report error
// =============================================================================

/// Errors produced by report construction or rendering.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum ReportError {
    /// A required string was empty.
    EmptyField {
        field: &'static str,
    },

    /// A bounded field exceeded its permitted size.
    LengthExceeded {
        field: &'static str,
        maximum: usize,
        actual: usize,
    },

    /// A collection exceeded its production safety bound.
    CollectionLimitExceeded {
        field: &'static str,
        maximum: usize,
    },

    /// An identifier contained invalid characters.
    InvalidIdentifier {
        field: &'static str,
        reason: &'static str,
    },

    /// A JSON value was too large.
    JsonValueTooLarge {
        field: &'static str,
        maximum: usize,
    },

    /// The supplied benchmark result serialized incorrectly.
    ResultSerialization {
        message: String,
    },

    /// The serialized benchmark result was not an object.
    ResultNotObject,

    /// The rendered report would exceed the maximum permitted output size.
    RenderedReportTooLarge {
        maximum: usize,
        actual: usize,
    },

    /// A report invariant was violated.
    InvalidReport {
        reason: &'static str,
    },
}

impl fmt::Display for ReportError {
    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            Self::EmptyField { field } => {
                write!(formatter, "{} must not be empty", field)
            }

            Self::LengthExceeded {
                field,
                maximum,
                actual,
            } => {
                write!(
                    formatter,
                    "{} exceeds maximum length {} bytes; actual {} bytes",
                    field, maximum, actual
                )
            }

            Self::CollectionLimitExceeded { field, maximum } => {
                write!(
                    formatter,
                    "{} exceeds maximum collection size {}",
                    field, maximum
                )
            }

            Self::InvalidIdentifier { field, reason } => {
                write!(
                    formatter,
                    "{} contains an invalid identifier: {}",
                    field, reason
                )
            }

            Self::JsonValueTooLarge { field, maximum } => {
                write!(
                    formatter,
                    "{} exceeds maximum JSON value size {} bytes",
                    field, maximum
                )
            }

            Self::ResultSerialization { message } => {
                write!(
                    formatter,
                    "benchmark result serialization failed: {}",
                    message
                )
            }

            Self::ResultNotObject => {
                write!(
                    formatter,
                    "benchmark result serialization did not produce a JSON object"
                )
            }

            Self::RenderedReportTooLarge { maximum, actual } => {
                write!(
                    formatter,
                    "rendered report exceeds maximum size {} bytes; actual {} bytes",
                    maximum, actual
                )
            }

            Self::InvalidReport { reason } => {
                write!(formatter, "invalid benchmark report: {}", reason)
            }
        }
    }
}

impl std::error::Error for ReportError {}

// =============================================================================
// Canonical report
// =============================================================================

/// Canonical format-independent benchmark report.
///
/// This is the object consumed by:
///
/// - JSON exporters;
/// - Markdown exporters;
/// - text exporters;
/// - CSV/table exporters;
/// - CI integrations;
/// - future dashboard integrations;
/// - Zamani standard-library bindings.
///
/// It contains a normalized snapshot of the source `BenchmarkResult`, rather
/// than holding a reference to it. This makes the report independently
/// serializable and prevents lifetime coupling to the result object.
#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
pub struct BenchmarkReport {
    /// Report schema identifier.
    pub schema_id: String,

    /// Report schema version.
    pub schema_version: u16,

    /// Source benchmark-result schema identifier.
    pub source_result_schema_id: String,

    /// Source benchmark-result schema version.
    pub source_result_schema_version: u16,

    /// Source result identifier, represented as a string to keep this module
    /// independent from the internals of the result identity wrapper.
    pub result_id: String,

    /// Benchmark identifier.
    pub benchmark_id: String,

    /// Benchmark protocol version.
    pub benchmark_version: String,

    /// Human-readable report title.
    pub title: String,

    /// Optional report description.
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub description: Option<String>,

    /// Format-neutral report metadata.
    ///
    /// Sorted ordering guarantees deterministic serialization.
    #[serde(default, skip_serializing_if = "BTreeMap::is_empty")]
    pub metadata: BTreeMap<String, Value>,

    /// Report sections in explicitly chosen presentation order.
    #[serde(default)]
    pub sections: Vec<ReportSection>,

    /// Structured findings.
    #[serde(default)]
    pub findings: Vec<ReportFinding>,

    /// Warnings preserved from or generated for the report.
    #[serde(default)]
    pub warnings: Vec<String>,

    /// Errors preserved from or generated for the report.
    #[serde(default)]
    pub errors: Vec<String>,

    /// Complete normalized source result.
    ///
    /// Keeping the source snapshot here is intentional: a report must remain
    /// independently useful and auditable even when rendered without access to
    /// the original in-memory result object.
    pub source_result: Value,
}

impl BenchmarkReport {
    /// Creates the canonical report from an authoritative benchmark result.
    ///
    /// The source result is serialized into a bounded JSON representation.
    /// No scientific values are recalculated here.
    pub fn from_result(
        result: &BenchmarkResult,
    ) -> Result<Self, ReportError> {
        let source_result = serde_json::to_value(result).map_err(|error| {
            ReportError::ResultSerialization {
                message: error.to_string(),
            }
        })?;

        Self::from_serialized_result(source_result)
    }

    /// Creates a report from an already serialized result.
    ///
    /// This is useful for:
    ///
    /// - persisted benchmark results;
    /// - CI;
    /// - external result stores;
    /// - independent re-reporting;
    /// - future Zamani tooling.
    ///
    /// The caller is expected to have validated the result using the canonical
    /// result validator before treating the result as scientifically trusted.
    pub fn from_serialized_result(
        source_result: Value,
    ) -> Result<Self, ReportError> {
        validate_json_value_size(
            "source_result",
            &source_result,
            MAX_SECTION_BODY_LENGTH * 8,
        )?;

        let object = source_result
            .as_object()
            .ok_or(ReportError::ResultNotObject)?;

        let result_id = required_string(
            object,
            &[
                "result_id",
                "id",
                "result_identity",
            ],
            "result_id",
        )?;

        let benchmark_id = extract_nested_string(
            object,
            &[
                &["benchmark_identity", "benchmark_id"],
                &["benchmark", "benchmark_id"],
                &["benchmark_id"],
            ],
            "benchmark_id",
        )?;

        let benchmark_version = extract_nested_string(
            object,
            &[
                &["benchmark_identity", "benchmark_version"],
                &["benchmark", "benchmark_version"],
                &["benchmark_version"],
            ],
            "benchmark_version",
        )?;

        let title = build_default_title(
            &benchmark_id,
            &benchmark_version,
        );

        let mut report = Self {
            schema_id: BENCHMARK_REPORT_SCHEMA_ID.to_owned(),
            schema_version: BENCHMARK_REPORT_SCHEMA_VERSION,
            source_result_schema_id: BENCHMARK_RESULT_SCHEMA_ID.to_owned(),
            source_result_schema_version: BENCHMARK_RESULT_SCHEMA_VERSION,
            result_id,
            benchmark_id,
            benchmark_version,
            title,
            description: None,
            metadata: BTreeMap::new(),
            sections: Vec::new(),
            findings: Vec::new(),
            warnings: Vec::new(),
            errors: Vec::new(),
            source_result,
        };

        report.populate_standard_sections(object)?;
        report.populate_status_findings(object)?;
        report.validate()?;

        Ok(report)
    }

    /// Creates a report builder from an authoritative benchmark result.
    ///
    /// This method is useful when callers want to customize title,
    /// description, sections or findings without reconstructing the source
    /// result.
    pub fn builder(
        result: &BenchmarkResult,
    ) -> Result<BenchmarkReportBuilder, ReportError> {
        Ok(BenchmarkReportBuilder {
            report: Self::from_result(result)?,
        })
    }

    /// Sets the report title.
    pub fn set_title(
        &mut self,
        title: impl Into<String>,
    ) -> Result<(), ReportError> {
        let title = title.into();

        validate_non_empty_bounded(
            "report.title",
            &title,
            MAX_REPORT_TITLE_LENGTH,
        )?;

        self.title = title;
        Ok(())
    }

    /// Sets the report description.
    pub fn set_description(
        &mut self,
        description: impl Into<String>,
    ) -> Result<(), ReportError> {
        let description = description.into();

        if description.len() > MAX_REPORT_DESCRIPTION_LENGTH {
            return Err(ReportError::LengthExceeded {
                field: "report.description",
                maximum: MAX_REPORT_DESCRIPTION_LENGTH,
                actual: description.len(),
            });
        }

        self.description = Some(description);
        Ok(())
    }

    /// Inserts report metadata.
    ///
    /// Metadata keys are sorted automatically.
    pub fn insert_metadata(
        &mut self,
        key: impl Into<String>,
        value: Value,
    ) -> Result<(), ReportError> {
        let key = key.into();

        validate_identifier(
            "report.metadata.key",
            &key,
            MAX_REPORT_METADATA_KEY_LENGTH,
        )?;

        if self.metadata.len() >= MAX_REPORT_METADATA_FIELDS
            && !self.metadata.contains_key(&key)
        {
            return Err(ReportError::CollectionLimitExceeded {
                field: "report.metadata",
                maximum: MAX_REPORT_METADATA_FIELDS,
            });
        }

        validate_json_value_size(
            "report.metadata.value",
            &value,
            MAX_REPORT_METADATA_VALUE_LENGTH,
        )?;

        self.metadata.insert(key, value);
        Ok(())
    }

    /// Adds a section while preserving explicit caller ordering.
    pub fn add_section(
        &mut self,
        section: ReportSection,
    ) -> Result<(), ReportError> {
        section.validate()?;

        if self.sections.len() >= MAX_REPORT_SECTIONS {
            return Err(ReportError::CollectionLimitExceeded {
                field: "report.sections",
                maximum: MAX_REPORT_SECTIONS,
            });
        }

        if self.sections.iter().any(|existing| existing.id == section.id) {
            return Err(ReportError::InvalidReport {
                reason: "duplicate section identifier",
            });
        }

        self.sections.push(section);
        Ok(())
    }

    /// Adds a structured finding.
    pub fn add_finding(
        &mut self,
        finding: ReportFinding,
    ) -> Result<(), ReportError> {
        finding.validate()?;

        if self.findings.len() >= MAX_REPORT_FINDINGS {
            return Err(ReportError::CollectionLimitExceeded {
                field: "report.findings",
                maximum: MAX_REPORT_FINDINGS,
            });
        }

        self.findings.push(finding);
        Ok(())
    }

    /// Adds a warning.
    pub fn add_warning(
        &mut self,
        warning: impl Into<String>,
    ) -> Result<(), ReportError> {
        let warning = warning.into();

        validate_non_empty_bounded(
            "report.warning",
            &warning,
            MAX_REPORT_MESSAGE_LENGTH,
        )?;

        if self.warnings.len() >= MAX_REPORT_WARNINGS {
            return Err(ReportError::CollectionLimitExceeded {
                field: "report.warnings",
                maximum: MAX_REPORT_WARNINGS,
            });
        }

        self.warnings.push(warning);
        Ok(())
    }

    /// Adds an error.
    pub fn add_error(
        &mut self,
        error: impl Into<String>,
    ) -> Result<(), ReportError> {
        let error = error.into();

        validate_non_empty_bounded(
            "report.error",
            &error,
            MAX_REPORT_MESSAGE_LENGTH,
        )?;

        if self.errors.len() >= MAX_REPORT_ERRORS {
            return Err(ReportError::CollectionLimitExceeded {
                field: "report.errors",
                maximum: MAX_REPORT_ERRORS,
            });
        }

        self.errors.push(error);
        Ok(())
    }

    /// Returns the number of report sections.
    #[must_use]
    pub fn section_count(&self) -> usize {
        self.sections.len()
    }

    /// Returns the number of report findings.
    #[must_use]
    pub fn finding_count(&self) -> usize {
        self.findings.len()
    }

    /// Returns whether the report contains errors.
    #[must_use]
    pub fn has_errors(&self) -> bool {
        !self.errors.is_empty()
            || self
                .findings
                .iter()
                .any(|finding| finding.severity == ReportSeverity::Error)
    }

    /// Returns whether the report contains warnings.
    #[must_use]
    pub fn has_warnings(&self) -> bool {
        !self.warnings.is_empty()
            || self
                .findings
                .iter()
                .any(|finding| finding.severity == ReportSeverity::Warning)
    }

    /// Validates all report invariants.
    pub fn validate(&self) -> Result<(), ReportError> {
        if self.schema_id != BENCHMARK_REPORT_SCHEMA_ID {
            return Err(ReportError::InvalidReport {
                reason: "unsupported report schema identifier",
            });
        }

        if self.schema_version != BENCHMARK_REPORT_SCHEMA_VERSION {
            return Err(ReportError::InvalidReport {
                reason: "unsupported report schema version",
            });
        }

        if self.source_result_schema_id != BENCHMARK_RESULT_SCHEMA_ID {
            return Err(ReportError::InvalidReport {
                reason: "unsupported source result schema identifier",
            });
        }

        if self.source_result_schema_version
            != BENCHMARK_RESULT_SCHEMA_VERSION
        {
            return Err(ReportError::InvalidReport {
                reason: "unsupported source result schema version",
            });
        }

        validate_non_empty_bounded(
            "report.result_id",
            &self.result_id,
            MAX_REPORT_TITLE_LENGTH,
        )?;

        validate_identifier(
            "report.benchmark_id",
            &self.benchmark_id,
            MAX_SECTION_ID_LENGTH,
        )?;

        validate_non_empty_bounded(
            "report.benchmark_version",
            &self.benchmark_version,
            MAX_BENCHMARK_VERSION_LENGTH,
        )?;

        validate_non_empty_bounded(
            "report.title",
            &self.title,
            MAX_REPORT_TITLE_LENGTH,
        )?;

        if let Some(description) = &self.description {
            if description.len() > MAX_REPORT_DESCRIPTION_LENGTH {
                return Err(ReportError::LengthExceeded {
                    field: "report.description",
                    maximum: MAX_REPORT_DESCRIPTION_LENGTH,
                    actual: description.len(),
                });
            }
        }

        if self.metadata.len() > MAX_REPORT_METADATA_FIELDS {
            return Err(ReportError::CollectionLimitExceeded {
                field: "report.metadata",
                maximum: MAX_REPORT_METADATA_FIELDS,
            });
        }

        for (key, value) in &self.metadata {
            validate_identifier(
                "report.metadata.key",
                key,
                MAX_REPORT_METADATA_KEY_LENGTH,
            )?;

            validate_json_value_size(
                "report.metadata.value",
                value,
                MAX_REPORT_METADATA_VALUE_LENGTH,
            )?;
        }

        if self.sections.len() > MAX_REPORT_SECTIONS {
            return Err(ReportError::CollectionLimitExceeded {
                field: "report.sections",
                maximum: MAX_REPORT_SECTIONS,
            });
        }

        let mut section_ids = std::collections::BTreeSet::new();

        for section in &self.sections {
            section.validate()?;

            if !section_ids.insert(section.id.clone()) {
                return Err(ReportError::InvalidReport {
                    reason: "duplicate section identifier",
                });
            }
        }

        if self.findings.len() > MAX_REPORT_FINDINGS {
            return Err(ReportError::CollectionLimitExceeded {
                field: "report.findings",
                maximum: MAX_REPORT_FINDINGS,
            });
        }

        for finding in &self.findings {
            finding.validate()?;
        }

        if self.warnings.len() > MAX_REPORT_WARNINGS {
            return Err(ReportError::CollectionLimitExceeded {
                field: "report.warnings",
                maximum: MAX_REPORT_WARNINGS,
            });
        }

        for warning in &self.warnings {
            validate_non_empty_bounded(
                "report.warning",
                warning,
                MAX_REPORT_MESSAGE_LENGTH,
            )?;
        }

        if self.errors.len() > MAX_REPORT_ERRORS {
            return Err(ReportError::CollectionLimitExceeded {
                field: "report.errors",
                maximum: MAX_REPORT_ERRORS,
            })?;
        }

        for error in &self.errors {
            validate_non_empty_bounded(
                "report.error",
                error,
                MAX_REPORT_MESSAGE_LENGTH,
            )?;
        }

        validate_json_value_size(
            "report.source_result",
            &self.source_result,
            MAX_SECTION_BODY_LENGTH * 8,
        )?;

        Ok(())
    }

    /// Returns the canonical JSON representation of this report.
    ///
    /// `serde_json` is intentionally used here rather than a hand-written JSON
    /// serializer so escaping and JSON correctness remain delegated to the
    /// serialization library.
    pub fn to_json(&self) -> Result<String, ReportError> {
        self.validate()?;

        let value = serde_json::to_value(self).map_err(|error| {
            ReportError::ResultSerialization {
                message: error.to_string(),
            }
        })?;

        render_json_value(&value)
    }

    /// Returns pretty-printed canonical JSON.
    pub fn to_json_pretty(&self) -> Result<String, ReportError> {
        self.validate()?;

        let output =
            serde_json::to_string_pretty(self).map_err(|error| {
                ReportError::ResultSerialization {
                    message: error.to_string(),
                }
            })?;

        validate_rendered_size(&output)?;
        Ok(output)
    }

    /// Returns deterministic human-readable text.
    pub fn to_text(&self) -> Result<String, ReportError> {
        self.validate()?;

        let mut output = String::new();

        write_report_header(&mut output, self)?;

        for section in &self.sections {
            write_section_text(&mut output, section)?;
        }

        write_findings_text(&mut output, &self.findings)?;
        write_messages_text(
            &mut output,
            "Warnings",
            &self.warnings,
        )?;
        write_messages_text(
            &mut output,
            "Errors",
            &self.errors,
        )?;

        validate_rendered_size(&output)?;
        Ok(output)
    }

    /// Returns deterministic Markdown.
    ///
    /// This intentionally lives here as a minimal canonical renderer. A future
    /// `reporting::markdown` module can build richer presentation without
    /// changing the report data model.
    pub fn to_markdown(&self) -> Result<String, ReportError> {
        self.validate()?;

        let mut output = String::new();

        writeln!(&mut output, "# {}", markdown_escape(&self.title))
            .expect("writing to String cannot fail");

        writeln!(
            &mut output,
            "\n- **Benchmark:** `{}`",
            markdown_escape(&self.benchmark_id)
        )
        .expect("writing to String cannot fail");

        writeln!(
            &mut output,
            "- **Benchmark version:** `{}`",
            markdown_escape(&self.benchmark_version)
        )
        .expect("writing to String cannot fail");

        writeln!(
            &mut output,
            "- **Result ID:** `{}`",
            markdown_escape(&self.result_id)
        )
        .expect("writing to String cannot fail");

        if let Some(description) = &self.description {
            writeln!(
                &mut output,
                "\n{}",
                markdown_escape(description)
            )
            .expect("writing to String cannot fail");
        }

        for section in &self.sections {
            writeln!(
                &mut output,
                "\n## {}",
                markdown_escape(&section.title)
            )
            .expect("writing to String cannot fail");

            if let Some(body) = &section.body {
                writeln!(
                    &mut output,
                    "\n{}",
                    markdown_escape(body)
                )
                .expect("writing to String cannot fail");
            }

            if !section.data.is_empty() {
                output.push_str("\n| Field | Value |\n");
                output.push_str("| --- | --- |\n");

                for (key, value) in &section.data {
                    writeln!(
                        &mut output,
                        "| `{}` | `{}` |",
                        markdown_escape(key),
                        markdown_escape(
                            &compact_json_value(value)
                        )
                    )
                    .expect("writing to String cannot fail");
                }
            }
        }

        if !self.findings.is_empty() {
            output.push_str("\n## Findings\n");

            for finding in &self.findings {
                writeln!(
                    &mut output,
                    "- **{}** `{}` — {}",
                    finding.severity.as_str(),
                    markdown_escape(&finding.code),
                    markdown_escape(&finding.message)
                )
                .expect("writing to String cannot fail");
            }
        }

        if !self.warnings.is_empty() {
            output.push_str("\n## Warnings\n");

            for warning in &self.warnings {
                writeln!(
                    &mut output,
                    "- {}",
                    markdown_escape(warning)
                )
                .expect("writing to String cannot fail");
            }
        }

        if !self.errors.is_empty() {
            output.push_str("\n## Errors\n");

            for error in &self.errors {
                writeln!(
                    &mut output,
                    "- {}",
                    markdown_escape(error)
                )
                .expect("writing to String cannot fail");
            }
        }

        validate_rendered_size(&output)?;
        Ok(output)
    }

    /// Returns a format-selected representation.
    pub fn render(
        &self,
        format: ReportFormat,
    ) -> Result<String, ReportError> {
        match format {
            ReportFormat::Json => self.to_json_pretty(),
            ReportFormat::Text => self.to_text(),
            ReportFormat::Markdown => self.to_markdown(),
        }
    }

    /// Returns the stable schema identifier.
    #[must_use]
    pub const fn schema_id() -> &'static str {
        BENCHMARK_REPORT_SCHEMA_ID
    }

    /// Returns the schema version.
    #[must_use]
    pub const fn schema_version() -> u16 {
        BENCHMARK_REPORT_SCHEMA_VERSION
    }

    // -------------------------------------------------------------------------
    // Internal standard sections
    // -------------------------------------------------------------------------

    fn populate_standard_sections(
        &mut self,
        source: &Map<String, Value>,
    ) -> Result<(), ReportError> {
        self.add_identity_section(source)?;
        self.add_execution_section(source)?;
        self.add_metrics_section(source)?;
        self.add_observations_section(source)?;
        self.add_provenance_section(source)?;
        Ok(())
    }

    fn add_identity_section(
        &mut self,
        source: &Map<String, Value>,
    ) -> Result<(), ReportError> {
        let mut section =
            ReportSection::new("identity", "Benchmark Identity")?;

        section.insert(
            "result_id",
            Value::String(self.result_id.clone()),
        )?;

        section.insert(
            "benchmark_id",
            Value::String(self.benchmark_id.clone()),
        )?;

        section.insert(
            "benchmark_version",
            Value::String(self.benchmark_version.clone()),
        )?;

        if let Some(value) = source.get("schema_version") {
            section.insert(
                "result_schema_version",
                value.clone(),
            )?;
        }

        self.add_section(section)
    }

    fn add_execution_section(
        &mut self,
        source: &Map<String, Value>,
    ) -> Result<(), ReportError> {
        let mut section =
            ReportSection::new("execution", "Execution")?;

        copy_if_present(
            source,
            &mut section,
            &[
                "execution_status",
                "benchmark_status",
                "validation_state",
                "started_at",
                "completed_at",
                "duration",
                "elapsed",
                "timeout",
                "cancelled",
            ],
        )?;

        self.add_section(section)
    }

    fn add_metrics_section(
        &mut self,
        source: &Map<String, Value>,
    ) -> Result<(), ReportError> {
        let mut section =
            ReportSection::new("metrics", "Metrics")?;

        if let Some(metrics) = source.get("metrics") {
            section.insert("metrics", metrics.clone())?;
        }

        if let Some(statistics) = source.get("statistics") {
            section.insert(
                "statistics",
                statistics.clone(),
            )?;
        }

        self.add_section(section)
    }

    fn add_observations_section(
        &mut self,
        source: &Map<String, Value>,
    ) -> Result<(), ReportError> {
        let mut section =
            ReportSection::new(
                "observations",
                "Observations",
            )?;

        if let Some(observations) = source.get("observations") {
            section.insert(
                "observations",
                observations.clone(),
            )?;
        }

        self.add_section(section)
    }

    fn add_provenance_section(
        &mut self,
        source: &Map<String, Value>,
    ) -> Result<(), ReportError> {
        let mut section =
            ReportSection::new(
                "provenance",
                "Provenance",
            )?;

        for key in [
            "provenance",
            "reproducibility",
            "backend",
            "compiler",
            "calibration",
            "configuration",
        ] {
            if let Some(value) = source.get(key) {
                section.insert(key, value.clone())?;
            }
        }

        self.add_section(section)
    }

    fn populate_status_findings(
        &mut self,
        source: &Map<String, Value>,
    ) -> Result<(), ReportError> {
        if let Some(status) = source
            .get("execution_status")
            .and_then(Value::as_str)
        {
            match status {
                "failed" | "cancelled" => {
                    self.add_finding(
                        ReportFinding::new(
                            ReportSeverity::Error,
                            "execution_not_successful",
                            format!(
                                "Benchmark execution status is `{}`.",
                                status
                            ),
                        )?,
                    )?;
                }

                "partially_completed" => {
                    self.add_finding(
                        ReportFinding::new(
                            ReportSeverity::Warning,
                            "execution_partial",
                            "Benchmark execution completed only partially.",
                        )?,
                    )?;
                }

                "running" => {
                    self.add_finding(
                        ReportFinding::new(
                            ReportSeverity::Warning,
                            "execution_incomplete",
                            "Benchmark execution is represented as running or intermediate.",
                        )?,
                    )?;
                }

                _ => {}
            }
        }

        if let Some(status) = source
            .get("benchmark_status")
            .and_then(Value::as_str)
        {
            match status {
                "failed" => {
                    self.add_finding(
                        ReportFinding::new(
                            ReportSeverity::Warning,
                            "benchmark_acceptance_failed",
                            "The benchmark executed but did not satisfy its scientific acceptance criterion.",
                        )?,
                    )?;
                }

                "inconclusive" => {
                    self.add_finding(
                        ReportFinding::new(
                            ReportSeverity::Warning,
                            "benchmark_inconclusive",
                            "The benchmark does not contain a decisive scientific conclusion.",
                        )?,
                    )?;
                }

                "not_applicable" => {
                    self.add_finding(
                        ReportFinding::new(
                            ReportSeverity::Info,
                            "benchmark_not_applicable",
                            "The benchmark is explicitly marked not applicable.",
                        )?,
                    )?;
                }

                _ => {}
            }
        }

        Ok(())
    }
}

