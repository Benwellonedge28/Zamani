// Tests
// =============================================================================

#[cfg(test)]
mod tests {
    use super::*;

    fn synthetic_result_json() -> Value {
        serde_json::json!({
            "schema_version": 1,
            "result_id": "test-result-001",
            "benchmark_identity": {
                "benchmark_id": "quantum_volume",
                "benchmark_version": "1.0"
            },
            "execution_status": "completed",
            "benchmark_status": "passed",
            "validation_state": "valid",
            "metrics": [
                {
                    "kind": "fidelity",
                    "value": 0.99
                }
            ],
            "observations": [],
            "provenance": {
                "seed": 42
            },
            "reproducibility": {
                "deterministic": true
            }
        })
    }

    #[test]
    fn report_schema_is_stable() {
        assert_eq!(
            BenchmarkReport::schema_id(),
            BENCHMARK_REPORT_SCHEMA_ID
        );

        assert_eq!(
            BenchmarkReport::schema_version(),
            BENCHMARK_REPORT_SCHEMA_VERSION
        );
    }

    #[test]
    fn section_rejects_empty_identifier() {
        let result = ReportSection::new("", "Metrics");

        assert!(result.is_err());
    }

    #[test]
    fn section_rejects_empty_title() {
        let result = ReportSection::new("metrics", "");

        assert!(result.is_err());
    }

    #[test]
    fn report_from_serialized_result_is_deterministic() {
        let first =
            BenchmarkReport::from_serialized_result(
                synthetic_result_json(),
            )
            .expect("synthetic result should produce report");

        let second =
            BenchmarkReport::from_serialized_result(
                synthetic_result_json(),
            )
            .expect("synthetic result should produce report");

        assert_eq!(first, second);
    }

    #[test]
    fn report_contains_standard_sections() {
        let report =
            BenchmarkReport::from_serialized_result(
                synthetic_result_json(),
            )
            .expect("synthetic result should produce report");

        assert_eq!(report.section_count(), 5);

        assert!(
            report
                .sections
                .iter()
                .any(|section| section.id == "identity")
        );

        assert!(
            report
                .sections
                .iter()
                .any(|section| section.id == "execution")
        );

        assert!(
            report
                .sections
                .iter()
                .any(|section| section.id == "metrics")
        );

        assert!(
            report
                .sections
                .iter()
                .any(|section| section.id == "observations")
        );

        assert!(
            report
                .sections
                .iter()
                .any(|section| section.id == "provenance")
        );
    }

    #[test]
    fn json_output_is_valid_json() {
        let report =
            BenchmarkReport::from_serialized_result(
                synthetic_result_json(),
            )
            .expect("synthetic result should produce report");

        let json = report
            .to_json()
            .expect("report should serialize");

        let parsed: Value =
            serde_json::from_str(&json)
                .expect("report JSON must be valid");

        assert!(parsed.is_object());
    }

    #[test]
    fn pretty_json_output_is_valid_json() {
        let report =
            BenchmarkReport::from_serialized_result(
                synthetic_result_json(),
            )
            .expect("synthetic result should produce report");

        let json = report
            .to_json_pretty()
            .expect("report should serialize");

        let parsed: Value =
            serde_json::from_str(&json)
                .expect("report JSON must be valid");

        assert!(parsed.is_object());
    }

    #[test]
    fn text_output_contains_identity() {
        let report =
            BenchmarkReport::from_serialized_result(
                synthetic_result_json(),
            )
            .expect("synthetic result should produce report");

        let text =
            report.to_text().expect("text rendering must succeed");

        assert!(text.contains("quantum_volume"));
        assert!(text.contains("test-result-001"));
    }

    #[test]
    fn markdown_output_contains_identity() {
        let report =
            BenchmarkReport::from_serialized_result(
                synthetic_result_json(),
            )
            .expect("synthetic result should produce report");

        let markdown = report
            .to_markdown()
            .expect("markdown rendering must succeed");

        assert!(markdown.contains("# Zamani Quantum Benchmark"));
        assert!(markdown.contains("quantum_volume"));
    }

    #[test]
    fn failed_benchmark_is_reported_without_being_execution_failure() {
        let mut value = synthetic_result_json();

        value["benchmark_status"] =
            Value::String("failed".to_owned());

        value["execution_status"] =
            Value::String("completed".to_owned());

        let report =
            BenchmarkReport::from_serialized_result(value)
                .expect("failed benchmark remains reportable");

        assert!(
            report.findings.iter().any(|finding| {
                finding.code == "benchmark_acceptance_failed"
            })
        );

        assert!(!report.has_errors());
    }

    #[test]
    fn partial_execution_is_reported_as_warning() {
        let mut value = synthetic_result_json();

        value["execution_status"] =
            Value::String("partially_completed".to_owned());

        let report =
            BenchmarkReport::from_serialized_result(value)
                .expect("partial result remains reportable");

        assert!(
            report.findings.iter().any(|finding| {
                finding.code == "execution_partial"
            })
        );

        assert!(report.has_warnings());
    }

    #[test]
    fn markdown_escapes_table_sensitive_characters() {
        let escaped = markdown_escape("a|b`c");

        assert_eq!(escaped, "a\\|b\\`c");
    }

    #[test]
    fn duplicate_sections_are_rejected() {
        let mut report =
            BenchmarkReport::from_serialized_result(
                synthetic_result_json(),
            )
            .expect("synthetic result should produce report");

        let section =
            ReportSection::new("identity", "Duplicate")
                .expect("section itself is valid");

        assert!(report.add_section(section).is_err());
    }

    #[test]
    fn oversized_metadata_is_rejected() {
        let mut report =
            BenchmarkReport::from_serialized_result(
                synthetic_result_json(),
            )
            .expect("synthetic result should produce report");

        let huge =
            "x".repeat(MAX_REPORT_METADATA_VALUE_LENGTH + 1);

        assert!(
            report
                .insert_metadata(
                    "huge",
                    Value::String(huge)
                )
                .is_err()
        );
    }

    #[test]
    fn builder_produces_valid_report() {
        let report =
            BenchmarkReport::from_serialized_result(
                synthetic_result_json(),
            )
            .expect("synthetic result should produce report");

        let report = BenchmarkReportBuilder {
            report,
        }
        .title("Custom Quantum Report")
        .expect("title should work")
        .description("Production benchmark report")
        .expect("description should work")
        .metadata(
            "environment",
            Value::String("test".to_owned()),
        )
        .expect("metadata should work")
        .build()
        .expect("builder should produce valid report");

        assert_eq!(report.title, "Custom Quantum Report");
        assert_eq!(
            report.metadata.get("environment"),
            Some(&Value::String("test".to_owned()))
        );
    }
}