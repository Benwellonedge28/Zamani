/// Stable identifier for the canonical benchmark-report schema.
pub const BENCHMARK_REPORT_SCHEMA_ID: &str =
    "zamani.quantum.benchmark.report";

/// Current canonical benchmark-report schema version.
///
/// Increment this when the serialized meaning of `BenchmarkReport` changes
/// incompatibly.
pub const BENCHMARK_REPORT_SCHEMA_VERSION: u16 = 1;

/// Maximum report title length in bytes.
pub const MAX_REPORT_TITLE_LENGTH: usize = 512;

/// Maximum report description length in bytes.
pub const MAX_REPORT_DESCRIPTION_LENGTH: usize = 32 * 1024;

/// Maximum number of sections in a report.
pub const MAX_REPORT_SECTIONS: usize = 4_096;

/// Maximum section identifier length.
pub const MAX_SECTION_ID_LENGTH: usize = 256;

/// Maximum section title length.
pub const MAX_SECTION_TITLE_LENGTH: usize = 512;

/// Maximum section body length.
pub const MAX_SECTION_BODY_LENGTH: usize = 1 * 1024 * 1024;

/// Maximum number of findings in a report.
pub const MAX_REPORT_FINDINGS: usize = 4_096;

/// Maximum finding code length.
pub const MAX_FINDING_CODE_LENGTH: usize = 256;

/// Maximum finding message length.
pub const MAX_FINDING_MESSAGE_LENGTH: usize = 16 * 1024;

/// Maximum number of report warnings.
pub const MAX_REPORT_WARNINGS: usize = 4_096;

/// Maximum number of report errors.
pub const MAX_REPORT_ERRORS: usize = 4_096;

/// Maximum message length.
pub const MAX_REPORT_MESSAGE_LENGTH: usize = 16 * 1024;

/// Maximum number of report metadata fields.
pub const MAX_REPORT_METADATA_FIELDS: usize = 512;

/// Maximum metadata key length.
pub const MAX_REPORT_METADATA_KEY_LENGTH: usize = 256;

/// Maximum metadata value length when represented as a string.
pub const MAX_REPORT_METADATA_VALUE_LENGTH: usize = 16 * 1024;

/// Maximum generated report output size.
pub const MAX_RENDERED_REPORT_SIZE: usize = 8 * 1024 * 1024;

