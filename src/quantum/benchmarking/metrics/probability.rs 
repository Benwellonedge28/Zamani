    fn distribution_to_counts_handles_fractional_remainders() {
        let distribution =
            ProbabilityDistribution::new(vec![
                1.0 / 3.0,
                1.0 / 3.0,
                1.0 / 3.0,
            ])
            .expect("valid distribution");

        let counts =
            distribution_to_counts(&distribution, 10)
                .expect("valid reconstruction");

        assert_eq!(counts.iter().sum::<u64>(), 10);

        /*
         * The largest-remainder method gives the extra sample to the first
         * outcome when all fractional remainders are tied.
         */
        assert_eq!(counts, vec![4, 3, 3]);
    }

