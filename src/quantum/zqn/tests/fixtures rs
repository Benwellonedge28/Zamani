/// Deterministic shot identity.
///
/// A shot is not a random number. It is an explicit execution identity used
/// by deterministic tests.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, PartialOrd, Ord)]
pub struct FixtureShotId(usize);

impl FixtureShotId {
    /// Creates a shot identity.
    #[must_use]
    pub const fn new(index: usize) -> Self {
        Self(index)
    }

    /// Returns the shot index.
    #[must_use]
    pub const fn index(self) -> usize {
        self.0
    }
}

/// Deterministically derives a shot seed.
///
/// This makes the result independent of worker/thread scheduling.
#[must_use]
pub const fn shot_seed(seed: FixtureSeed, shot: FixtureShotId) -> FixtureSeed {
    seed.child(shot.index() as u64)
}

