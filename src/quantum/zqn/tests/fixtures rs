/// Generic physical-parameter fixture.
///
/// These values are intentionally not tied to a particular technology.
#[derive(Debug, Clone, Copy, PartialEq)]
pub struct NoiseParameterFixture {
    /// Representative gate-error probability.
    pub gate_error: f64,

    /// Representative preparation-error probability.
    pub preparation_error: f64,

    /// Representative readout-error probability.
    pub readout_error: f64,

    /// Representative leakage probability.
    pub leakage: f64,

    /// Representative loss probability.
    pub loss: f64,

    /// Representative correlation strength.
    pub correlation: f64,

    /// Representative drift rate.
    pub drift_rate: f64,

    /// Representative characteristic time in arbitrary test units.
    pub coherence_time: f64,
}

impl NoiseParameterFixture {
    /// Creates a conservative, technology-neutral parameter set.
    #[must_use]
    pub const fn canonical() -> Self {
        Self {
            gate_error: 0.001,
            preparation_error: 0.002,
            readout_error: 0.01,
            leakage: 0.0001,
            loss: 0.0005,
            correlation: 0.05,
            drift_rate: 0.000001,
            coherence_time: 1.0,
        }
    }

    /// Returns all probability-like parameters.
    #[must_use]
    pub const fn probability_values(self) -> [f64; 6] {
        [
            self.gate_error,
            self.preparation_error,
            self.readout_error,
            self.leakage,
            self.loss,
            self.correlation,
        ]
    }

    /// Validates the fixture.
    pub fn validate(self) -> Result<(), FixtureError> {
        for value in self.probability_values() {
            if !value.is_finite() {
                return Err(FixtureError::NonFiniteProbability { value });
            }

            if !(0.0..=1.0).contains(&value) {
                return Err(FixtureError::ProbabilityOutOfRange { value });
            }
        }

        if !self.drift_rate.is_finite() || self.drift_rate < 0.0 {
            return Err(FixtureError::InvalidNonNegativeParameter {
                name: "drift_rate",
                value: self.drift_rate,
            });
        }

        if !self.coherence_time.is_finite() || self.coherence_time < 0.0 {
            return Err(FixtureError::InvalidNonNegativeParameter {
                name: "coherence_time",
                value: self.coherence_time,
            });
        }

        Ok(())
    }
}

impl Default for NoiseParameterFixture {
    fn default() -> Self {
        Self::canonical()
    }
}

