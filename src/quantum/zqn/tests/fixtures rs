/// Errors produced while constructing invalid test fixtures.
#[derive(Debug, Clone, Copy, PartialEq)]
pub enum FixtureError {
    /// A probability-like value was NaN or infinite.
    NonFiniteProbability {
        /// Invalid value.
        value: f64,
    },

    /// A probability-like value was outside `[0, 1]`.
    ProbabilityOutOfRange {
        /// Invalid value.
        value: f64,
    },

    /// A non-negative parameter was invalid.
    InvalidNonNegativeParameter {
        /// Parameter name.
        name: &'static str,

        /// Invalid value.
        value: f64,
    },

    /// A calibration parameter was invalid.
    InvalidCalibrationParameter {
        /// Parameter name.
        name: &'static str,

        /// Invalid value.
        value: f64,
    },

    /// A calibration interval was malformed.
    InvalidCalibrationInterval {
        /// Interval start.
        start: u64,

        /// Interval end.
        end: u64,
    },

    /// A fixture's internal fields disagree.
    InconsistentFixture {
        /// Field whose invariant failed.
        field: &'static str,
    },

    /// A partition endpoint is invalid.
    InvalidPartition {
        /// Partition start.
        start: usize,

        /// Partition end.
        end: usize,
    },

    /// Zero partitions were requested.
    ZeroPartitions,
}

impl fmt::Display for FixtureError {
    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            Self::NonFiniteProbability { value } => {
                write!(formatter, "fixture value is not finite: {value}")
            }

            Self::ProbabilityOutOfRange { value } => {
                write!(formatter, "fixture probability is outside [0, 1]: {value}")
            }

            Self::InvalidNonNegativeParameter { name, value } => {
                write!(
                    formatter,
                    "fixture parameter `{name}` must be finite and non-negative: {value}"
                )
            }

            Self::InvalidCalibrationParameter { name, value } => {
                write!(
                    formatter,
                    "invalid calibration parameter `{name}`: {value}"
                )
            }

            Self::InvalidCalibrationInterval { start, end } => {
                write!(
                    formatter,
                    "invalid calibration interval: start={start}, end={end}"
                )
            }

            Self::InconsistentFixture { field } => {
                write!(formatter, "inconsistent fixture field: {field}")
            }

            Self::InvalidPartition { start, end } => {
                write!(
                    formatter,
                    "invalid fixture partition: start={start}, end={end}"
                )
            }

            Self::ZeroPartitions => {
                formatter.write_str("fixture partition count must be greater than zero")
            }
        }
    }
}

impl std::error::Error for FixtureError {}

