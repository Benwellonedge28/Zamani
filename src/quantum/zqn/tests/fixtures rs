/// A logical/physical quantum-resource pair used by ZQN tests.
///
/// The two identities deliberately remain different types.
///
/// This structure does NOT claim that the logical qubit is actually mapped to
/// the physical qubit on hardware. It is only a deterministic test fixture
/// representing a possible mapping pair.
///
/// Routing owns actual placement semantics.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct QuantumResourceFixture {
    logical: QubitId,
    physical: PhysicalQubitId,
}

impl QuantumResourceFixture {
    /// Creates a resource fixture from canonical IR identities.
    #[must_use]
    pub const fn new(logical: QubitId, physical: PhysicalQubitId) -> Self {
        Self { logical, physical }
    }

    /// Creates the deterministic identity-aligned fixture for an index.
    ///
    /// This is useful for tests that do not need a non-trivial routing map.
    #[must_use]
    pub const fn indexed(index: usize) -> Self {
        Self {
            logical: QubitId::new(index),
            physical: PhysicalQubitId::new(index),
        }
    }

    /// Returns the canonical logical-qubit identity.
    #[must_use]
    pub const fn logical(self) -> QubitId {
        self.logical
    }

    /// Returns the canonical physical-qubit identity.
    #[must_use]
    pub const fn physical(self) -> PhysicalQubitId {
        self.physical
    }
}

// ============================================================================
// Lazy resource fixture plan
// ============================================================================

/// Lazily generated deterministic quantum-resource fixtures.
///
/// The plan itself contains only a seed and a requested scale. It does not
/// allocate a vector containing every resource.
///
/// This is important for scaling tests.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct ResourceFixturePlan {
    scale: FixtureScale,
    seed: FixtureSeed,
}

impl ResourceFixturePlan {
    /// Creates a lazy resource fixture plan.
    #[must_use]
    pub const fn new(scale: FixtureScale, seed: FixtureSeed) -> Self {
        Self { scale, seed }
    }

    /// Returns the requested scale.
    #[must_use]
    pub const fn scale(self) -> FixtureScale {
        self.scale
    }

    /// Returns the fixture seed.
    #[must_use]
    pub const fn seed(self) -> FixtureSeed {
        self.seed
    }

    /// Returns the number of resources that will be generated.
    #[must_use]
    pub const fn len(self) -> usize {
        self.scale.resource_count()
    }

    /// Returns whether the plan is empty.
    #[must_use]
    pub const fn is_empty(self) -> bool {
        self.len() == 0
    }

    /// Returns a lazy iterator.
    #[must_use]
    pub fn iter(self) -> ResourceFixtureIter {
        ResourceFixtureIter {
            plan: self,
            next: 0,
        }
    }
}

impl Default for ResourceFixturePlan {
    fn default() -> Self {
        Self::new(FixtureScale::small(), FixtureSeed::default())
    }
}

/// Lazy resource fixture iterator.
#[derive(Debug, Clone, Copy)]
pub struct ResourceFixtureIter {
    plan: ResourceFixturePlan,
    next: usize,
}

impl Iterator for ResourceFixtureIter {
    type Item = QuantumResourceFixture;

    fn next(&mut self) -> Option<Self::Item> {
        if self.next >= self.plan.len() {
            return None;
        }

        let index = self.next;
        self.next = self.next.saturating_add(1);

        Some(QuantumResourceFixture::indexed(index))
    }

    fn size_hint(&self) -> (usize, Option<usize>) {
        let remaining = self.plan.len().saturating_sub(self.next);
        (remaining, Some(remaining))
    }
}

impl ExactSizeIterator for ResourceFixtureIter {}

impl std::iter::FusedIterator for ResourceFixtureIter {}

