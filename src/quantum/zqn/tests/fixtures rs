// ============================================================================
// Fixture seed
// ============================================================================

/// Explicit deterministic seed used by fixtures.
///
/// This is NOT an RNG and does not maintain mutable state.
///
/// It exists so tests can describe deterministic fixture families without
/// relying on process-global randomness.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, PartialOrd, Ord)]
pub struct FixtureSeed(u64);

impl FixtureSeed {
    /// Creates a deterministic fixture seed.
    #[must_use]
    pub const fn new(value: u64) -> Self {
        Self(value)
    }

    /// Returns the raw seed value.
    #[must_use]
    pub const fn value(self) -> u64 {
        self.0
    }

    /// Derives a deterministic child value for an index.
    ///
    /// This is deliberately a pure integer mixing function rather than an RNG.
    ///
    /// It is suitable for:
    ///
    /// - deterministic fixture identities;
    /// - deterministic fixture parameters;
    /// - partition-independent test data.
    ///
    /// It is NOT intended to be a cryptographic hash or a scientific-quality
    /// random-number generator.
    #[must_use]
    pub const fn derive(self, index: u64) -> u64 {
        split_mix64(self.0 ^ index)
    }

    /// Derives a deterministic child seed.
    #[must_use]
    pub const fn child(self, index: u64) -> Self {
        Self::new(self.derive(index))
    }
}

impl Default for FixtureSeed {
    fn default() -> Self {
        Self::new(0x5A4E_515F_4649_5854)
    }
}

impl fmt::Display for FixtureSeed {
    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(formatter, "0x{:016x}", self.0)
    }
}

/// Pure deterministic integer mixer.
///
/// This function intentionally has no mutable state.
const fn split_mix64(mut value: u64) -> u64 {
    value = value.wrapping_add(0x9E37_79B9_7F4A_7C15);
    value = (value ^ (value >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
    value = (value ^ (value >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
    value ^ (value >> 31)
}

// ============================================================================
// Fixture scale
