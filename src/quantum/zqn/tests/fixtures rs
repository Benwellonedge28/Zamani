/// Requested fixture scale.
///
/// This is a request, not a semantic hardware limit.
///
/// No maximum quantum-machine size is encoded here.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct FixtureScale {
    resource_count: usize,
    shot_count: usize,
}

impl FixtureScale {
    /// Creates a fixture scale.
    ///
    /// Zero resources are permitted because zero-sized cases are useful for
    /// validation, empty-stream, serialization, and boundary tests.
    #[must_use]
    pub const fn new(resource_count: usize, shot_count: usize) -> Self {
        Self {
            resource_count,
            shot_count,
        }
    }

    /// Smallest useful non-empty fixture.
    #[must_use]
    pub const fn minimal() -> Self {
        Self::new(1, 1)
    }

    /// Small deterministic smoke-test fixture.
    #[must_use]
    pub const fn small() -> Self {
        Self::new(4, 8)
    }

    /// Medium deterministic fixture.
    ///
    /// This is a test convenience, not an architectural limit.
    #[must_use]
    pub const fn medium() -> Self {
        Self::new(16, 64)
    }

    /// Returns the requested resource count.
    #[must_use]
    pub const fn resource_count(self) -> usize {
        self.resource_count
    }

    /// Returns the requested shot count.
    #[must_use]
    pub const fn shot_count(self) -> usize {
        self.shot_count
    }

    /// Returns whether this fixture has no resources.
    #[must_use]
    pub const fn is_empty(self) -> bool {
        self.resource_count == 0
    }

    /// Returns a copy with a different resource count.
    #[must_use]
    pub const fn with_resource_count(self, resource_count: usize) -> Self {
        Self {
            resource_count,
            shot_count: self.shot_count,
        }
    }

    /// Returns a copy with a different shot count.
    #[must_use]
    pub const fn with_shot_count(self, shot_count: usize) -> Self {
        Self {
            resource_count: self.resource_count,
            shot_count,
        }
    }
}

impl Default for FixtureScale {
    fn default() -> Self {
        Self::small()
    }
}

