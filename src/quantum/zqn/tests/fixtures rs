// Probability fixture
// ============================================================================

/// Validated-independent numeric parameters commonly needed by ZQN tests.
///
/// These values intentionally remain plain `f64` because this fixture layer
/// must not duplicate the semantics of `zqn::probability::Probability`.
///
/// Concrete tests should convert these values through the authoritative
/// `Probability` constructor.
#[derive(Debug, Clone, Copy, PartialEq)]
pub struct ProbabilityFixture {
    /// Zero.
    pub zero: f64,

    /// One.
    pub one: f64,

    /// A small non-zero probability.
    pub small: f64,

    /// A medium probability.
    pub medium: f64,

    /// A large but valid probability.
    pub large: f64,

    /// A valid probability near one.
    pub near_one: f64,
}

impl ProbabilityFixture {
    /// Creates the canonical probability fixture.
    #[must_use]
    pub const fn canonical() -> Self {
        Self {
            zero: 0.0,
            one: 1.0,
            small: 0.001,
            medium: 0.05,
            large: 0.25,
            near_one: 0.999,
        }
    }

    /// Returns all fixture probabilities in deterministic order.
    #[must_use]
    pub const fn values(self) -> [f64; 6] {
        [
            self.zero,
            self.one,
            self.small,
            self.medium,
            self.large,
            self.near_one,
        ]
    }

    /// Validates that every fixture value belongs to `[0, 1]` and is finite.
    pub fn validate(self) -> Result<(), FixtureError> {
        for value in self.values() {
            if !value.is_finite() {
                return Err(FixtureError::NonFiniteProbability { value });
            }

            if !(0.0..=1.0).contains(&value) {
                return Err(FixtureError::ProbabilityOutOfRange { value });
            }
        }

        Ok(())
    }
}

impl Default for ProbabilityFixture {
    fn default() -> Self {
        Self::canonical()
    }
}

