/// Compile-time helper proving that fixtures use the canonical IR qubit
/// identity types.
///
/// This function intentionally performs no runtime work.
#[allow(dead_code)]
fn canonical_qubit_identity_contract() {
    fn accept_logical(_: QubitId) {}
    fn accept_physical(_: PhysicalQubitId) {}

    let logical = QubitId::new(0);
    let physical = PhysicalQubitId::new(0);

    accept_logical(logical);
    accept_physical(physical);
}

