            coherence_time: 1.0,
            valid_from: 0,
            valid_until: Some(1_000),
        }
    }

    /// Validates the fixture.
    pub fn validate(self) -> Result<(), FixtureError> {
        for (name, value) in [
            ("gate_error", self.gate_error),
            ("readout_error", self.readout_error),
        ] {
            if !value.is_finite() || !(0.0..=1.0).contains(&value) {
                return Err(FixtureError::InvalidCalibrationParameter {
                    name,
                    value,
                });
            }
        }

        if !self.coherence_time.is_finite() || self.coherence_time < 0.0 {
            return Err(FixtureError::InvalidCalibrationParameter {
                name: "coherence_time",
                value: self.coherence_time,
            });
        }

        if let Some(end) = self.valid_until {
            if end < self.valid_from {
                return Err(FixtureError::InvalidCalibrationInterval {
                    start: self.valid_from,
                    end,
                });
            }
        }

        Ok(())
    }
}

