/// Describes a deterministic partition of a fixture.
///
/// This allows distributed tests to process a fixture without requiring every
/// worker to materialize the complete fixture.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct FixturePartition {
    start: usize,
    end: usize,
}

impl FixturePartition {
    /// Creates a partition `[start, end)`.
    ///
    /// An empty partition is valid when `start == end`.
    pub const fn new(start: usize, end: usize) -> Result<Self, FixtureError> {
        if end < start {
            return Err(FixtureError::InvalidPartition { start, end });
        }

        Ok(Self { start, end })
    }

    /// Returns the inclusive start/exclusive end range.
    #[must_use]
    pub const fn range(self) -> std::ops::Range<usize> {
        self.start..self.end
    }

    /// Returns the number of entries in the partition.
    #[must_use]
    pub const fn len(self) -> usize {
        self.end.saturating_sub(self.start)
    }

    /// Returns whether the partition is empty.
    #[must_use]
    pub const fn is_empty(self) -> bool {
        self.start == self.end
    }
}

/// Produces deterministic contiguous partitions for a requested resource
/// count.
///
/// `partitions == 0` is rejected because there is no meaningful partitioning
/// into zero workers.
///
/// The number of partitions may be larger than the resource count. Empty
/// partitions are therefore possible and deterministic.
pub fn partition_resource_count(
    resource_count: usize,
    partitions: usize,
) -> Result<Vec<FixturePartition>, FixtureError> {
    if partitions == 0 {
        return Err(FixtureError::ZeroPartitions);
    }

    let mut result = Vec::with_capacity(partitions);

    let base = resource_count / partitions;
    let remainder = resource_count % partitions;

    let mut start = 0usize;

    for index in 0..partitions {
        let extra = usize::from(index < remainder);
        let size = base.saturating_add(extra);
        let end = start.saturating_add(size);

        result.push(FixturePartition::new(start, end)?);
        start = end;
    }

    debug_assert_eq!(start, resource_count);

    Ok(result)
}

