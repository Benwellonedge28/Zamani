/// Deterministic correlation fixture.
///
/// This is deliberately a description rather than a concrete correlation
/// implementation.
#[derive(Debug, Clone, Copy, PartialEq)]
pub struct CorrelationFixture {
    /// Stable correlation identity.
    pub id: CorrelationId,

    /// Number of participating resources.
    pub resource_count: usize,

    /// Correlation strength.
    pub strength: f64,

    /// Whether the fixture describes spatial correlation.
    pub spatial: bool,

    /// Whether the fixture describes temporal correlation.
    pub temporal: bool,
}

impl CorrelationFixture {
    /// Creates a validated correlation fixture.
    pub fn new(
        id: CorrelationId,
        resource_count: usize,
        strength: f64,
        spatial: bool,
        temporal: bool,
    ) -> Result<Self, FixtureError> {
        if !strength.is_finite() {
            return Err(FixtureError::NonFiniteProbability { value: strength });
        }

        if !(0.0..=1.0).contains(&strength) {
            return Err(FixtureError::ProbabilityOutOfRange { value: strength });
        }

        Ok(Self {
            id,
            resource_count,
            strength,
            spatial,
            temporal,
        })
    }
}

