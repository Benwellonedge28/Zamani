/// Stable cross-subsystem fixture description.
///
/// This is the primary fixture object for integration tests.
///
/// It intentionally contains only semantic test data and identifiers. Concrete
/// ZQN modules remain responsible for constructing their own domain objects.
#[derive(Debug, Clone, PartialEq)]
pub struct ZqnFixture {
    /// Fixture purpose.
    pub kind: FixtureKind,

    /// Deterministic fixture seed.
    pub seed: FixtureSeed,

    /// Requested scale.
    pub scale: FixtureScale,

    /// ZQN object identities.
    pub identities: ZqnIdentityFixture,

    /// Standard probability values.
    pub probabilities: ProbabilityFixture,

    /// Standard physical/noise parameters.
    pub parameters: NoiseParameterFixture,

    /// Standard calibration values.
    pub calibration: CalibrationFixture,

    /// Standard correlation description.
    pub correlation: CorrelationFixture,
}

impl ZqnFixture {
    /// Creates the canonical small fixture.
    pub fn canonical() -> Result<Self, FixtureError> {
        Self::new(
            FixtureKind::Minimal,
            FixtureScale::small(),
            FixtureSeed::default(),
        )
    }

    /// Creates a fixture with explicit kind, scale and seed.
    pub fn new(
        kind: FixtureKind,
        scale: FixtureScale,
        seed: FixtureSeed,
    ) -> Result<Self, FixtureError> {
        let identities = ZqnIdentityFixture::from_base(seed.derive(1));

        let probabilities = ProbabilityFixture::canonical();
        probabilities.validate()?;

        let parameters = NoiseParameterFixture::canonical();
        parameters.validate()?;

        let calibration = CalibrationFixture::canonical(identities.calibration());
        calibration.validate()?;

        let correlation = CorrelationFixture::new(
            identities.correlation(),
            scale.resource_count(),
            parameters.correlation,
            true,
            true,
        )?;

        Ok(Self {
            kind,
            seed,
            scale,
            identities,
            probabilities,
            parameters,
            calibration,
            correlation,
        })
    }

    /// Returns a fixture plan for lazy resource iteration.
    #[must_use]
    pub const fn resources(&self) -> ResourceFixturePlan {
        ResourceFixturePlan::new(self.scale, self.seed)
    }

    /// Returns the number of resources represented by this fixture.
    #[must_use]
    pub const fn resource_count(&self) -> usize {
        self.scale.resource_count()
    }

    /// Returns the requested shot count.
    #[must_use]
    pub const fn shot_count(&self) -> usize {
        self.scale.shot_count()
    }

    /// Returns the canonical deterministic resource at an index.
    ///
    /// Returns `None` when the index is outside the requested fixture scale.
    #[must_use]
    pub const fn resource_at(&self, index: usize) -> Option<QuantumResourceFixture> {
        if index >= self.scale.resource_count() {
            None
        } else {
            Some(QuantumResourceFixture::indexed(index))
        }
    }

    /// Validates the complete fixture.
    pub fn validate(&self) -> Result<(), FixtureError> {
        self.probabilities.validate()?;
        self.parameters.validate()?;
        self.calibration.validate()?;

        if self.correlation.resource_count != self.resource_count() {
            return Err(FixtureError::InconsistentFixture {
                field: "correlation.resource_count",
            });
        }

        Ok(())
    }
}

