/// Creates an `ImportInput` satisfying the generic source-map invariant.
///
/// The bytes supplied to the importer and the source registered in the
/// `SourceMap` are deliberately identical.
fn make_input(source: &str) -> ImportInput {
    let bytes = source.as_bytes().to_vec();

    let mut source_map = SourceMap::new();

    let source_id = source_map
        .add(
            Arc::<str>::from("roundtrip.qasm"),
            Arc::<str>::from(source),
        )
        .expect("round-trip fixture must fit SourceMap");

    ImportInput::new(
        source_id,
        bytes,
        source_map,
        ImportConfig::new(
            FrontendLimits::production(),
        ),
    )
    .expect("round-trip fixture must satisfy ImportInput invariants")
}

/// Imports OpenQASM through the public importer boundary.
fn import_qasm(
    source: &str,
) -> QuantumCircuit {
    let importer = OpenQasmImporter::production();

    let output = importer
        .import(make_input(source))
        .expect("round-trip fixture must import successfully");

    output
        .circuit()
        .clone()
}

/// Imports with a caller-specified source name.
///
/// This is used when testing that source identity does not affect semantic
/// output.
fn import_qasm_named(
    name: &str,
    source: &str,
) -> QuantumCircuit {
    let bytes = source.as_bytes().to_vec();

    let mut source_map = SourceMap::new();

    let source_id = source_map
        .add(
            Arc::<str>::from(name),
            Arc::<str>::from(source),
        )
        .expect("round-trip fixture must fit SourceMap");

    let input = ImportInput::new(
        source_id,
        bytes,
        source_map,
        ImportConfig::new(
            FrontendLimits::production(),
        ),
    )
    .expect("round-trip fixture must satisfy ImportInput invariants");

    OpenQasmImporter::production()
        .import(input)
        .expect("round-trip fixture must import successfully")
        .circuit()
        .clone()
}

/// Exports canonical IR using the public generic exporter boundary.
fn export_qasm(
    circuit: &QuantumCircuit,
    options: &ExportOptions,
) -> String {
    let exporter = OpenQasmExporter::production()
        .expect("production OpenQASM exporter must construct");

    exporter
        .export(circuit, options)
        .expect("canonical round-trip circuit must export")
        .as_text()
        .expect("OpenQASM output must be UTF-8")
        .to_owned()
}

/// Exports using an explicit OpenQASM 3.0 exporter.
fn export_qasm_30(
    circuit: &QuantumCircuit,
    options: &ExportOptions,
) -> String {
    let exporter = OpenQasmExporter::new(
        OPENQASM_3_0,
    )
    .expect("OpenQASM 3.0 exporter must construct");

    exporter
        .export(circuit, options)
        .expect("canonical circuit must export as OpenQASM 3.0")
        .as_text()
        .expect("OpenQASM output must be UTF-8")
        .to_owned()
}

/// Imports, exports, then imports again.
///
/// This is the primary semantic round-trip helper.
fn round_trip(
    source: &str,
) -> (
    QuantumCircuit,
    String,
    QuantumCircuit,
) {
    let first = import_qasm(source);

    let exported = export_qasm(
        &first,
        &ExportOptions::default(),
    );

    let second = import_qasm(
        &exported,
    );

    (
        first,
        exported,
        second,
    )
}

/// Performs two complete import/export cycles.
///
/// The second exported representation must be byte-for-byte identical to the
/// first canonical representation. This establishes the serializer fixed
/// point for supported canonical IR.
fn double_round_trip(
    source: &str,
) -> (
    QuantumCircuit,
    String,
    QuantumCircuit,
    String,
    QuantumCircuit,
) {
    let first = import_qasm(source);

    let first_export = export_qasm(
        &first,
        &ExportOptions::default(),
    );

    let second = import_qasm(
        &first_export,
    );

    let second_export = export_qasm(
        &second,
        &ExportOptions::default(),
    );

    let third = import_qasm(
        &second_export,
    );

    (
        first,
        first_export,
        second,
        second_export,
        third,
    )
}


