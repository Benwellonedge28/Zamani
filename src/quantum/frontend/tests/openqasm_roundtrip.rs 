#[test]
fn basic_single_qubit_round_trip_preserves_canonical_semantics() {
    let (
        first,
        exported,
        second,
    ) = round_trip(
        qasm_single_qubit(),
    );

    assert!(
        first.validate().is_ok(),
        "first canonical circuit must validate",
    );

    assert!(
        second.validate().is_ok(),
        "second canonical circuit must validate",
    );

    assert!(
        !exported.is_empty(),
        "successful canonical export must not be empty",
    );

    assert_eq!(
        export_qasm(
            &first,
            &ExportOptions::default(),
        ),
        export_qasm(
            &second,
            &ExportOptions::default(),
        ),
        "canonical export must be identical after import/export/import",
    );
}

#[test]
fn two_qubit_entangling_round_trip_is_stable() {
    let (
        first,
        exported,
        second,
    ) = round_trip(
        qasm_two_qubit_entanglement(),
    );

    assert!(
        first.validate().is_ok(),
    );

    assert!(
        second.validate().is_ok(),
    );

    assert!(
        exported.contains("cx"),
        "controlled-X operation must survive export",
    );

    assert!(
        exported.contains("measure"),
        "measurements must survive export",
    );

    let first_canonical = export_qasm(
        &first,
        &ExportOptions::default(),
    );

    let second_canonical = export_qasm(
        &second,
        &ExportOptions::default(),
    );

    assert_eq!(
        first_canonical,
        second_canonical,
        "two-qubit semantic content must survive round-trip",
    );
}

