    );

    assert!(
        first.validate().is_ok(),
        "IR₁ must validate",
    );

    assert!(
        !first_export.is_empty(),
        "export₁ must not be empty",
    );

    assert!(
        second.validate().is_ok(),
        "IR₂ must validate",
    );

    assert!(
        !second_export.is_empty(),
        "export₂ must not be empty",
    );

    assert!(
        third.validate().is_ok(),
        "IR₃ must validate",
    );

    assert_eq!(
        first_export,
        second_export,
        "all canonical serialization must stabilize",
    );
}


