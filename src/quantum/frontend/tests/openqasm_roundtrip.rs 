#[test]
fn openqasm_30_round_trip_is_explicit() {
    let circuit = import_qasm(
        qasm_30(),
    );

    assert!(
        circuit.validate().is_ok(),
    );

    let options = ExportOptions::default()
        .with_requested_version(
            OPENQASM_3_0,
        );

    let exported = export_qasm_30(
        &circuit,
        &options,
    );

    assert!(
        exported.starts_with(
            "OPENQASM 3.0;\n",
        ),
        "explicit OpenQASM 3.0 export must contain a 3.0 header",
    );

    let reparsed = import_qasm(
        &exported,
    );

    assert!(
        reparsed.validate().is_ok(),
        "exported OpenQASM 3.0 must remain importable",
    );

    assert_eq!(
        export_qasm_30(
            &reparsed,
            &options,
        ),
        exported,
        "OpenQASM 3.0 serialization must reach a fixed point",
    );
}

