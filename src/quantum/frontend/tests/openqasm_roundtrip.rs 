#[test]
fn round_trip_is_repeatable_across_multiple_cycles() {
    let mut source = qasm_two_qubit_entanglement()
        .to_owned();

    for cycle in 0..5 {
        let circuit = import_qasm(
            &source,
        );

        assert!(
            circuit.validate().is_ok(),
            "canonical IR must validate at cycle {cycle}",
        );

        source = export_qasm(
            &circuit,
            &ExportOptions::default(),
        );

        assert!(
            !source.is_empty(),
            "canonical OpenQASM must not become empty at cycle {cycle}",
        );
    }

    let final_circuit = import_qasm(
        &source,
    );

    assert!(
        final_circuit.validate().is_ok(),
        "final canonical IR must validate after repeated cycles",
    );

    let final_export = export_qasm(
        &final_circuit,
        &ExportOptions::default(),
    );

    assert_eq!(
        source,
        final_export,
        "after reaching canonical form, repeated cycles must remain byte-stable",
    );
}

