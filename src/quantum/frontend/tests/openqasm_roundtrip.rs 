        ),
        "production default OpenQASM target must be explicit",
    );

    assert!(
        first_export.len()
            <= options.max_output_bytes(),
        "export must obey the configured output bound",
    );

    let second = import_qasm(
        &first_export,
    );

    assert!(
        second.validate().is_ok(),
        "re-imported canonical IR must validate",
    );

    let second_export = export_qasm(
        &second,
        &options,
    );

    assert_eq!(
        first_export,
