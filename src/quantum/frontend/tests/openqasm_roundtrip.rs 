#[test]
fn arbitrary_include_does_not_become_implicit_filesystem_access() {
    let result = catch_unwind(
        AssertUnwindSafe(|| {
            let importer = OpenQasmImporter::production();

            importer.import(
                make_input(
                    qasm_arbitrary_include(),
                ),
            )
        }),
    );

    assert!(
        result.is_ok(),
        "arbitrary include input must never panic",
    );

    let result = result
        .expect("catch_unwind returned successfully");

    /*
     * The exact policy may be rejection or controlled resolution. What is
     * forbidden is successful import that implicitly reads an arbitrary
     * filesystem path.
     *
     * Therefore this test accepts only:
     *
     *   Err(...)
     *
     * or a successful result whose canonical export proves the include did not
     * cause arbitrary external source execution.
     */
    match result {
        Err(_) => {}

        Ok(output) => {
            let exported = export_qasm(
                output.circuit(),
                &ExportOptions::default(),
            );

            assert!(
                !exported.contains(
                    "../secret.qasm",
                ),
                "arbitrary include path must never be silently preserved as an executed dependency",
            );
        }
    }
}


