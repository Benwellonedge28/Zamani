#[test]
fn canonical_export_reaches_a_fixed_point_after_one_round_trip() {
    let (
        _first,
        first_export,
        _second,
        second_export,
        _third,
    ) = double_round_trip(
        qasm_two_qubit_entanglement(),
    );

    assert_eq!(
        first_export,
        second_export,
        "canonical OpenQASM serialization must reach a byte-for-byte fixed point",
    );
}

#[test]
fn repeated_exports_are_byte_for_byte_identical() {
    let circuit = import_qasm(
        qasm_two_qubit_entanglement(),
    );

    let options = ExportOptions::default();

    let first = export_qasm(
        &circuit,
        &options,
    );

    let second = export_qasm(
        &circuit,
        &options,
    );

    let third = export_qasm(
        &circuit,
        &options,
    );

    assert_eq!(
        first,
        second,
        "first and second exports differ",
    );

    assert_eq!(
        second,
        third,
        "second and third exports differ",
    );
}

#[test]
fn repeated_imports_are_semantically_deterministic() {
    let first = import_qasm(
        qasm_two_qubit_entanglement(),
    );

    let second = import_qasm(
        qasm_two_qubit_entanglement(),
    );

    let first_export = export_qasm(
        &first,
        &ExportOptions::default(),
    );

    let second_export = export_qasm(
        &second,
        &ExportOptions::default(),
    );

    assert_eq!(
        first_export,
        second_export,
        "same source must lower to deterministically equivalent canonical IR",
    );
}

#[test]
fn source_file_name_does_not_change_quantum_semantics() {
    let first = import_qasm_named(
