#[test]
fn round_trip_export_respects_explicit_output_bound() {
    let circuit = import_qasm(
        qasm_two_qubit_entanglement(),
    );

    let normal_options = ExportOptions::default();

    let normal = export_qasm(
        &circuit,
        &normal_options,
    );

    assert!(
        !normal.is_empty(),
    );

    /*
     * The generic exporter must reject an output limit smaller than the actual
     * serialized representation instead of truncating the artifact.
     */
    let options = ExportOptions::default()
        .with_max_output_bytes(
            normal.len().saturating_sub(1),
        );

    let exporter = OpenQasmExporter::production()
        .expect("production exporter must construct");

    let result = exporter.export(
        &circuit,
        &options,
    );

    assert!(
        result.is_err(),
        "export must reject an artifact exceeding the caller's bound",
    );
}

