/// Basic one-qubit circuit.
fn qasm_single_qubit() -> &'static str {
    r#"OPENQASM 3.1;

qubit[1] q;

h q[0];
x q[0];
z q[0];
"#
}

/// Basic two-qubit entangling circuit.
fn qasm_two_qubit_entanglement() -> &'static str {
    r#"OPENQASM 3.1;
include "stdgates.inc";

qubit[2] q;
bit[2] c;

h q[0];
cx q[0], q[1];
measure q[0] -> c[0];
measure q[1] -> c[1];
"#
}

/// Parameterized rotation circuit.
///
/// The expression forms used here remain within the portion of the canonical
/// IR that can be represented by the current OpenQASM exporter.
fn qasm_parameterized() -> &'static str {
    r#"OPENQASM 3.1;
include "stdgates.inc";

qubit[2] q;

rx(pi / 2) q[0];
ry(pi / 4) q[1];
rz(pi / 8) q[0];
cx q[0], q[1];
"#
}

/// Circuit containing reset.
fn qasm_reset() -> &'static str {
    r#"OPENQASM 3.1;

qubit[2] q;

h q[0];
cx q[0], q[1];
reset q[0];
x q[1];
"#
}

/// Circuit containing barrier.
fn qasm_barrier() -> &'static str {
    r#"OPENQASM 3.1;

qubit[2] q;

h q[0];
barrier q;
cx q[0], q[1];
"#
}

/// Circuit containing multiple quantum and classical namespaces.
fn qasm_multiple_registers() -> &'static str {
    r#"OPENQASM 3.1;
include "stdgates.inc";

qubit[2] q;
qubit[1] ancilla;

bit[2] result;
bit[1] flag;

h q[0];
cx q[0], q[1];
measure q[0] -> result[0];
measure ancilla[0] -> flag[0];
"#
}

/// OpenQASM 3.0 compatibility fixture.
fn qasm_30() -> &'static str {
    r#"OPENQASM 3.0;
include "stdgates.inc";

qubit[1] q;
bit[1] c;

h q[0];
measure q[0] -> c[0];
"#
}

/// Source that intentionally has harmless formatting differences.
///
/// Semantic equivalence is tested through canonical IR and canonical export,
/// not through source-text equality.
fn qasm_same_semantics_different_formatting() -> &'static str {
    r#"OPENQASM 3.1;
include "stdgates.inc";
qubit[2] q;
bit[2] c;
h q[0];
cx q[0],q[1];
measure q[0]->c[0];
measure q[1]->c[1];
"#
}

/// A syntactically malformed program used to prove that the round-trip
/// boundary does not panic on invalid source.
fn qasm_malformed() -> &'static str {
    r#"OPENQASM 3.1;
qubit[2] q;
h q[0]
cx q[0], q[1];
"#
}

/// A valid source containing an include which is not the controlled standard
/// library include.
///
/// The test must prove that arbitrary include names are not interpreted as
/// filesystem permissions.
fn qasm_arbitrary_include() -> &'static str {
    r#"OPENQASM 3.1;
include "../secret.qasm";

qubit[1] q;
h q[0];
"#
}


