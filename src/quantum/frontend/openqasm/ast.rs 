/// An OpenQASM statement.
///
/// This is deliberately OpenQASM-specific and must not be reused as a
/// generic quantum IR operation enum.
#[derive(Debug, Clone, PartialEq)]
pub enum Statement {
    /// `include "file";`
    Include(IncludeStatement),

    /// `defcalgrammar "name";`
    CalibrationGrammar(CalibrationGrammarStatement),

    /// `pragma ...`
    Pragma(PragmaStatement),

    /// `@annotation ...`
    Annotated(AnnotatedStatement),

    /// Classical declaration.
    ClassicalDeclaration(ClassicalDeclaration),

    /// Constant declaration.
    ConstDeclaration(ConstDeclaration),

    /// Quantum declaration.
    QuantumDeclaration(QuantumDeclaration),

    /// Legacy OpenQASM 2-style `qreg`/`creg` declaration.
    OldStyleDeclaration(OldStyleDeclaration),

    /// Alias declaration.
    AliasDeclaration(AliasDeclaration),

    /// Input/output declaration.
    IoDeclaration(IoDeclaration),

    /// User-defined gate.
    GateDefinition(GateDefinition),

    /// User-defined subroutine.
    DefDefinition(DefDefinition),

    /// External function declaration.
    ExternDeclaration(ExternDeclaration),

    /// Gate invocation.
    GateCall(GateCall),

    /// Assignment.
    Assignment(AssignmentStatement),

    /// Expression used as a statement.
    Expression(ExpressionStatement),

    /// Measurement assignment using `->`.
    MeasureAssignment(MeasureAssignmentStatement),

    /// Reset operation.
    Reset(ResetStatement),

    /// Barrier operation.
    Barrier(BarrierStatement),

    /// Delay operation.
    Delay(DelayStatement),

    /// Boxed instruction block.
    Box(BoxStatement),

    /// `if` / `else`.
    If(IfStatement),

    /// `for`.
    For(ForStatement),

    /// `while`.
    While(WhileStatement),

    /// `switch`.
    Switch(SwitchStatement),

    /// `break`.
    Break(ControlStatement),

    /// `continue`.
    Continue(ControlStatement),

    /// `end`.
    End(ControlStatement),

    /// `return`.
    Return(ReturnStatement),

    /// Inline calibration block.
    Cal(CalStatement),

    /// Calibration definition.
    Defcal(DefcalStatement),

    /// Explicit no-op where supported by the grammar/version.
    Nop(ControlStatement),

    /// Future/extension statement preserved by a parser implementation.
    ///
    /// This is intentionally not interpreted by the generic frontend.
    Extension(ExtensionStatement),
}

impl Statement {
    /// Returns the source span of the statement.
    #[must_use]
    pub const fn span(&self) -> SourceSpan {
        match self {
            Self::Include(value) => value.span(),
            Self::CalibrationGrammar(value) => value.span(),
            Self::Pragma(value) => value.span(),
            Self::Annotated(value) => value.span(),
            Self::ClassicalDeclaration(value) => value.span(),
            Self::ConstDeclaration(value) => value.span(),
            Self::QuantumDeclaration(value) => value.span(),
            Self::OldStyleDeclaration(value) => value.span(),
            Self::AliasDeclaration(value) => value.span(),
            Self::IoDeclaration(value) => value.span(),
            Self::GateDefinition(value) => value.span(),
            Self::DefDefinition(value) => value.span(),
            Self::ExternDeclaration(value) => value.span(),
            Self::GateCall(value) => value.span(),
            Self::Assignment(value) => value.span(),
            Self::Expression(value) => value.span(),
            Self::MeasureAssignment(value) => value.span(),
            Self::Reset(value) => value.span(),
            Self::Barrier(value) => value.span(),
            Self::Delay(value) => value.span(),
            Self::Box(value) => value.span(),
            Self::If(value) => value.span(),
            Self::For(value) => value.span(),
            Self::While(value) => value.span(),
            Self::Switch(value) => value.span(),
            Self::Break(value)
            | Self::Continue(value)
            | Self::End(value)
            | Self::Nop(value) => value.span(),
            Self::Return(value) => value.span(),
            Self::Cal(value) => value.span(),
            Self::Defcal(value) => value.span(),
            Self::Extension(value) => value.span(),
        }
    }
}

