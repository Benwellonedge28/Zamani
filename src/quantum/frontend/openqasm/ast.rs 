#[cfg(test)]
mod tests {
    use super::*;

    fn span() -> SourceSpan {
        SourceSpan::new(SourceId::from_raw(0), 0, 1)
            .expect("test span must be ordered")
    }

    fn identifier(name: &str) -> Identifier {
        Identifier::new(
            span(),
            name.to_owned(),
        )
        .expect("non-empty identifier")
    }

    #[test]
    fn version_is_preserved_exactly() {
        let version =
            VersionDeclaration::new(span(), 3, 1);

        assert_eq!(version.major(), 3);
        assert_eq!(version.minor(), 1);
        assert_eq!(version.to_string(), "3.1");
    }

    #[test]
    fn identifiers_are_not_restricted_to_ascii() {
        let value = Identifier::new(
            span(),
            "α_qubit".to_owned(),
        )
        .expect("identifier should be stored");

        assert_eq!(value.as_str(), "α_qubit");
    }

    #[test]
    fn empty_identifier_is_rejected() {
        assert!(
            Identifier::new(
                span(),
                String::new(),
            )
            .is_none()
        );
    }

    #[test]
    fn parameterized_gate_preserves_expression_structure() {
        let expression =
            Expression::Binary {
                node: AstNode::new(span()),
                left: Box::new(
                    Expression::Identifier(
                        identifier("theta"),
                    ),
                ),
                operator: BinaryOperator::Add,
                right: Box::new(
                    Expression::FloatLiteral {
                        node: AstNode::new(span()),
                        value: FloatLiteral::new(
                            "0.5".to_owned(),
                        ),
                    },
                ),
            };

        let call = GateCall::new(
            span(),
            Vec::new(),
            identifier("rx"),
            vec![expression],
            vec![
                GateOperand::Designator(
                    Designator::new(
                        span(),
                        identifier("q"),
                        Some(
                            IndexExpression::Index(
                                Expression::IntegerLiteral {
                                    node: AstNode::new(span()),
                                    value: IntegerLiteral::new(
                                        "0".to_owned(),
                                        IntegerRadix::Decimal,
                                    ),
                                },
                            ),
                        ),
                    ),
                ),
            ],
        );

        assert_eq!(call.parameters().len(), 1);
        assert_eq!(call.operands().len(), 1);
    }

    #[test]
    fn register_operands_are_not_collapsed_to_indices() {
        let operand =
            GateOperand::Designator(
                Designator::new(
                    span(),
                    identifier("q"),
                    None,
                ),
            );

        match operand {
            GateOperand::Designator(value) => {
                assert_eq!(value.name().as_str(), "q");
                assert!(value.index().is_none());
            }

            _ => panic!("expected designator"),
        }
    }

    #[test]
    fn physical_qubit_is_distinct_from_logical_designator() {
        let physical =
            PhysicalQubit::new(span(), 17);

        assert_eq!(physical.index(), 17);
    }

    #[test]
    fn statement_depth_is_deterministic() {
        let inner =
            Statement::Break(
                ControlStatement::new(span()),
            );

        let condition =
            Expression::BoolLiteral {
                node: AstNode::new(span()),
                value: true,
            };

        let statement =
            Statement::If(
                IfStatement::new(
                    span(),
                    condition,
                    StatementOrScope::Statement(
                        Box::new(inner),
                    ),
                    None,
                ),
            );

        let program =
            Program::new(
                span(),
                None,
                vec![statement],
            );

        assert_eq!(
            statement_nesting_depth(&program),
            2
        );
    }

    #[test]
    fn calibration_blocks_remain_opaque() {
        let block =
            CalibrationBlock::new(
                span(),
                "play(frame, waveform);".to_owned(),
            );

        assert_eq!(
            block.text(),
            "play(frame, waveform);"
        );
    }

    #[test]
    fn expression_span_is_preserved() {
        let expression =
            Expression::BoolLiteral {
                node: AstNode::new(span()),
                value: true,
            };

        assert_eq!(
            expression.span(),
            span()
        );
    }
}