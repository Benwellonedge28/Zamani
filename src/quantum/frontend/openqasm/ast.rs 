/// User-defined gate definition.
///
/// OpenQASM gate bodies are intentionally represented as statements rather
/// than canonical IR operations because gate definitions are source-language
/// constructs and may require semantic expansion before lowering.
#[derive(Debug, Clone, PartialEq)]
pub struct GateDefinition {
    node: AstNode,
    name: Identifier,
    parameters: Vec<Identifier>,
    qubits: Vec<Identifier>,
    body: Vec<Statement>,
}

impl GateDefinition {
    /// Creates a gate definition.
    #[must_use]
    pub fn new(
        span: SourceSpan,
        name: Identifier,
        parameters: Vec<Identifier>,
        qubits: Vec<Identifier>,
        body: Vec<Statement>,
    ) -> Self {
        Self {
            node: AstNode::new(span),
            name,
            parameters,
            qubits,
            body,
