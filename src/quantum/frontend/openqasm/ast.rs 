// =============================================================================
// AST utilities
// =============================================================================

/// Returns the source ID associated with an AST node span.
///
/// This small helper is useful to parser/validator code when grouping
/// diagnostics by source document.
#[must_use]
pub const fn source_id(span: SourceSpan) -> SourceId {
    span.source_id()
}

/// Returns the maximum nesting depth of a program's syntactic statement tree.
///
/// This is intentionally an AST utility rather than a replacement for
/// `FrontendLimits::max_nesting_depth`. Parsers must enforce the limit while
/// constructing the tree so hostile input cannot force an unbounded recursive
/// AST before this function is called.
#[must_use]
pub fn statement_nesting_depth(program: &Program) -> usize {
    program
        .statements()
        .iter()
        .map(statement_depth)
        .max()
        .unwrap_or(0)
}

fn statement_depth(statement: &Statement) -> usize {
    match statement {
        Statement::If(value) => {
            1 + body_depth(value.then_body())
                .max(
                    value
                        .else_body()
                        .map(body_depth)
                        .unwrap_or(0),
                )
        }

        Statement::For(value) => {
            1 + body_depth(value.body())
        }

        Statement::While(value) => {
            1 + body_depth(value.body())
        }

        Statement::Switch(value) => {
            1 + value
                .cases()
                .iter()
                .map(|case| match case {
                    SwitchCase::Case { body, .. }
                    | SwitchCase::Default { body } => body
                        .iter()
                        .map(statement_depth)
                        .max()
                        .unwrap_or(0),
                })
                .max()
                .unwrap_or(0)
        }

        Statement::Box(value) => {
            1 + value
                .body()
                .iter()
                .map(statement_depth)
                .max()
                .unwrap_or(0)
        }

        Statement::GateDefinition(value) => {
            1 + value
                .body()
                .iter()
                .map(statement_depth)
                .max()
                .unwrap_or(0)
        }

        Statement::DefDefinition(value) => {
            1 + value
                .body()
                .statements()
                .iter()
                .map(statement_depth)
                .max()
                .unwrap_or(0)
        }

        Statement::Annotated(value) => {
            1 + statement_depth(value.statement())
        }

        _ => 1,
    }
}

fn body_depth(body: &StatementOrScope) -> usize {
    match body {
        StatementOrScope::Statement(statement) => {
            statement_depth(statement)
        }

        StatementOrScope::Scope(scope) => scope
            .statements()
            .iter()
            .map(statement_depth)
            .max()
            .unwrap_or(0),
    }
}

