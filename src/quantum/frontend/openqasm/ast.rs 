// =============================================================================
// Basic AST node support
// =============================================================================

/// Common source-location information carried by an AST node.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct AstNode {
    span: SourceSpan,
}

impl AstNode {
    /// Creates a node with the supplied source span.
    #[must_use]
    pub const fn new(span: SourceSpan) -> Self {
        Self { span }
    }

    /// Returns the source span.
    #[must_use]
    pub const fn span(&self) -> SourceSpan {
        self.span
    }
}

// =============================================================================
// Program and version
// =============================================================================

/// Complete OpenQASM source program.
#[derive(Debug, Clone, PartialEq)]
pub struct Program {
    node: AstNode,
    version: Option<VersionDeclaration>,
    statements: Vec<Statement>,
}

impl Program {
    /// Creates an OpenQASM program.
    ///
    /// The parser is responsible for enforcing the OpenQASM requirement that
    /// a version declaration, when present, occurs before other statements.
    pub fn new(
        span: SourceSpan,
        version: Option<VersionDeclaration>,
        statements: Vec<Statement>,
    ) -> Self {
        Self {
            node: AstNode::new(span),
            version,
            statements,
        }
    }

    /// Returns the complete program span.
    #[must_use]
    pub const fn span(&self) -> SourceSpan {
        self.node.span()
    }

    /// Returns the optional language version declaration.
    #[must_use]
    pub const fn version(&self) -> Option<&VersionDeclaration> {
        self.version.as_ref()
    }

    /// Returns program statements in source order.
    #[must_use]
    pub fn statements(&self) -> &[Statement] {
        &self.statements
    }

    /// Returns the statements mutably for parser construction.
    ///
    /// This is intentionally not exposed through the public frontend API.
    #[must_use]
    pub(crate) fn statements_mut(&mut self) -> &mut Vec<Statement> {
        &mut self.statements
    }
}

/// OpenQASM version declaration.
///
/// The AST preserves the numeric version rather than restricting the AST to
/// only versions currently understood by Zamani. Version support is decided
/// by semantic validation.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, PartialOrd, Ord)]
pub struct VersionDeclaration {
    node: AstNode,
    major: u16,
    minor: u16,
}

impl VersionDeclaration {
    /// Creates a version declaration.
    #[must_use]
    pub const fn new(
        span: SourceSpan,
        major: u16,
        minor: u16,
    ) -> Self {
        Self {
            node: AstNode::new(span),
            major,
            minor,
        }
    }

    /// Returns the source span.
    #[must_use]
    pub const fn span(&self) -> SourceSpan {
        self.node.span()
    }

    /// Returns the major version.
    #[must_use]
    pub const fn major(&self) -> u16 {
        self.major
    }

    /// Returns the minor version.
    #[must_use]
    pub const fn minor(&self) -> u16 {
        self.minor
    }
}

impl fmt::Display for VersionDeclaration {
    fn fmt(
        &self,
        formatter: &mut fmt::Formatter<'_>,
    ) -> fmt::Result {
        write!(
            formatter,
            "{}.{}",
            self.major,
            self.minor
        )
    }
}

// =============================================================================
// Statements
