/// OpenQASM expression.
///
/// Expressions remain symbolic. They are never converted to `f64` by the AST.
#[derive(Debug, Clone, PartialEq)]
pub enum Expression {
    /// Boolean literal.
    BoolLiteral {
        node: AstNode,
        value: bool,
    },

    /// Integer literal.
    IntegerLiteral {
        node: AstNode,
        value: IntegerLiteral,
    },

    /// Floating-point literal.
    FloatLiteral {
        node: AstNode,
        value: FloatLiteral,
    },

    /// Duration literal.
    DurationLiteral {
        node: AstNode,
        value: DurationLiteral,
    },

    /// Identifier reference.
    Identifier(Identifier),

    /// Array/bit/register designator.
    Designator(Designator),

    /// Unary operation.
    Unary {
        node: AstNode,
        operator: UnaryOperator,
        operand: Box<Expression>,
    },

    /// Binary operation.
    Binary {
        node: AstNode,
        left: Box<Expression>,
        operator: BinaryOperator,
        right: Box<Expression>,
    },

    /// Function call.
    FunctionCall {
        node: AstNode,
        name: Identifier,
        arguments: Vec<Expression>,
    },

    /// Cast.
    Cast {
        node: AstNode,
        target: ScalarType,
        operand: Box<Expression>,
    },

    /// Measurement.
    Measure(MeasureExpression),

    /// Quantum call.
    QuantumCall(QuantumCallExpression),

    /// Array/list literal.
    ArrayLiteral {
        node: AstNode,
        values: Vec<Expression>,
    },

    /// Set expression.
    SetLiteral {
        node: AstNode,
        values: Vec<Expression>,
    },

    /// Range expression.
    Range {
        node: AstNode,
        start: Option<Box<Expression>>,
        step: Option<Box<Expression>>,
        stop: Option<Box<Expression>>,
    },

    /// Concatenation.
    Concatenation {
        node: AstNode,
        values: Vec<Expression>,
    },

    /// Parenthesized expression.
    Parenthesized {
        node: AstNode,
        expression: Box<Expression>,
    },

    /// `sizeof`/built-in size operation.
    SizeOf {
        node: AstNode,
        operand: Designator,
    },

    /// OpenQASM built-in `durationof`.
    DurationOf {
        node: AstNode,
        body: Vec<Statement>,
    },

    /// Future/implementation-defined expression retained without
    /// interpretation.
    Extension {
        node: AstNode,
        name: Identifier,
        arguments: Vec<Expression>,
    },
}

impl Expression {
    /// Returns this expression's source span.
    #[must_use]
    pub const fn span(&self) -> SourceSpan {
        match self {
            Self::BoolLiteral { node, .. }
            | Self::IntegerLiteral { node, .. }
            | Self::FloatLiteral { node, .. }
            | Self::DurationLiteral { node, .. }
            | Self::Unary { node, .. }
            | Self::Binary { node, .. }
            | Self::FunctionCall { node, .. }
            | Self::Cast { node, .. }
            | Self::ArrayLiteral { node, .. }
            | Self::SetLiteral { node, .. }
            | Self::Range { node, .. }
            | Self::Concatenation { node, .. }
            | Self::Parenthesized { node, .. }
            | Self::SizeOf { node, .. }
            | Self::DurationOf { node, .. }
            | Self::Extension { node, .. } => node.span(),

            Self::Identifier(value) => value.span(),
            Self::Designator(value) => value.span(),
            Self::Measure(value) => value.span(),
            Self::QuantumCall(value) => value.span(),
        }
    }
}

/// Unary expression operator.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub enum UnaryOperator {
    /// `+`.
    Plus,

    /// `-`.
    Minus,

    /// `!`.
    LogicalNot,

