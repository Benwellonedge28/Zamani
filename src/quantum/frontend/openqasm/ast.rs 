// =============================================================================
// Identifiers
// =============================================================================

/// An OpenQASM identifier.
///
/// The lexer is responsible for enforcing the lexical identifier grammar.
/// This type therefore stores the identifier without imposing an ASCII-only
/// restriction.
#[derive(Debug, Clone, PartialEq, Eq, Hash, PartialOrd, Ord)]
pub struct Identifier {
    node: AstNode,
    name: String,
}

impl Identifier {
    /// Creates an identifier.
    ///
    /// Lexical validity is checked by the lexer/parser. This constructor only
    /// rejects an empty identifier because an empty name cannot be represented
    /// as an OpenQASM identifier.
    pub fn new(
        span: SourceSpan,
        name: String,
    ) -> Option<Self> {
        if name.is_empty() {
            return None;
        }

        Some(Self {
            node: AstNode::new(span),
            name,
        })
    }

    /// Returns the span.
    #[must_use]
    pub const fn span(&self) -> SourceSpan {
        self.node.span()
    }

    /// Returns the identifier text.
    #[must_use]
    pub fn as_str(&self) -> &str {
        &self.name
    }

    /// Consumes the identifier and returns its text.
    #[must_use]
    pub fn into_string(self) -> String {
        self.name
    }
}

impl fmt::Display for Identifier {
    fn fmt(
        &self,
        formatter: &mut fmt::Formatter<'_>,
    ) -> fmt::Result {
        formatter.write_str(&self.name)
    }
}

