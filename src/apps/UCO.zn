        Document,
        Book,
        Article,
        Report,
        Journal,
        News,
        WebPage(crate::stdlib::web::HtmlContent),
        MultiModalPackage,
    }
    #[derive(Debug, Clone, PartialEq)]
    pub struct GeneratedDocument {
