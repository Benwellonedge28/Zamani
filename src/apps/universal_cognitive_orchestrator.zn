// Dummy is_blocked for EvasDecision - and get_reason
extension nimbus.os.EvasDecision {
    fn is_blocked(&self) -> bool {
        match self {
            nimbus.os.EvasDecision::Block(_) => true,
            _ => false,
        }
    }
    fn get_reason(&self) -> String {
        match self {
            nimbus.os.EvasDecision::Block(reason) => reason.to_string(),
            nimbus.os.EvasDecision::HumanReviewRequired(reason) => reason.to_string(),
            nimbus.os.EvasDecision::Warn(reason) => reason.to_string(),
            _ => "".to_string(),
        }
    }
}

