/// Trusted metadata against which an artifact is verified.
///
/// This structure must be populated from an authoritative source,
/// such as a validated compiler artifact manifest or an authenticated
/// distribution record.
///
/// It must NOT be populated merely by copying values from the
/// artifact being verified.
///
/// This module deliberately does not duplicate the canonical
/// backend manifest representation.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct IntegrityExpectation {
    artifact_id: String,
    target: String,
    format: String,
    size_bytes: u64,
    sha256_digest: String,
}

impl IntegrityExpectation {
    /// Constructs an integrity expectation.
    ///
    /// The expected digest must use the canonical representation:
    ///
    /// sha256:<64 lowercase hexadecimal characters>
    ///
    /// The expected values must originate from a trusted manifest
    /// or another authenticated integrity authority.
    pub fn new(
        artifact_id: impl Into<String>,
        target: impl Into<String>,
        format: impl Into<String>,
        size_bytes: u64,
        sha256_digest: impl Into<String>,
    ) -> ZurResult<Self> {
        let artifact_id = artifact_id.into();
        let target = target.into();
        let format = format.into();
        let sha256_digest = sha256_digest.into();

        validate_identifier(
            &artifact_id,
            "expected artifact identity",
        )?;

        validate_identifier(
            &target,
            "expected artifact target",
        )?;

        validate_identifier(
            &format,
            "expected artifact format",
        )?;

        validate_sha256(&sha256_digest)?;

        Ok(Self {
            artifact_id,
            target,
            format,
            size_bytes,
            sha256_digest,
        })
    }

    /// Returns the expected artifact identity.
    #[must_use]
    pub fn artifact_id(&self) -> &str {
        &self.artifact_id
    }

    /// Returns the expected target identity.
    #[must_use]
    pub fn target(&self) -> &str {
        &self.target
    }

    /// Returns the expected artifact format.
    #[must_use]
    pub fn format(&self) -> &str {
        &self.format
    }

    /// Returns the expected payload size.
    #[must_use]
    pub const fn size_bytes(&self) -> u64 {
        self.size_bytes
    }

    /// Returns the trusted expected SHA-256 digest.
    #[must_use]
    pub fn sha256_digest(&self) -> &str {
        &self.sha256_digest
    }
}

// ============================================================================
// SHA-256 VALIDATION
// ============================================================================

fn validate_sha256(
    digest: &str,
) -> ZurResult<()> {
    let Some(hex_digest) = digest.strip_prefix("sha256:") else {
        return Err(integrity_error(
            "expected digest must use the sha256 algorithm",
        ));
    };

    if hex_digest.len() != 64 {
        return Err(integrity_error(
            "SHA-256 digest must contain exactly 64 hexadecimal characters",
        ));
    }

    if !hex_digest
        .bytes()
        .all(|byte| byte.is_ascii_hexdigit())
    {
        return Err(integrity_error(
            "SHA-256 digest contains invalid hexadecimal characters",
        ));
    }

    if hex_digest.bytes().any(|byte| byte.is_ascii_uppercase()) {
        return Err(integrity_error(
            "SHA-256 digest must use canonical lowercase hexadecimal",
        ));
    }

    Ok(())
}

/// Computes SHA-256 over the exact payload bytes.
///
/// The result is compatible with the canonical backend artifact
/// digest representation.
#[must_use]
pub fn calculate_sha256(
    payload: &[u8],
) -> String {
    let digest = Sha256::digest(payload);

    format!(
        "sha256:{}",
        hex::encode(digest),
    )
}

