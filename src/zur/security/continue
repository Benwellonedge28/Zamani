// SIGNATURE CONTRACT
// ============================================================================

/// A digital signature associated with one artifact.
///
/// The algorithm identifier is extensible at the wider security
/// architecture level. This implementation currently supports
/// Ed25519 verification.
///
/// Unsupported algorithms are rejected rather than silently
/// interpreted as another algorithm.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct ArtifactSignature {
    key_identity: String,
    algorithm: String,
    signature: Vec<u8>,
}

impl ArtifactSignature {
    /// Constructs an artifact signature.
    pub fn new(
        key_identity: impl Into<String>,
        algorithm: impl Into<String>,
        signature: impl Into<Vec<u8>>,
    ) -> ZurResult<Self> {
        let key_identity = key_identity.into();
        let algorithm = algorithm.into();
        let signature = signature.into();

        validate_identifier(
            &key_identity,
            "signing key identity",
        )?;

        validate_identifier(
            &algorithm,
            "signature algorithm",
        )?;

        if algorithm != "ed25519" {
            return Err(ZurError::unsupported(
                format!(
                    "unsupported artifact signature algorithm: {algorithm}"
                ),
            )
            .with_component(COMPONENT)
            .with_operation("construct_signature"));
        }

        // Ed25519 signatures have a defined encoding length.
        // This is a cryptographic format requirement, not a
        // hardware or scalability ceiling.
        if signature.len() != 64 {
            return Err(signature_error(
                "Ed25519 signature must contain exactly 64 bytes",
            ));
        }

        Ok(Self {
            key_identity,
            algorithm,
            signature,
        })
    }

    /// Returns the signing key identity.
    #[must_use]
    pub fn key_identity(&self) -> &str {
        &self.key_identity
    }

    /// Returns the signature algorithm.
    #[must_use]
    pub fn algorithm(&self) -> &str {
        &self.algorithm
    }

    /// Returns the signature bytes.
    #[must_use]
    pub fn signature_bytes(&self) -> &[u8] {
        &self.signature
    }
}

