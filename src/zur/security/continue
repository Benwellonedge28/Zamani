/// Operational policy governing artifact-integrity verification.
///
/// Security policy is separate from semantic requirements,
/// capabilities, preferences and execution constraints.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct IntegrityPolicy {
    identity: String,
    require_signature: bool,
    require_provenance: bool,
}

impl IntegrityPolicy {
    /// Constructs an explicit integrity policy.
    ///
    /// Production execution should normally require a signature.
    pub fn new(
        identity: impl Into<String>,
        require_signature: bool,
        require_provenance: bool,
    ) -> ZurResult<Self> {
        let identity = identity.into();

        validate_identifier(
            &identity,
            "integrity policy identity",
        )?;

        Ok(Self {
            identity,
            require_signature,
            require_provenance,
        })
    }

    /// Returns the policy identity.
    #[must_use]
    pub fn identity(&self) -> &str {
        &self.identity
    }

    /// Whether a valid digital signature is mandatory.
    #[must_use]
    pub const fn requires_signature(&self) -> bool {
        self.require_signature
    }

    /// Whether nonempty, structurally valid provenance is mandatory.
    #[must_use]
    pub const fn requires_provenance(&self) -> bool {
        self.require_provenance
    }
}

impl Default for IntegrityPolicy {
    fn default() -> Self {
        Self {
            identity: "zamani.security.integrity.default".to_owned(),
            require_signature: true,
            require_provenance: false,
        }
    }
}

// ============================================================================
// SIGNATURE MESSAGE ENCODING
// ============================================================================

/// Appends a length-prefixed field to a canonical signed message.
///
/// Length-prefixing prevents ambiguous concatenation of metadata fields.
///
/// The representation is deterministic and independent of the
/// computational domain.
fn append_field(
    output: &mut Vec<u8>,
    value: &[u8],
) -> ZurResult<()> {
    let length = u64::try_from(value.len())
        .map_err(|_| {
            integrity_error(
                "signed metadata field cannot be represented by the signature format",
            )
        })?;

    output.extend_from_slice(&length.to_be_bytes());
    output.extend_from_slice(value);

    Ok(())
}

/// Produces the canonical message bound by an artifact signature.
///
/// The signed statement includes:
///
/// - Domain-separation identifier.
/// - Artifact identity.
/// - Target identity.
/// - Format identity.
/// - Payload size.
/// - Exact SHA-256 digest.
/// - Provenance fields.
///
/// A signature cannot therefore be reused for another artifact
/// merely because its payload happens to be identical.
fn signature_message(
    artifact: &OutputArtifact,
    expectation: &IntegrityExpectation,
) -> ZurResult<Vec<u8>> {
    let mut message = Vec::new();

    append_field(
        &mut message,
        SIGNATURE_DOMAIN,
    )?;

    append_field(
        &mut message,
        expectation.artifact_id.as_bytes(),
    )?;

    append_field(
        &mut message,
        expectation.target.as_bytes(),
    )?;

    append_field(
        &mut message,
        expectation.format.as_bytes(),
    )?;

    append_field(
        &mut message,
        &expectation.size_bytes.to_be_bytes(),
    )?;

    append_field(
        &mut message,
        expectation.sha256_digest.as_bytes(),
    )?;

    match &artifact.provenance {
        Some(provenance) => {
            append_field(&mut message, b"provenance-present")?;

            for value in [
                provenance.backend.as_deref(),
                provenance.backend_version.as_deref(),
                provenance.input_identity.as_deref(),
                provenance.stage.as_deref(),
            ] {
                match value {
                    Some(value) => {
                        append_field(&mut message, b"present")?;
                        append_field(&mut message, value.as_bytes())?;
                    }
                    None => {
                        append_field(&mut message, b"absent")?;
                    }
                }
            }

            let count = u64::try_from(
                provenance.transformations.len(),
            )
            .map_err(|_| {
                integrity_error(
                    "provenance transformation count cannot be represented",
                )
            })?;

            append_field(
                &mut message,
                &count.to_be_bytes(),
            )?;

            for transformation in &provenance.transformations {
                append_field(
                    &mut message,
                    transformation.as_bytes(),
                )?;
            }
        }

        None => {
            append_field(&mut message, b"provenance-absent")?;
        }
    }

    Ok(message)
}

// ============================================================================
// VERIFICATION RECEIPT
// ============================================================================

/// Immutable record of a completed integrity-verification operation.
///
/// A receipt is produced only after all mandatory checks have succeeded.
///
/// It is not an execution result, trust-store entry, resource reservation,
/// semantic proof, or hardware compatibility guarantee.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct VerificationReceipt {
    artifact_id: String,
    target: String,
    format: String,
    sha256_digest: String,
    policy_identity: String,
    authority_identity: Option<String>,
    signing_key_identity: Option<String>,
    signature_verified: bool,
    provenance_present: bool,
}

impl VerificationReceipt {
    /// Returns the verified artifact identity.
    #[must_use]
    pub fn artifact_id(&self) -> &str {
        &self.artifact_id
    }

    /// Returns the verified target identity.
    #[must_use]
    pub fn target(&self) -> &str {
        &self.target
    }

    /// Returns the verified artifact format.
    #[must_use]
    pub fn format(&self) -> &str {
        &self.format
    }

    /// Returns the verified SHA-256 digest.
    #[must_use]
    pub fn sha256_digest(&self) -> &str {
        &self.sha256_digest
    }

    /// Returns the policy that authorized verification.
    #[must_use]
    pub fn policy_identity(&self) -> &str {
        &self.policy_identity
    }

    /// Returns the authority that resolved the signing identity.
    #[must_use]
    pub fn authority_identity(&self) -> Option<&str> {
        self.authority_identity.as_deref()
    }

    /// Returns the signing key identity, if a signature was verified.
    #[must_use]
    pub fn signing_key_identity(&self) -> Option<&str> {
        self.signing_key_identity.as_deref()
    }

    /// Whether a digital signature was successfully verified.
    #[must_use]
    pub const fn signature_verified(&self) -> bool {
        self.signature_verified
    }

    /// Whether provenance metadata was present and validated.
    #[must_use]
    pub const fn provenance_present(&self) -> bool {
        self.provenance_present
    }
}

// ============================================================================
// VERIFIER
// ============================================================================

/// Runtime artifact-integrity verification service.
///
/// The trust authority is explicitly injected.
///
/// No global mutable trust state or automatic key discovery is used.
pub struct ArtifactIntegrityVerifier {
    policy: IntegrityPolicy,
    trust_authority: Option<Arc<dyn ArtifactTrustAuthority>>,
}

impl fmt::Debug for ArtifactIntegrityVerifier {
    fn fmt(
        &self,
        formatter: &mut fmt::Formatter<'_>,
    ) -> fmt::Result {
        formatter
            .debug_struct("ArtifactIntegrityVerifier")
            .field("policy", &self.policy)
            .field(
                "has_trust_authority",
                &self.trust_authority.is_some(),
            )
            .finish()
    }
}

impl ArtifactIntegrityVerifier {
    /// Constructs an integrity verifier.
    ///
    /// A trust authority is mandatory when the policy requires
    /// signature verification.
    pub fn new(
        policy: IntegrityPolicy,
        trust_authority: Option<
            Arc<dyn ArtifactTrustAuthority>,
        >,
    ) -> ZurResult<Self> {
        if policy.requires_signature()
            && trust_authority.is_none()
        {
            return Err(configuration_error(
                "signature verification requires an injected trust authority",
            ));
        }

        if let Some(authority) = &trust_authority {
            validate_identifier(
                authority.authority_identity(),
                "trust authority identity",
            )?;
        }

        Ok(Self {
            policy,
            trust_authority,
        })
    }

    /// Returns the active integrity policy.
    #[must_use]
    pub fn policy(&self) -> &IntegrityPolicy {
        &self.policy
    }

    /// Verifies one compiler-produced artifact.
    ///
    /// `expectation` must originate from an independently trusted
    /// artifact manifest or authenticated distribution authority.
    ///
    /// `signature` is the detached artifact signature, when present.
    ///
    /// Verification order:
    ///
    /// 1. Validate artifact metadata.
    /// 2. Compare artifact identity and target with trusted expectations.
    /// 3. Compare exact payload size.
    /// 4. Calculate the actual payload digest.
    /// 5. Compare the actual digest with the trusted expected digest.
    /// 6. Validate any digest already recorded on the artifact.
    /// 7. Validate provenance.
    /// 8. Verify the required signature against a trusted public key.
    /// 9. Produce an immutable verification receipt.
    ///
    /// No receipt is produced if any mandatory check fails.
    pub fn verify(
        &self,
        artifact: &OutputArtifact,
        expectation: &IntegrityExpectation,
        signature: Option<&ArtifactSignature>,
    ) -> ZurResult<VerificationReceipt> {
        // ------------------------------------------------------------
        // 1. Canonical artifact metadata validation
        // ------------------------------------------------------------

        artifact.validate_metadata()
            .map_err(|error| {
                integrity_error(format!(
                    "canonical artifact metadata validation failed: {error}"
                ))
            })?;

        // ------------------------------------------------------------
        // 2. Artifact identity and metadata binding
        // ------------------------------------------------------------

        let actual_id = artifact.id.to_string();

        if actual_id != expectation.artifact_id {
            return Err(integrity_error(
                "artifact identity does not match the trusted expectation",
            ));
        }

        if artifact.target != expectation.target {
            return Err(integrity_error(
                "artifact target does not match the trusted expectation",
            ));
        }

        if artifact.format != expectation.format {
            return Err(integrity_error(
                "artifact format does not match the trusted expectation",
            ));
        }

        // ------------------------------------------------------------
        // 3. Payload size verification
        // ------------------------------------------------------------

        let actual_size = u64::try_from(
            artifact.payload.len(),
        )
        .map_err(|_| {
            integrity_error(
                "artifact payload size cannot be represented",
            )
        })?;

        if actual_size != expectation.size_bytes {
            return Err(integrity_error(
                "artifact payload size does not match the trusted expectation",
            ));
        }

        // ------------------------------------------------------------
        // 4. Calculate the digest from actual payload bytes
        // ------------------------------------------------------------

        let actual_digest = calculate_sha256(
            artifact.payload.as_bytes(),
        );

        // ------------------------------------------------------------
        // 5. Compare with independently supplied expected digest
        // ------------------------------------------------------------

        if actual_digest != expectation.sha256_digest {
            return Err(integrity_error(
                "artifact payload does not match the trusted SHA-256 digest",
            ));
        }

        // ------------------------------------------------------------
        // 6. Validate any artifact-recorded digest
        // ------------------------------------------------------------

        if let Some(recorded_digest) =
            artifact.content_digest.as_deref()
        {
            validate_sha256(recorded_digest)?;

            if recorded_digest != actual_digest {
                return Err(integrity_error(
                    "artifact-recorded digest does not match its payload",
                ));
            }
        }

        // ------------------------------------------------------------
        // 7. Validate provenance
        // ------------------------------------------------------------

        if let Some(provenance) = &artifact.provenance {
            provenance.validate()
                .map_err(|error| {
                    integrity_error(format!(
                        "artifact provenance validation failed: {error}"
                    ))
                })?;
        }

        let provenance_present =
            artifact.provenance.is_some();

        if self.policy.requires_provenance()
            && !provenance_present
        {
            return Err(integrity_error(
                "the active integrity policy requires artifact provenance",
            ));
        }

        // ------------------------------------------------------------
        // 8. Signature verification
        // ------------------------------------------------------------

        let mut authority_identity = None;
        let mut signing_key_identity = None;
        let mut signature_verified = false;

        match signature {
            Some(signature) => {
                let authority = self.trust_authority
                    .as_ref()
                    .ok_or_else(|| {
                        configuration_error(
                            "artifact signature supplied without a trust authority",
                        )
                    })?;

                if signature.algorithm != "ed25519" {
                    return Err(signature_error(
                        "unsupported signature algorithm",
                    ));
                }

                let resolved = authority.resolve_signing_key(
                    &signature.key_identity,
                )?;

                let trusted_key = match resolved {
                    SigningKeyResolution::Trusted(key) => key,

                    SigningKeyResolution::Unknown => {
                        return Err(trust_error(
                            "artifact signing identity is unknown",
                        ));
                    }

                    SigningKeyResolution::Revoked => {
                        return Err(trust_error(
                            "artifact signing identity has been revoked",
                        ));
                    }
                };

                if trusted_key.identity != signature.key_identity {
                    return Err(trust_error(
                        "resolved signing key identity does not match the requested identity",
                    ));
                }

                let message = signature_message(
                    artifact,
                    expectation,
                )?;

                let parsed_signature =
                    Signature::from_slice(
                        &signature.signature,
                    )
                    .map_err(|_| {
                        signature_error(
                            "artifact signature encoding is invalid",
                        )
                    })?;

                trusted_key.verifying_key
                    .verify(
                        &message,
                        &parsed_signature,
                    )
                    .map_err(|_| {
                        signature_error(
                            "artifact digital signature verification failed",
                        )
                    })?;

                authority_identity = Some(
                    authority.authority_identity().to_owned(),
                );

                signing_key_identity = Some(
                    trusted_key.identity,
                );

                signature_verified = true;
            }

            None if self.policy.requires_signature() => {
                return Err(signature_error(
                    "artifact signature is required by the active integrity policy",
                ));
            }

            None => {
                // An explicitly configured policy may permit unsigned
                // artifacts. Their digest still must match the independently
                // trusted expectation.
            }
        }

        // ------------------------------------------------------------
        // 9. Produce the verification receipt
        // ------------------------------------------------------------

        Ok(VerificationReceipt {
            artifact_id: actual_id,
            target: artifact.target.clone(),
            format: artifact.format.clone(),
            sha256_digest: actual_digest,
            policy_identity: self.policy.identity.clone(),
            authority_identity,
            signing_key_identity,
            signature_verified,
            provenance_present,
        })
    }
}

// ============================================================================
// INTEGRATION HELPERS
// ============================================================================

/// Verifies an artifact against a canonical expected digest.
///
/// This is useful for artifact pipelines that already have an
/// authenticated manifest but do not require detached signatures.
///
/// The caller must still establish the authenticity of the manifest
/// through the appropriate compiler/distribution trust authority.
pub fn verify_digest_only(
    artifact: &OutputArtifact,
    expectation: &IntegrityExpectation,
) -> ZurResult<String> {
    artifact.validate_metadata()
        .map_err(|error| {
            integrity_error(format!(
                "artifact metadata validation failed: {error}"
            ))
        })?;

    if artifact.id.to_string() != expectation.artifact_id {
        return Err(integrity_error(
            "artifact identity does not match the expected identity",
        ));
    }

    if artifact.target != expectation.target
        || artifact.format != expectation.format
    {
        return Err(integrity_error(
            "artifact metadata does not match the expected metadata",
        ));
    }

    let actual_size = u64::try_from(
        artifact.payload.len(),
    )
    .map_err(|_| {
        integrity_error(
            "artifact payload size cannot be represented",
        )
    })?;

    if actual_size != expectation.size_bytes {
        return Err(integrity_error(
            "artifact payload size does not match the expected size",
        ));
    }

    let actual = calculate_sha256(
        artifact.payload.as_bytes(),
    );

    if actual != expectation.sha256_digest {
        return Err(integrity_error(
            "artifact digest verification failed",
        ));
    }

    if let Some(recorded) = artifact.content_digest.as_deref() {
        validate_sha256(recorded)?;

        if recorded != actual {
            return Err(integrity_error(
                "artifact-recorded digest is inconsistent",
            ));
        }
    }

    Ok(actual)
}

// ============================================================================
// TESTS
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*;

    use ed25519_dalek::{
        Signer,
        SigningKey,
    };

    use std::sync::atomic::{
        AtomicUsize,
        Ordering,
    };

    struct TestTrustAuthority {
        key: TrustedSigningKey,
        calls: AtomicUsize,
    }

    impl ArtifactTrustAuthority for TestTrustAuthority {
        fn authority_identity(&self) -> &str {
            "zamani.test.trust"
        }

        fn resolve_signing_key(
            &self,
            identity: &str,
        ) -> ZurResult<SigningKeyResolution> {
            self.calls.fetch_add(1, Ordering::SeqCst);

            if identity == self.key.identity() {
                Ok(SigningKeyResolution::Trusted(
                    self.key.clone(),
                ))
            } else {
                Ok(SigningKeyResolution::Unknown)
            }
        }
    }

    struct UnknownTrustAuthority;

    impl ArtifactTrustAuthority for UnknownTrustAuthority {
        fn authority_identity(&self) -> &str {
            "zamani.test.unknown"
        }

        fn resolve_signing_key(
            &self,
            _identity: &str,
        ) -> ZurResult<SigningKeyResolution> {
            Ok(SigningKeyResolution::Unknown)
        }
    }

    #[test]
    fn sha256_is_deterministic() {
        let first = calculate_sha256(b"zamani");
        let second = calculate_sha256(b"zamani");

        assert_eq!(first, second);
        assert!(first.starts_with("sha256:"));
        assert_eq!(first.len(), 71);
    }

    #[test]
    fn sha256_distinguishes_different_payloads() {
        assert_ne!(
            calculate_sha256(b"first"),
            calculate_sha256(b"second"),
        );
    }

    #[test]
    fn sha256_handles_empty_payload() {
        assert_eq!(
            calculate_sha256(b""),
            "sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
        );
    }

    #[test]
    fn rejects_invalid_digest_algorithm() {
        assert!(
            validate_sha256("sha3:abcd").is_err()
        );
    }

    #[test]
    fn rejects_invalid_digest_length() {
        assert!(
            validate_sha256("sha256:abcd").is_err()
        );
    }

    #[test]
    fn rejects_noncanonical_uppercase_digest() {
        let digest = calculate_sha256(b"zamani")
            .to_uppercase();

        assert!(
            validate_sha256(&digest).is_err()
        );
    }

    #[test]
    fn accepts_canonical_digest() {
        assert!(
            validate_sha256(
                &calculate_sha256(b"zamani")
            )
            .is_ok()
        );
    }

    #[test]
    fn rejects_empty_artifact_identity() {
        assert!(
            IntegrityExpectation::new(
                "",
                "host",
                "native",
                0,
                calculate_sha256(b""),
            )
            .is_err()
        );
    }

    #[test]
    fn rejects_empty_target() {
        assert!(
            IntegrityExpectation::new(
                "artifact.one",
                "",
                "native",
                0,
                calculate_sha256(b""),
            )
            .is_err()
        );
    }

    #[test]
    fn rejects_invalid_signature_algorithm() {
        assert!(
            ArtifactSignature::new(
                "test.key",
                "unknown-algorithm",
                vec![0; 64],
            )
            .is_err()
        );
    }

    #[test]
    fn rejects_invalid_signature_length() {
        assert!(
            ArtifactSignature::new(
                "test.key",
                "ed25519",
                vec![0; 32],
            )
            .is_err()
        );
    }

    #[test]
    fn constructs_valid_ed25519_trusted_key() {
        let signing_key =
            SigningKey::from_bytes(&[7u8; 32]);

        let trusted = TrustedSigningKey::new(
            "zamani.test.key",
            signing_key.verifying_key().to_bytes(),
        );

        assert!(trusted.is_ok());
    }

    #[test]
    fn default_policy_requires_signature() {
        let policy = IntegrityPolicy::default();

        assert!(policy.requires_signature());
        assert!(!policy.requires_provenance());
    }

    #[test]
    fn signature_policy_requires_trust_authority() {
        let result = ArtifactIntegrityVerifier::new(
            IntegrityPolicy::default(),
            None,
        );

        assert!(result.is_err());
    }

    #[test]
    fn unsigned_policy_can_be_constructed_without_authority() {
        let policy = IntegrityPolicy::new(
            "zamani.test.unsigned-policy",
            false,
            false,
        )
        .expect("valid policy");

        let verifier = ArtifactIntegrityVerifier::new(
            policy,
            None,
        );

        assert!(verifier.is_ok());
    }

    #[test]
    fn trust_authority_rejects_unknown_signing_identity() {
        let authority = UnknownTrustAuthority;

        let result = authority.resolve_signing_key(
            "zamani.unknown.key",
        );

        assert!(matches!(
            result,
            Ok(SigningKeyResolution::Unknown)
        ));
    }

    #[test]
    fn trusted_key_identity_is_preserved() {
        let signing_key =
            SigningKey::from_bytes(&[9u8; 32]);

        let key = TrustedSigningKey::new(
            "zamani.test.signer",
            signing_key.verifying_key().to_bytes(),
        )
        .expect("valid public key");

        assert_eq!(
            key.identity(),
            "zamani.test.signer",
        );
    }

    #[test]
    fn test_authority_has_no_implicit_global_state() {
        let signing_key =
            SigningKey::from_bytes(&[3u8; 32]);

        let key = TrustedSigningKey::new(
            "zamani.test.signer",
            signing_key.verifying_key().to_bytes(),
        )
        .expect("valid key");

        let authority = TestTrustAuthority {
            key,
            calls: AtomicUsize::new(0),
        };

        assert_eq!(
            authority.authority_identity(),
            "zamani.test.trust",
        );

        assert_eq!(
            authority.calls.load(Ordering::SeqCst),
            0,
        );
    }
}
