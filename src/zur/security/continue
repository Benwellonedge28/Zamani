/// A public signing key resolved by an authoritative trust service.
///
/// Constructing this value does not independently establish trust.
/// The runtime accepts it only through an injected
/// `ArtifactTrustAuthority`.
#[derive(Debug, Clone)]
pub struct TrustedSigningKey {
    identity: String,
    verifying_key: VerifyingKey,
}

impl TrustedSigningKey {
    /// Constructs a signing key from its raw Ed25519 public key.
    pub fn new(
        identity: impl Into<String>,
        public_key: [u8; 32],
    ) -> ZurResult<Self> {
        let identity = identity.into();

        validate_identifier(
            &identity,
            "trusted signing key identity",
        )?;

        let verifying_key =
            VerifyingKey::from_bytes(&public_key)
                .map_err(|_| {
                    signature_error(
                        "trusted Ed25519 public key is invalid",
                    )
                })?;

        Ok(Self {
            identity,
            verifying_key,
        })
    }

    /// Returns the signing key identity.
    #[must_use]
    pub fn identity(&self) -> &str {
        &self.identity
    }
}

/// Result of resolving a signing identity.
#[derive(Debug, Clone)]
pub enum SigningKeyResolution {
    /// The authority recognizes and trusts the signing key.
    Trusted(TrustedSigningKey),

    /// The identity is unknown to the authority.
    Unknown,

    /// The identity has been explicitly revoked.
    Revoked,
}

/// Authority responsible for resolving trusted signing identities.
///
/// Implementations should integrate with the repository's canonical
/// trust, key-management, certificate and attestation infrastructure.
///
/// This module does not maintain a second trust store.
pub trait ArtifactTrustAuthority: Send + Sync {
    /// Returns the stable authority identity.
    fn authority_identity(&self) -> &str;

    /// Resolves a signing key against the authority's current trust state.
    ///
    /// Revocation and unknown identities must never be treated as trusted.
    fn resolve_signing_key(
        &self,
        key_identity: &str,
    ) -> ZurResult<SigningKeyResolution>;
}

