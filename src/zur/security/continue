// ============================================================================
// ERROR CONSTRUCTION
// ============================================================================

fn integrity_error(
    message: impl Into<String>,
) -> ZurError {
    ZurError::new(
        ErrorKind::Integrity,
        ErrorCode::new(
            "zur.security.artifact_integrity_failed",
        )
        .expect("static error code is valid"),
        message,
    )
    .with_component(COMPONENT)
    .with_operation("verify_artifact")
}

fn signature_error(
    message: impl Into<String>,
) -> ZurError {
    ZurError::new(
        ErrorKind::Cryptographic,
        ErrorCode::new(
            "zur.security.signature_verification_failed",
        )
        .expect("static error code is valid"),
        message,
    )
    .with_component(COMPONENT)
    .with_operation("verify_signature")
}

fn trust_error(
    message: impl Into<String>,
) -> ZurError {
    ZurError::new(
        ErrorKind::Security,
        ErrorCode::new(
            "zur.security.signing_identity_untrusted",
        )
        .expect("static error code is valid"),
        message,
    )
    .with_component(COMPONENT)
    .with_operation("resolve_signing_identity")
}

fn configuration_error(
    message: impl Into<String>,
) -> ZurError {
    ZurError::new(
        ErrorKind::Configuration,
        ErrorCode::new(
            "zur.security.integrity_configuration_invalid",
        )
        .expect("static error code is valid"),
        message,
    )
    .with_component(COMPONENT)
    .with_operation("configure_integrity_verification")
}

// ============================================================================
// IDENTIFIER VALIDATION
// ============================================================================

fn validate_identifier(
    value: &str,
    description: &str,
) -> ZurResult<()> {
    if value.is_empty() {
        return Err(integrity_error(
            format!("{description} must not be empty"),
        ));
    }

    if value.trim() != value {
        return Err(integrity_error(
            format!(
                "{description} contains surrounding whitespace"
            ),
        ));
    }

    if value.chars().any(char::is_control) {
        return Err(integrity_error(
            format!(
                "{description} contains control characters"
            ),
        ));
    }

    Ok(())
}

