//! # Zamani Toolchain — Scalability Verification
//!
//! Path: src/toolchain/testing/scalability.rs
//! Edition: Rust 2021
//! Minimum Rust version: 1.97
//!
//! Provides resource-aware, streaming scalability verification for
//! the Zamani toolchain.
//!
//! Supports actual workload adapters for:
//!
//! - Projects and workspaces.
//! - Source files and modules.
//! - Dependencies and dependency graphs.
//! - Build graphs and tasks.
//! - Packages and artifacts.
//! - Targets and providers.
//! - Classical, quantum, HDL, AI and tensor computation.
//! - Hybrid and distributed computation.
//! - Networking, cryptography and future domains.
//!
//! This module owns measurement and reporting, not the underlying
//! workload implementation.
//!
//! Canonical authorities:
//!
//! - grammar/specification/scalability-model.md
//! - grammar/specification/poco-reaf.md
//! - grammar/specification/semantic-model.md
//! - grammar/validation/semantic-boundaries.md
//! - crate::toolchain::configuration::budget
//! - crate::toolchain::tasks
//! - crate::toolchain::build::graph
//! - crate::toolchain::workspace
//! - crate::toolchain::dependencies
//! - crate::toolchain::tasks::cancellation
//! - crate::compiler
//! - crate::backend
//! - crate::zhal
//! - crate::zur
//!
//! No universal workload or hardware-capacity ceilings are introduced.
//! All accounting uses the canonical shared toolchain budget tracker.
//!
//! Workloads are consumed incrementally. The complete workload is
//! never collected into an intermediate allocation.
//!
//! Cancellation is cooperative.
//!
//! Accounting overflow, budget exhaustion, source failure and
//! consumer failure remain distinguishable.
//!
//! Partial measurements are preserved.

use std::num::NonZeroU128;
use std::time::{Duration, Instant};

use crate::toolchain::configuration::budget::{
    BudgetDimension,
    BudgetRequest,
    ToolchainBudget,
    ToolchainBudgetError,
    ToolchainBudgetTracker,
    ToolchainBudgetResult,
};

// ============================================================================
// ACCOUNTING DIMENSIONS
// ============================================================================

/// Canonical accounting dimensions used by scalability experiments.
///
/// These are open-world budget dimensions. They do not enumerate
/// computing domains or impose hardware-capacity restrictions.
///
/// The associated tracker must be shared with other participants
/// in the same logical operation.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct ScalabilityBudgetDimensions {
    records: BudgetDimension,
    logical_work: BudgetDimension,
    accounted_bytes: BudgetDimension,
    elapsed: BudgetDimension,
}

impl ScalabilityBudgetDimensions {
    /// Creates the standard scalability accounting dimensions.
    ///
    /// Dimension names are namespaced to avoid collisions with
    /// unrelated compiler and toolchain accounting.
    pub fn new() -> ToolchainBudgetResult<Self> {
        Ok(Self {
            records: BudgetDimension::new(
                "toolchain.scalability.records",
                "records",
            )?,
            logical_work: BudgetDimension::new(
                "toolchain.scalability.logical_work",
                "work_units",
            )?,
            accounted_bytes: BudgetDimension::new(
                "toolchain.scalability.accounted_bytes",
                "bytes",
            )?,
            elapsed: BudgetDimension::new(
                "toolchain.scalability.elapsed",
                "nanoseconds",
            )?,
        })
    }

    /// Returns the record-count dimension.
    #[must_use]
    pub fn records(&self) -> &BudgetDimension {
        &self.records
    }

    /// Returns the logical-work dimension.
    #[must_use]
    pub fn logical_work(&self) -> &BudgetDimension {
        &self.logical_work
    }

    /// Returns the accounted-byte dimension.
    #[must_use]
    pub fn accounted_bytes(&self) -> &BudgetDimension {
        &self.accounted_bytes
    }

    /// Returns the elapsed-time dimension.
    #[must_use]
    pub fn elapsed(&self) -> &BudgetDimension {
        &self.elapsed
    }
}

// ============================================================================
// WORKLOAD UNIT
// ============================================================================

/// One independently measurable workload record.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct ScalabilityUnit {
    logical_work: NonZeroU128,
    accounted_bytes: u128,
}

impl ScalabilityUnit {
    /// Creates a workload record.
    ///
    /// Logical work must be positive.
    #[must_use]
    pub const fn new(
        logical_work: NonZeroU128,
        accounted_bytes: u128,
    ) -> Self {
        Self {
            logical_work,
            accounted_bytes,
        }
    }

    /// Returns the logical work represented by this record.
    #[must_use]
    pub const fn logical_work(&self) -> u128 {
        self.logical_work.get()
    }

    /// Returns estimated workload bytes.
    ///
    /// This is cumulative accounting, not peak resident memory.
    #[must_use]
    pub const fn accounted_bytes(&self) -> u128 {
        self.accounted_bytes
    }
}

// ============================================================================
// FAILURES
// ============================================================================

/// Identifies an unsuccessful scalability operation.
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum ScalabilityFailure {
    /// A local measurement counter overflowed.
    CounterOverflow {
        /// Name of the affected counter.
        counter: &'static str,
    },

    /// The workload source failed.
    WorkloadSource {
        /// Source-provided explanation.
        message: String,
    },

    /// The workload consumer failed.
    Consumer {
        /// Consumer-provided explanation.
        message: String,
    },

    /// Canonical operational budget accounting failed.
    Budget(ToolchainBudgetError),
}

impl ScalabilityFailure {
    /// Creates a workload-source failure.
    #[must_use]
    pub fn workload(message: impl Into<String>) -> Self {
        Self::WorkloadSource {
            message: message.into(),
        }
    }

    /// Creates a consumer failure.
    #[must_use]
    pub fn consumer(message: impl Into<String>) -> Self {
        Self::Consumer {
            message: message.into(),
        }
    }
}

// ============================================================================
// TERMINATION
// ============================================================================

/// Describes why a scalability experiment stopped.
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum ScalabilityTermination {
    /// The workload completed normally.
    Completed,

    /// Cooperative cancellation was observed.
    Cancelled,

    /// An authoritative budget dimension was exhausted.
    BudgetExhausted {
        /// The exhausted canonical dimension.
        dimension: BudgetDimension,
    },

    /// The operation failed.
    Failed(ScalabilityFailure),
}

impl ScalabilityTermination {
    /// Returns whether the experiment completed normally.
    #[must_use]
    pub const fn is_completed(&self) -> bool {
        matches!(self, Self::Completed)
    }

    /// Returns whether the experiment was cancelled.
    #[must_use]
    pub const fn is_cancelled(&self) -> bool {
        matches!(self, Self::Cancelled)
    }

    /// Returns whether the experiment failed.
    #[must_use]
    pub const fn is_failed(&self) -> bool {
        matches!(self, Self::Failed(_))
    }
}

// ============================================================================
// REPORT
// ============================================================================

/// Immutable measurements from one scalability experiment.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct ScalabilityReport {
    processed_records: u128,
    logical_work: u128,
    accounted_bytes: u128,
    elapsed: Duration,
    termination: ScalabilityTermination,
}

impl ScalabilityReport {
    /// Returns successfully processed records.
    #[must_use]
    pub const fn processed_records(&self) -> u128 {
        self.processed_records
    }

    /// Returns successfully processed logical work.
    #[must_use]
    pub const fn logical_work(&self) -> u128 {
        self.logical_work
    }

    /// Returns successfully accounted workload bytes.
    #[must_use]
    pub const fn accounted_bytes(&self) -> u128 {
        self.accounted_bytes
    }

    /// Returns elapsed time.
    #[must_use]
    pub const fn elapsed(&self) -> Duration {
        self.elapsed
    }

    /// Returns the termination classification.
    #[must_use]
    pub const fn termination(&self) -> &ScalabilityTermination {
        &self.termination
    }

    /// Returns whether the experiment completed successfully.
    #[must_use]
    pub const fn is_complete(&self) -> bool {
        self.termination.is_completed()
    }

    /// Returns records processed per second when measurable.
    #[must_use]
    pub fn records_per_second(&self) -> Option<f64> {
        let seconds = self.elapsed.as_secs_f64();

        (seconds > 0.0)
            .then(|| self.processed_records as f64 / seconds)
    }

    /// Returns logical work units per second when measurable.
    #[must_use]
    pub fn logical_work_per_second(&self) -> Option<f64> {
        let seconds = self.elapsed.as_secs_f64();

        (seconds > 0.0)
            .then(|| self.logical_work as f64 / seconds)
    }
}

// ============================================================================
// HARNESS
// ============================================================================

/// Streaming scalability experiment executor.
///
/// Does not implement a scheduler, worker pool, compiler or
/// resource allocator.
#[derive(Clone, Copy, Debug, Default)]
pub struct ScalabilityHarness;

impl ScalabilityHarness {
    /// Creates a scalability harness.
    #[must_use]
    pub const fn new() -> Self {
        Self
    }

    /// Runs a streaming scalability experiment.
    ///
    /// `workload` supplies records incrementally.
    ///
    /// `tracker` MUST be the canonical shared tracker for the
    /// logical operation.
    ///
    /// `dimensions` identifies the accounting dimensions.
    ///
    /// `is_cancelled` observes the owning operation's cancellation.
    ///
    /// `consume` performs the actual measured operation.
    ///
    /// # Accounting
    ///
    /// Workload accounting is reserved transactionally before the
    /// consumer executes.
    ///
    /// Consequently, failed consumer attempts may remain charged
    /// against the operational budget. This is intentional:
    /// budgets account for admitted work, not only successful work.
    ///
    /// Report counters represent successfully completed records.
    ///
    /// Elapsed time is accounted incrementally.
    ///
    /// # Concurrency
    ///
    /// Shared trackers provide canonical concurrent accounting.
    ///
    /// A budget reservation may fail when another participant
    /// consumes the remaining allowance.
    ///
    /// # Cancellation
    ///
    /// Cancellation is cooperative. A blocking iterator or
    /// non-interruptible consumer cannot be forcibly terminated.
    pub fn run<I, C, F>(
        &self,
        workload: I,
        tracker: &ToolchainBudgetTracker,
        dimensions: &ScalabilityBudgetDimensions,
        mut is_cancelled: C,
        mut consume: F,
    ) -> ScalabilityReport
    where
        I: IntoIterator<
            Item = Result<ScalabilityUnit, ScalabilityFailure>,
        >,
        C: FnMut() -> bool,
        F: FnMut(&ScalabilityUnit) -> Result<(), ScalabilityFailure>,
    {
        let started = Instant::now();
        let mut last_accounted_elapsed = 0_u128;

        let mut records = 0_u128;
        let mut work = 0_u128;
        let mut bytes = 0_u128;

        let mut termination = ScalabilityTermination::Completed;
        let mut iterator = workload.into_iter();

        loop {
            if is_cancelled() {
                termination = ScalabilityTermination::Cancelled;
                break;
            }

            let next = iterator.next();

            if is_cancelled() {
                termination = ScalabilityTermination::Cancelled;
                break;
            }

            let unit = match next {
                None => break,
                Some(Err(error)) => {
                    termination = ScalabilityTermination::Failed(error);
                    break;
                }
                Some(Ok(unit)) => unit,
            };

            let next_records = match records.checked_add(1) {
                Some(value) => value,
                None => {
                    termination = ScalabilityTermination::Failed(
                        ScalabilityFailure::CounterOverflow {
                            counter: "processed_records",
                        },
                    );
                    break;
                }
            };

            let next_work = match work.checked_add(unit.logical_work()) {
                Some(value) => value,
                None => {
                    termination = ScalabilityTermination::Failed(
                        ScalabilityFailure::CounterOverflow {
                            counter: "logical_work",
                        },
                    );
                    break;
                }
            };

            let next_bytes = match bytes.checked_add(unit.accounted_bytes()) {
                Some(value) => value,
                None => {
                    termination = ScalabilityTermination::Failed(
                        ScalabilityFailure::CounterOverflow {
                            counter: "accounted_bytes",
                        },
                    );
                    break;
                }
            };

            // Account for time spent generating and preparing this record.
            let elapsed_now = started.elapsed().as_nanos();

            let elapsed_delta = match elapsed_now
                .checked_sub(last_accounted_elapsed)
            {
                Some(value) => value,
                None => {
                    termination = ScalabilityTermination::Failed(
                        ScalabilityFailure::CounterOverflow {
                            counter: "elapsed_nanoseconds",
                        },
                    );
                    break;
                }
            };

            // All workload dimensions are reserved atomically.
            let requests = [
                BudgetRequest::new(dimensions.records().clone(), 1),
                BudgetRequest::new(
                    dimensions.logical_work().clone(),
                    unit.logical_work(),
                ),
                BudgetRequest::new(
                    dimensions.accounted_bytes().clone(),
                    unit.accounted_bytes(),
                ),
                BudgetRequest::new(
                    dimensions.elapsed().clone(),
                    elapsed_delta,
                ),
            ];

            if let Err(error) = tracker.consume_batch(&requests) {
                termination = classify_budget_failure(error);
                break;
            }

            last_accounted_elapsed = elapsed_now;

            if let Err(error) = consume(&unit) {
                termination = ScalabilityTermination::Failed(error);
                break;
            }

            records = next_records;
            work = next_work;
            bytes = next_bytes;

            if is_cancelled() {
                termination = ScalabilityTermination::Cancelled;
                break;
            }

            // Account for time spent consuming the record.
            let elapsed_now = started.elapsed().as_nanos();

            let elapsed_delta = match elapsed_now
                .checked_sub(last_accounted_elapsed)
            {
                Some(value) => value,
                None => {
                    termination = ScalabilityTermination::Failed(
                        ScalabilityFailure::CounterOverflow {
                            counter: "elapsed_nanoseconds",
                        },
                    );
                    break;
                }
            };

            if elapsed_delta > 0 {
                let request = BudgetRequest::new(
                    dimensions.elapsed().clone(),
                    elapsed_delta,
                );

                if let Err(error) =
                    tracker.consume_batch(&[request])
                {
                    termination = classify_budget_failure(error);
                    break;
                }

                last_accounted_elapsed = elapsed_now;
            }
        }

        ScalabilityReport {
            processed_records: records,
            logical_work: work,
            accounted_bytes: bytes,
            elapsed: started.elapsed(),
            termination,
        }
    }
}

// ============================================================================
// BUDGET ERROR CLASSIFICATION
// ============================================================================

fn classify_budget_failure(
    error: ToolchainBudgetError,
) -> ScalabilityTermination {
    match error {
        ToolchainBudgetError::Exceeded {
            dimension,
            ..
        } => ScalabilityTermination::BudgetExhausted {
            dimension,
        },

        other => ScalabilityTermination::Failed(
            ScalabilityFailure::Budget(other),
        ),
    }
}

// ============================================================================
// TESTS
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*;

    use std::num::NonZeroU128;

    fn unit(work: u128, bytes: u128) -> ScalabilityUnit {
        ScalabilityUnit::new(
            NonZeroU128::new(work).expect("positive work"),
            bytes,
        )
    }

    fn dimensions() -> ScalabilityBudgetDimensions {
        ScalabilityBudgetDimensions::new()
            .expect("valid scalability dimensions")
    }

    fn unlimited_tracker() -> ToolchainBudgetTracker {
        ToolchainBudget::unlimited().tracker()
    }

    fn bounded_tracker(
        dimension: BudgetDimension,
        limit: u128,
    ) -> ToolchainBudgetTracker {
        ToolchainBudget::new()
            .with_limit(
                dimension,
                crate::toolchain::configuration::budget::BudgetLimit::bounded(
                    limit,
                ),
            )
            .tracker()
    }

    fn workload(
        count: usize,
    ) -> impl Iterator<
        Item = Result<ScalabilityUnit, ScalabilityFailure>,
    > {
        std::iter::repeat_with(|| Ok(unit(1, 1))).take(count)
    }

    #[test]
    fn empty_workload_completes() {
        let dimensions = dimensions();

        let report = ScalabilityHarness::new().run(
            std::iter::empty(),
            &unlimited_tracker(),
            &dimensions,
            || false,
            |_| Ok(()),
        );

        assert!(report.is_complete());
        assert_eq!(report.processed_records(), 0);
    }

    #[test]
    fn single_record_completes() {
        let dimensions = dimensions();

        let report = ScalabilityHarness::new().run(
            workload(1),
            &unlimited_tracker(),
            &dimensions,
            || false,
            |_| Ok(()),
        );

        assert!(report.is_complete());
        assert_eq!(report.processed_records(), 1);
        assert_eq!(report.logical_work(), 1);
        assert_eq!(report.accounted_bytes(), 1);
    }

    #[test]
    fn streaming_workload_scales_without_collection() {
        let dimensions = dimensions();

        let count = 100_000_usize;

        let report = ScalabilityHarness::new().run(
            workload(count),
            &unlimited_tracker(),
            &dimensions,
            || false,
            |_| Ok(()),
        );

        assert!(report.is_complete());
        assert_eq!(report.processed_records(), count as u128);
        assert_eq!(report.logical_work(), count as u128);
    }

    #[test]
    fn canonical_record_budget_is_enforced() {
        let dimensions = dimensions();

        let tracker = bounded_tracker(
            dimensions.records().clone(),
            2,
        );

        let report = ScalabilityHarness::new().run(
            workload(5),
            &tracker,
            &dimensions,
            || false,
            |_| Ok(()),
        );

        assert_eq!(report.processed_records(), 2);

        assert!(matches!(
            report.termination(),
            ScalabilityTermination::BudgetExhausted { dimension }
                if dimension == dimensions.records()
        ));
    }

    #[test]
    fn canonical_work_budget_is_enforced() {
        let dimensions = dimensions();

        let tracker = bounded_tracker(
            dimensions.logical_work().clone(),
            3,
        );

        let records = std::iter::repeat_with(|| Ok(unit(2, 1)))
            .take(5);

        let report = ScalabilityHarness::new().run(
            records,
            &tracker,
            &dimensions,
            || false,
            |_| Ok(()),
        );

        assert_eq!(report.processed_records(), 1);
        assert_eq!(report.logical_work(), 2);

        assert!(matches!(
            report.termination(),
            ScalabilityTermination::BudgetExhausted { dimension }
                if dimension == dimensions.logical_work()
        ));
    }

    #[test]
    fn canonical_byte_budget_is_enforced() {
        let dimensions = dimensions();

        let tracker = bounded_tracker(
            dimensions.accounted_bytes().clone(),
            5,
        );

        let records = std::iter::repeat_with(|| Ok(unit(1, 3)))
            .take(5);

        let report = ScalabilityHarness::new().run(
            records,
            &tracker,
            &dimensions,
            || false,
            |_| Ok(()),
        );

        assert_eq!(report.processed_records(), 1);
        assert_eq!(report.accounted_bytes(), 3);
    }

    #[test]
    fn cancellation_preserves_completed_work() {
        let dimensions = dimensions();
        let mut checks = 0_usize;

        let report = ScalabilityHarness::new().run(
            workload(10),
            &unlimited_tracker(),
            &dimensions,
            || {
                checks += 1;
                checks >= 5
            },
            |_| Ok(()),
        );

        assert!(report.processed_records() < 10);
        assert!(report.termination().is_cancelled());
    }

    #[test]
    fn source_failure_preserves_partial_report() {
        let dimensions = dimensions();

        let records = vec![
            Ok(unit(1, 1)),
            Ok(unit(2, 2)),
            Err(ScalabilityFailure::workload("test failure")),
        ];

        let report = ScalabilityHarness::new().run(
            records,
            &unlimited_tracker(),
            &dimensions,
            || false,
            |_| Ok(()),
        );

        assert_eq!(report.processed_records(), 2);
        assert_eq!(report.logical_work(), 3);

        assert!(matches!(
            report.termination(),
            ScalabilityTermination::Failed(
                ScalabilityFailure::WorkloadSource { .. }
            )
        ));
    }

    #[test]
    fn consumer_failure_is_not_reported_as_completed() {
        let dimensions = dimensions();
        let mut calls = 0_usize;

        let report = ScalabilityHarness::new().run(
            workload(5),
            &unlimited_tracker(),
            &dimensions,
            || false,
            |_| {
                calls += 1;

                if calls == 3 {
                    Err(ScalabilityFailure::consumer("failure"))
                } else {
                    Ok(())
                }
            },
        );

        assert_eq!(report.processed_records(), 2);
        assert!(report.termination().is_failed());
    }

    #[test]
    fn arithmetic_overflow_is_reported() {
        let dimensions = dimensions();

        let records = vec![
            Ok(unit(u128::MAX, 0)),
            Ok(unit(1, 0)),
        ];

        let report = ScalabilityHarness::new().run(
            records,
            &unlimited_tracker(),
            &dimensions,
            || false,
            |_| Ok(()),
        );

        assert_eq!(report.processed_records(), 1);

        assert_eq!(
            report.termination(),
            &ScalabilityTermination::Failed(
                ScalabilityFailure::CounterOverflow {
                    counter: "logical_work",
                }
            )
        );
    }

    #[test]
    fn accounting_uses_the_shared_canonical_tracker() {
        let dimensions = dimensions();
        let tracker = unlimited_tracker();

        let report = ScalabilityHarness::new().run(
            workload(10),
            &tracker,
            &dimensions,
            || false,
            |_| Ok(()),
        );

        assert!(report.is_complete());

        assert_eq!(
            tracker.consumed(dimensions.records())
                .expect("record accounting"),
            10
        );

        assert_eq!(
            tracker.consumed(dimensions.logical_work())
                .expect("work accounting"),
            10
        );

        assert_eq!(
            tracker.consumed(dimensions.accounted_bytes())
                .expect("byte accounting"),
            10
        );
    }

    #[test]
    fn accounting_dimensions_are_open_world() {
        let dimensions = dimensions();

        assert_eq!(
            dimensions.records().name(),
            "toolchain.scalability.records"
        );

        assert_eq!(
            dimensions.logical_work().unit(),
            "work_units"
        );
    }

    #[test]
    fn zero_record_budget_accepts_no_records() {
        let dimensions = dimensions();

        let tracker = bounded_tracker(
            dimensions.records().clone(),
            0,
        );

        let report = ScalabilityHarness::new().run(
            workload(1),
            &tracker,
            &dimensions,
            || false,
            |_| Ok(()),
        );

        assert_eq!(report.processed_records(), 0);
        assert!(!report.is_complete());
    }

    #[test]
    fn reports_preserve_completed_measurements() {
        let dimensions = dimensions();

        let report = ScalabilityHarness::new().run(
            workload(20),
            &unlimited_tracker(),
            &dimensions,
            || false,
            |_| Ok(()),
        );

        assert_eq!(report.processed_records(), 20);
        assert_eq!(report.logical_work(), 20);
        assert_eq!(report.accounted_bytes(), 20);
        assert!(report.is_complete());
    }
}