    #[test]
    fn direct_child_helpers_are_non_recursive() {
        let children = [
            NodeId::new(2),
            NodeId::new(3),
            NodeId::new(4),
        ];

        assert_eq!(direct_child_count(&children), 3);
        assert!(!has_no_direct_children(&children));

        let collected: Vec<NodeId> =
            direct_children(&children).copied().collect();

        assert_eq!(collected, children);
    }

