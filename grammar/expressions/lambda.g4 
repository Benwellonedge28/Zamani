parser grammar Lambda;

options {
    tokenVocab = ZamaniLexer;
}


/*
 * ============================================================================
 * PUBLIC LAMBDA ENTRY POINT
 * ============================================================================
 *
 * A lambda consists of:
 *
 *     parameter clause
 *     optional explicit return type
 *     body
 *
 * No lambda keyword is required.
 */
lambdaExpression
    : lambdaParameterClause
      lambdaReturnTypeClause?
      lambdaBody
    ;


/*
 * ============================================================================
 * PARAMETER CLAUSE
 * ============================================================================
 *
 * The parameter list is optional so that:
 *
 *     ||
 *
 * represents a parameterless lambda.
 *
 * All parameter structure is delegated to the canonical parameter grammar.
 */
lambdaParameterClause
    : PIPE
      parameterList?
      PIPE
    ;


/*
 * ============================================================================
 * OPTIONAL RETURN TYPE
 * ============================================================================
 *
 * Example:
 *
 *     |x| -> Int x + 1
 *
 * The type itself is owned by the canonical type grammar.
 */
lambdaReturnTypeClause
    : THIN_ARROW
      typeExpression
    ;


/*
 * ============================================================================
 * BODY
 * ============================================================================
 *
 * A lambda requires exactly one body.
 *
 * The body may be:
 *
 *     expression
 *
 * or:
 *
 *     blockExpression
 *
 * Both are canonical rules owned elsewhere.
 */
lambdaBody
    : expression
    | blockExpression
    ;