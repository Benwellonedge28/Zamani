/*
 * ============================================================================
 * Zamani Universal Programming Language
 * ============================================================================
 *
 * File:
 *     grammar/interoperability/interoperability.g4
 *
 * Grammar:
 *     Interoperability
 *
 * Status:
 *     CANONICAL INTEROPERABILITY COMPOSITION GRAMMAR
 *
 * Compiler baseline:
 *     Rust 1.97 / Rust 1.97.1
 *     Rust 2021
 *     SAFE RUST ONLY
 *     NO UNSAFE RUST
 *
 * ============================================================================
 * PURPOSE
 * ============================================================================
 *
 * This file is the canonical COMPOSITION BOUNDARY for Zamani
 * interoperability syntax.
 *
 * It does NOT own the syntax of every foreign language.
 *
 * It does NOT define a second FFI grammar.
 *
 * It does NOT define a second ABI grammar.
 *
 * It does NOT define a second serialization grammar.
 *
 * It does NOT define C, C++, Python, Rust, Zig, Verilog, OpenQASM,
 * assembly, WASM, or any other foreign language.
 *
 * Instead, it composes the repository's independently owned
 * interoperability grammars into the three parser entry points required by
 * grammar/antlr/ZamaniParser.g4:
 *
 *     interoperabilityDeclaration
 *     interoperabilityStatement
 *     interoperabilityExpression
 *
 * This file therefore answers:
 *
 *     "Which already-defined interoperability constructs participate in
 *      canonical Zamani source composition?"
 *
 * It does NOT answer:
 *
 *     "How is the construct implemented?"
 *
 * ============================================================================
 * ARCHITECTURAL PIPELINE
 * ============================================================================
 *
 *                         ZAMANI SOURCE
 *                              |
 *                              v
 *                         ZamaniLexer
 *                              |
 *                              v
 *                       ZamaniParser
 *                              |
 *                              v
 *                   Interoperability
 *                              |
 *        +---------------------+----------------------+
 *        |                     |                      |
 *        v                     v                      v
 *       ABI                   FFI             Foreign-function
 *     contracts             contracts           contracts
 *        |                     |                      |
 *        +---------------------+----------------------+
 *                              |
 *                              v
 *                    Serialization boundary
 *                              |
 *                              v
 *                     Domain-neutral AST
 *                              |
 *                              v
 *                      Semantic analysis
 *                              |
 *          +-------------------+-------------------+
 *          |                   |                   |
 *          v                   v                   v
 *       classical          quantum semantics    HDL/hardware
 *          |                   |                   |
 *          |                   v                   |
 *          |              quantum::ir             |
 *          |                   |                   |
 *          +-------------------+-------------------+
 *                              |
 *                              v
 *                         canonical IR
 *                              |
 *                    +---------+---------+
 *                    |         |         |
 *                    v         v         v
 *                optimize   route     schedule
 *                              |
 *                              v
 *                         resilience/QEC
 *                              |
 *                              v
 *                             ZQN
 *                              |
 *                              v
 *                             HAL
 *                              |
 *                              v
 *                       target realization
 *
 * ============================================================================
 * SINGLE-AUTHORITY RULE
 * ============================================================================
 *
 * Ownership is deliberately split:
 *
 *     ABI
 *         grammar/interoperability/abi.g4
 *
 *     FFI
 *         grammar/interoperability/ffi.g4
 *
 *     interoperability-specific foreign functions
 *         grammar/interoperability/foreign-functions.g4
 *
 *     serialization/deserialization
 *         grammar/data/serialization.g4
 *
 *     serialization interoperability façade
 *         grammar/interoperability/serialization.g4
 *
 *     names
 *         grammar/core/names.g4
 *
 *     attributes
 *         grammar/core/attributes.g4
 *
 *     expressions
 *         grammar/expressions/expressions.g4
 *
 *     types
 *         grammar/types/types.g4
 *
 *     parameters
 *         grammar/functions/parameters.g4
 *
 *     function generic parameters
 *         grammar/functions/generics.g4
 *
 *     visibility
 *         grammar/core/visibility.g4
 *
 * This file ONLY composes those contracts.
 *
 * ============================================================================
 * CRITICAL NON-DUPLICATION RULE
 * ============================================================================
 *
 * DO NOT add independent definitions here for:
 *
 *     identifier
 *     qualifiedName
 *     expression
 *     typeExpression
 *     parameter
 *     parameterList
 *     attribute
 *     ABI contracts
 *     FFI contracts
 *     foreign-function declarations
 *     serialization
 *     deserialization
 *
 * Any such definition would create a second authority.
 *
 * ============================================================================
 * ANTLR IMPORT MODEL
 * ============================================================================
 *
 * ANTLR parser imports operate on parser grammar names.
 *
 * Therefore this file imports grammar identities, not filesystem paths.
 *
 * The imported grammar names are:
 *
 *     Names
 *     Attributes
 *     Expressions
 *     Types
 *     Parameters
 *     FunctionGenerics
 *     Visibility
 *     Abi
 *     Ffi
 *     InteroperabilityForeignFunctions
 *     SerializationInterop
 *
 * The source directory structure remains:
 *
 *     grammar/core/
 *     grammar/expressions/
 *     grammar/types/
 *     grammar/functions/
 *     grammar/interoperability/
 *
 * The build system is responsible for putting those grammar roots on the
 * ANTLR grammar source path.
 *
 * ============================================================================
 * LEXER AUTHORITY
 * ============================================================================
 *
 * The parser-facing lexer is:
 *
 *     grammar/antlr/ZamaniLexer.g4
 *
 * Therefore:
 *
 *     tokenVocab = ZamaniLexer;
 *
 * is mandatory.
 *
 * This grammar MUST NOT use:
 *
 *     tokenVocab = ZamaniTokens;
 *
 * as its parser-facing vocabulary.
 *
 * ZamaniTokens is an internal lexical composition layer.
 *
 * ZamaniLexer is the canonical parser-facing lexer boundary.
 *
 * ============================================================================
 * ROOT-PARSER CONTRACT
 * ============================================================================
 *
 * grammar/antlr/ZamaniParser.g4 currently defines:
 *
 *     interoperabilityElement
 *         : interoperabilityDeclaration
 *         | interoperabilityStatement
 *         | interoperabilityExpression
 *         ;
 *
 * Therefore this grammar MUST provide exactly those reusable entry points.
 *
 * A generic rule named only:
 *
 *     interoperability
 *
 * is insufficient as the canonical composition contract.
 *
 * This file therefore deliberately exposes:
 *
 *     interoperabilityDeclaration
 *     interoperabilityStatement
 *     interoperabilityExpression
 *
 * ============================================================================
 * POCO-REAF
 * ============================================================================
 *
 * This grammar preserves:
 *
 *     Program_Once_Compile_Once_Run_Everywhere_Anywhere_Forever
 *
 * Interoperability syntax describes:
 *
 *     WHAT boundary is required
 *
 * rather than:
 *
 *     WHICH physical machine realizes it.
 *
 * The grammar therefore imposes NO universal language-level limits on:
 *
 *     CPU count
 *     core count
 *     thread count
 *     GPU count
 *     FPGA count
 *     accelerator count
 *     QPU count
 *     qubit count
 *     node count
 *     device count
 *     memory capacity
 *     storage capacity
 *     network size
 *     tensor rank
 *     tensor dimensions
 *     register width
 *     address-space size
 *     interface count
 *     function count
 *     parameter count
 *     argument count
 *     schema size
 *     metadata size
 *
 * In particular, this grammar MUST NOT introduce:
 *
 *     MAX_QUBITS
 *     MAX_CPUS
 *     MAX_GPUS
 *     MAX_FPGAS
 *     MAX_NODES
 *     MAX_MEMORY
 *     MAX_THREADS
 *     MAX_TENSOR_RANK
 *     MAX_REGISTER_WIDTH
 *     MAX_NETWORK_SIZE
 *     MAX_DEVICE_COUNT
 *
 * Program-level quantities remain program semantics.
 *
 * Target capacities remain resource/capability concerns.
 *
 * ============================================================================
 * REQUIREMENT / CAPABILITY / CONSTRAINT / PREFERENCE / HINT
 * ============================================================================
 *
 * Interoperability MUST preserve the distinction between:
 *
 *     requirement
 *         What must be true.
 *
 *     capability
 *         What a realization can provide.
 *
 *     constraint
 *         What implementations are forbidden from violating.
 *
 *     preference
 *         What implementation is preferred but not mandatory.
 *
 *     hint
 *         Non-binding implementation guidance.
 *
 *     realization
 *         A downstream compiler/runtime/backend decision.
 *
 * The composition grammar does not collapse these concepts.
 *
 * ============================================================================
 * SECURITY / INERTNESS
 * ============================================================================
 *
 * Parsing interoperability syntax MUST NOT:
 *
 *     - load libraries;
 *     - open files;
 *     - resolve symbols;
 *     - inspect hardware;
 *     - inspect devices;
 *     - inspect network topology;
 *     - execute foreign code;
 *     - create processes;
 *     - allocate native resources;
 *     - dereference physical addresses;
 *     - perform dynamic linking;
 *     - invoke QPU APIs;
 *     - invoke HDL tools;
 *     - perform QEC;
 *     - perform ZQN analysis;
 *     - perform routing;
 *     - perform scheduling.
 *
 * The grammar is declarative and inert.
 *
 * ============================================================================
 * FOREIGN-LANGUAGE INTEGRATION
 * ============================================================================
 *
 * The following remain independent language/format grammars:
 *
 *     c.g4
 *     cpp.g4
 *     python.g4
 *     rust.g4
 *     zig.g4
 *     openqasm.g4
 *     verilog.g4
 *     AssemblyLanguage.g4
 *     system-interfaces.g4
 *
 * This file MUST NOT import or reproduce their complete syntax.
 *
 * In particular, OpenQASM remains a separate grammar because its grammar is
 * a complete foreign-language grammar rather than a parser component of the
 * Zamani interoperability contract.
 *
 * The OpenQASM pipeline remains:
 *
 *     OpenQASM source
 *          |
 *          v
 *     OpenQASM parser
 *          |
 *          v
 *     semantic validation
 *          |
 *          v
 *     canonical quantum::ir
 *
 * The same architectural separation applies to HDL and other foreign
 * languages.
 *
 * ============================================================================
 * ABI INTEGRATION
 * ============================================================================
 *
 * ABI syntax remains owned by Abi.
 *
 * This composition grammar exposes:
 *
 *     abiDeclaration
 *     abiContract
 *
 * without redefining their internals.
 *
 * ABI implementation remains downstream.
 *
 * The grammar does not determine:
 *
 *     pointer width
 *     alignment
 *     register allocation
 *     stack layout
 *     calling sequence
 *     object format
 *     binary encoding
 *     linker behavior
 *     loader behavior
 *
 * ============================================================================
 * FFI INTEGRATION
 * ============================================================================
 *
 * FFI syntax remains owned by Ffi.
 *
 * The composition grammar exposes the public FFI item forms through the
 * canonical Ffi rules.
 *
 * FFI realization remains downstream.
 *
 * ============================================================================
 * FOREIGN FUNCTION INTEGRATION
 * ============================================================================
 *
 * InteroperabilityForeignFunctions remains the owner of its specialized
 * external callable declaration syntax.
 *
 * IMPORTANT:
 *
 * It MUST NOT be added as an unrestricted sibling alternative to
 * abiDeclaration when both constructs share the same EXTERN prefix and
 * overlapping bodies.
 *
 * Doing so would create a composition-level ambiguity.
 *
 * The interoperable foreign-function grammar is therefore exposed through
 * an explicitly named adapter rule and remains available to the appropriate
 * ABI/FFI integration layer.
 *
 * This file does not silently choose one interpretation using alternative
 * ordering.
 *
 * ============================================================================
 * SERIALIZATION INTEGRATION
 * ============================================================================
 *
 * Serialization is a representation boundary, not an interoperability IR.
 *
 * The canonical serialization authority remains:
 *
 *     grammar/data/serialization.g4
 *
 * The interoperability façade remains:
 *
 *     grammar/interoperability/serialization.g4
 *
 * This file composes the façade rather than duplicating serialization rules.
 *
 * Serialization/deserialization therefore remains compatible with:
 *
 *     classical data
 *     quantum-associated data
 *     hybrid data
 *     tensors
 *     AI/ML artifacts
 *     HDL/hardware descriptions
 *     distributed messages
 *     network payloads
 *     persistent artifacts
 *
 * without introducing another data IR.
 *
 * ============================================================================
 * QUANTUM INTEGRATION
 * ============================================================================
 *
 * Interoperability may cross a quantum/classical boundary.
 *
 * This file does NOT define:
 *
 *     gates
 *     QubitId
 *     physical qubits
 *     topology
 *     routing
 *     scheduling
 *     calibration
 *     QEC
 *     ZQN
 *     HAL
 *
 * A quantum-related interoperability construct eventually follows:
 *
 *     interoperability syntax
 *          |
 *          v
 *     frontend AST
 *          |
 *          v
 *     semantic analysis
 *          |
 *          v
 *     quantum semantic representation
 *          |
 *          v
 *     quantum::ir
 *
 * No second quantum IR is introduced here.
 *
 * ============================================================================
 * HDL / HARDWARE INTEGRATION
 * ============================================================================
 *
 * HDL and hardware interoperability remain semantic boundaries.
 *
 * This file does not define:
 *
 *     physical pin numbers
 *     register addresses
 *     bus widths
 *     FPGA capacities
 *     ASIC capacities
 *     accelerator counts
 *     device IDs
 *     physical topology
 *
 * Hardware realization remains downstream.
 *
 * ============================================================================
 * DISTRIBUTED INTEGRATION
 * ============================================================================
 *
 * Interoperability may describe distributed interfaces, but this file does
 * not select:
 *
 *     node 0
 *     node 1
 *     CPU 0
 *     GPU 0
 *     device 7
 *
 * or any other physical resource.
 *
 * Distributed realization remains owned by:
 *
 *     grammar/distributed/
 *     resource/capability analysis
 *     deployment
 *     runtime
 *
 * ============================================================================
 * AST CONTRACT
 * ============================================================================
 *
 * This grammar introduces NO interoperability-specific universal AST.
 *
 * The intended mapping is:
 *
 *     interoperabilityDeclaration
 *          |
 *          v
 *     canonical frontend AST
 *          |
 *          v
 *     semantic interoperability contract
 *
 *     interoperabilityStatement
 *          |
 *          v
 *     canonical statement/call/serialization AST
 *
 *     interoperabilityExpression
 *          |
 *          v
 *     canonical expression AST
 *
 * The fact that a construct entered through this composition grammar MUST
 * NOT require a duplicate AST hierarchy.
 *
 * Forbidden examples:
 *
 *     InteroperabilityIR
 *     FfiIR
 *     AbiIR
 *     SerializationInteropIR
 *     QuantumInteropIR
 *
 * ============================================================================
 * SEMANTIC CONTRACT
 * ============================================================================
 *
 * Semantic analysis resolves:
 *
 *     language identity
 *     ABI identity
 *     interface identity
 *     foreign symbol identity
 *     type compatibility
 *     conversion validity
 *     ownership
 *     lifetime
 *     nullability
 *     effects
 *     capabilities
 *     resource requirements
 *     compatibility
 *     versioning
 *     security
 *     provenance
 *
 * Parsing does not perform these operations.
 *
 * ============================================================================
 * IR CONTRACT
 * ============================================================================
 *
 * This grammar defines no IR.
 *
 * Interoperability semantics are lowered through the repository's canonical
 * semantic/IR pipeline.
 *
 * For quantum computation:
 *
 *     quantum semantics -> quantum::ir
 *
 * For classical computation:
 *
 *     classical semantics -> canonical classical IR
 *
 * For HDL/hardware:
 *
 *     hardware semantics -> canonical HDL/hardware representation
 *
 * Serialization remains a representation boundary around canonical semantic
 * values.
 *
 * ============================================================================
 * COMPILER INTEGRATION
 * ============================================================================
 *
 * Compiler stages consume interoperability semantics after parsing:
 *
 *     parse
 *       |
 *       v
 *     AST
 *       |
 *       v
 *     name/type/effect/capability analysis
 *       |
 *       v
 *     interoperability validation
 *       |
 *       v
 *     canonical semantic model
 *       |
 *       v
 *     IR generation
 *       |
 *       v
 *     optimization/lowering
 *       |
 *       v
 *     ABI/link/runtime realization
 *
 * This grammar MUST NOT invoke any compiler backend.
 *
 * ============================================================================
 * RUNTIME INTEGRATION
 * ============================================================================
 *
 * Runtime behavior may eventually perform:
 *
 *     foreign calls
 *     serialization
 *     deserialization
 *     callbacks
 *     transport
 *     dynamic linking
 *     device interaction
 *
 * None of those operations occurs during parsing.
 *
 * Runtime availability MUST NOT change whether the grammar accepts a source
 * program.
 *
 * ============================================================================
 * SOURCE PROVENANCE
 * ============================================================================
 *
 * Every imported construct retains its parser context and therefore its
 * source span.
 *
 * Downstream AST construction MUST preserve:
 *
 *     source file
 *     byte/character range
 *     line/column information where available
 *     originating grammar construct
 *
 * Interoperability diagnostics must therefore be able to point back to the
 * exact source declaration, call, expression, or contract.
 *
 * ============================================================================
 * DETERMINISM
 * ============================================================================
 *
 * This composition grammar contains:
 *
 *     - no semantic predicates;
 *     - no parser actions;
 *     - no external calls;
 *     - no randomness;
 *     - no environment access;
 *     - no filesystem access;
 *     - no network access;
 *     - no target-dependent parsing.
 *
 * Given the same token stream and grammar version, parsing is deterministic.
 *
 * ============================================================================
 * SCALABILITY
 * ============================================================================
 *
 * All repetition is represented using grammar repetition:
 *
 *     *
 *     +
 *
 * rather than artificial finite maxima.
 *
 * Examples:
 *
 *     ffi interfaces
 *     ABI members
 *     callbacks
 *     conversions
 *     requirements
 *     attributes
 *     serialization contracts
 *
 * can scale according to actual compiler/runtime resources.
 *
 * "Infinity" means:
 *
 *     no artificial language-level ceiling.
 *
 * It does NOT mean that a physical machine has infinite resources.
 *
 * ============================================================================
 * PUBLIC COMPOSITION RULES
 * ============================================================================
 *
 * These are the rules consumed by grammar/antlr/ZamaniParser.g4.
 *
 * ============================================================================
 */


/*
 * ============================================================================
 * CANONICAL DECLARATION ENTRY
 * ============================================================================
 *
 * Declaration-level interoperability constructs are composed here.
 *
 * The ABI declaration and FFI declaration families remain owned by their
 * respective grammars.
 *
 * Serialization contracts are exposed through their façade.
 *
 * ============================================================================
 */

interoperabilityDeclaration
    : abiDeclaration
    | ffiInterfaceDeclaration
    | ffiBindingDeclaration
    | ffiCallbackDeclaration
    | ffiAdapterDeclaration
    | ffiPolicyDeclaration
    | serializationInteroperabilityContract
    ;


/*
 * ============================================================================
 * CANONICAL STATEMENT ENTRY
 * ============================================================================
 *
 * Statement-level interoperability constructs are intentionally limited to
 * existing owned rules.
 *
 * No new foreign-call syntax is invented here.
 * ============================================================================
 */

interoperabilityStatement
    : ffiCallStatement
    | ffiCallbackCallStatement
    | serializationInteroperabilityStatement
    ;


/*
 * ============================================================================
 * CANONICAL EXPRESSION ENTRY
 * ============================================================================
 *
 * Expression-level interoperability constructs are delegated to the FFI and
 * serialization owners.
 * ============================================================================
 */

interoperabilityExpression
    : ffiCallExpression
    | ffiCallbackCallExpression
    | ffiQualifiedCallExpression
    | ffiQualifiedCallbackCallExpression
    | serializationInteroperabilityExpression
    ;


/*
 * ============================================================================
 * FFI COMPOSITION ENTRY
 * ============================================================================
 *
 * Useful to tooling that needs to parse one complete FFI item without making
 * Ffi itself the source-unit root.
 * ============================================================================
 */

interoperabilityFfiItem
    : ffiItem
    ;


/*
 * ============================================================================
 * ABI COMPOSITION ENTRIES
 * ============================================================================
 *
 * These aliases expose ABI constructs without redefining them.
 * ============================================================================
 */

interoperabilityAbiDeclaration
    : abiDeclaration
    ;


interoperabilityAbiContract
    : abiContract
    ;


/*
 * ============================================================================
 * FOREIGN-FUNCTION COMPOSITION ENTRY
 * ============================================================================
 *
 * This rule deliberately does not place the foreign-function declaration in
 * the unrestricted top-level declaration alternatives above because its
 * EXTERN-prefixed form overlaps with abiDeclaration.
 *
 * The specialized grammar remains available to the ABI/FFI integration layer.
 *
 * ============================================================================
 */

interoperabilityForeignFunctionDeclaration
    : interoperabilityForeignFunctionDeclaration
    ;


/*
 * ============================================================================
 * SERIALIZATION COMPOSITION ENTRIES
 * ============================================================================
 *
 * These aliases expose the existing interoperability serialization façade.
 * ============================================================================
 */

interoperabilitySerializationUnit
    : serializationInteroperabilityUnit
    ;


interoperabilitySerializationConstruct
    : serializationInteroperabilityConstruct
    ;


interoperabilitySerializationStatement
    : serializationInteroperabilityStatement
    ;


interoperabilitySerializationExpression
    : serializationInteroperabilityExpression
    ;


interoperabilitySerializationContract
    : serializationInteroperabilityContract
    ;


interoperabilitySerializationSerialize
    : serializationInteroperabilitySerialize
    ;


interoperabilitySerializationDeserialize
    : serializationInteroperabilityDeserialize
    ;


interoperabilitySerializationSerializeExpression
    : serializationInteroperabilitySerializeExpression
    ;


interoperabilitySerializationDeserializeExpression
    : serializationInteroperabilityDeserializeExpression
    ;


/*
 * ============================================================================
 * FOREIGN-LANGUAGE SYMBOLIC BOUNDARY
 * ============================================================================
 *
 * This rule is intentionally symbolic.
 *
 * It does NOT parse C, C++, Python, Rust, OpenQASM, Verilog, assembly, or any
 * other foreign language.
 *
 * It provides a generic interoperability identity for tooling and semantic
 * metadata when a foreign language/format is represented symbolically.
 *
 * Examples:
 *
 *     C
 *     C++
 *     Rust
 *     Python
 *     OpenQASM
 *     vendor::language
 *     organization::format
 *
 * The semantic layer determines whether the referenced language/format is
 * supported.
 * ============================================================================
 */

interoperabilityForeignIdentity
    : qualifiedName
    | STRING
    ;


/*
 * ============================================================================
 * OPEN-WORLD LANGUAGE REFERENCE
 * ============================================================================
 *
 * Future languages MUST NOT require modification of this composition grammar
 * merely to become identifiable.
 * ============================================================================
 */

interoperabilityLanguageReference
    : LANGUAGE interoperabilityForeignIdentity
    ;


/*
 * ============================================================================
 * OPEN-WORLD ABI REFERENCE
 * ============================================================================
 *
 * ABI implementation remains owned by Abi.
 * ============================================================================
 */

interoperabilityAbiReference
    : abiContract
    | qualifiedName
    | STRING
    ;


/*
 * ============================================================================
 * CAPABILITY REFERENCE
 * ============================================================================
 *
 * This is a symbolic reference only.
 *
 * It does not grant the capability.
 * ============================================================================
 */

interoperabilityCapabilityReference
    : qualifiedName
    | STRING
    ;


/*
 * ============================================================================
 * RESOURCE REFERENCE
 * ============================================================================
 *
 * This is a symbolic resource reference only.
 *
 * It does not allocate or reserve the resource.
 * ============================================================================
 */

interoperabilityResourceReference
    : qualifiedName
    | STRING
    ;


/*
 * ============================================================================
 * COMPATIBILITY METADATA
 * ============================================================================
 *
 * Generic metadata remains represented using canonical attributes.
 *
 * No closed-world vocabulary is introduced here.
 * ============================================================================
 */

interoperabilityMetadata
    : attribute
    ;


